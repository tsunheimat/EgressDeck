# Copy to .env and keep mode 0600. Do not commit real values.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Generate with: openssl rand -base64 32 (exactly 32 random bytes before base64)
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_ID=primary
AUTH_MODE=session
COOKIE_SECURE=true
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# Optional JSON object, e.g. {"network-admins":"admin","network-operators":"operator"}
OIDC_GROUP_ROLES=
OIDC_GROUPS_CLAIM=groups
OIDC_SCOPES=
OIDC_SUCCESS_PATH=/
# Only AUTH_MODE=header uses the separate signed proxy identity secret.
IDENTITY_HEADER_SECRET=
CONTROLLER_BIND=127.0.0.1
CONTROLLER_PORT=8080

# Optional operator file mounts: add compose.operator.yaml and use in-container
# paths below. The host directory must exist and its private files must be
# owned/readable by container UID 10001 with mode 0600 (directory 0700).
CONTROLLER_OPERATOR_DIR=/etc/egressdeck/controller
# PROVIDER_FETCH_CONFIG_FILE=/run/egressdeck/operator/provider-fetch.json
# OPNSENSE_CONFIG_FILE=/run/egressdeck/operator/opnsense.json
# CONTROLLER_GATEWAYS_FILE=/run/egressdeck/operator/gateways.json

# Required for controller-to-agent calls. The compose command passes this to
# the agent as a bearer-token requirement; keep it out of source control.
GATEWAY_AGENT_TOKEN=

# Optional compose.agent-stock.yaml mounts a compatible installed executable.
# DAE_EXECUTABLE_HOST=/usr/local/bin/dae
# GATEWAY_AGENT_DAE_SHA256=

# Optional compose.native.yaml: explicit native mode, default profile is stock.
# Gateway agent and patched daemon MUST use the same effective UID.
# GATEWAY_AGENT_UID=10002
# DAE_HOT_RUNTIME_DIR=/run/dae-hot
# GATEWAY_AGENT_NATIVE_ENCRYPTION_KEY=base64-of-exactly-32-random-bytes
# GATEWAY_AGENT_NATIVE_ENCRYPTION_KEY_ID=native-primary

# Optional compose.postgres.yaml overlay. Use a URI-safe separate value, e.g.
# openssl rand -hex 32 (the overlay interpolates it into a PostgreSQL URI).
# POSTGRES_PASSWORD=replace-with-a-separate-random-database-password
# POSTGRES_USER=homelab_proxy
# POSTGRES_DB=homelab_proxy
