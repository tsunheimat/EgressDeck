# Root-owned, mode 0640 (group homelab-proxy). Never commit real values.
LISTEN_ADDR=127.0.0.1:8080
AUTH_MODE=session
COOKIE_SECURE=true
STATIC_DIR=/usr/share/egressdeck/web
STORAGE_PATH=/var/lib/homelab-proxy-controller/store.json
# Optional PostgreSQL backend. Retain the state directory for the operation journal.
# STORAGE_DRIVER=pgx
# STORAGE_DSN=postgres://controller:replace-me@database.example.invalid/controller?sslmode=verify-full
# OPERATION_JOURNAL_PATH=/var/lib/homelab-proxy-controller/operations.json
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Generate with: openssl rand -base64 32 (exactly 32 random bytes before base64)
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_ID=primary
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_GROUP_ROLES=
# OIDC_GROUPS_CLAIM=groups
# OIDC_SCOPES="openid profile email groups"
# OIDC_SUCCESS_PATH=/
IDENTITY_HEADER_SECRET=
# Optional operator-owned JSON files. Install as homelab-proxy:homelab-proxy
# mode 0600, using regular files and paths without symlinks. Restart to reload.
# PROVIDER_FETCH_CONFIG_FILE=/etc/homelab-proxy-controller/provider-fetch.json
# OPNSENSE_CONFIG_FILE=/etc/homelab-proxy-controller/opnsense.json
# CONTROLLER_GATEWAYS_FILE=/etc/homelab-proxy-controller/gateways.json
