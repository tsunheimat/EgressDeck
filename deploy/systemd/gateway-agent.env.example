# Root-owned, mode 0640 (group homelab-proxy-agent). Never commit real values.
GATEWAY_AGENT_LISTEN=127.0.0.1:9090
GATEWAY_AGENT_JOURNAL=/var/lib/homelab-proxy-gateway-agent/journal.ndjson
# Generate with: openssl rand -base64 48
GATEWAY_AGENT_TOKEN=
# Required when GATEWAY_AGENT_LISTEN is not a literal loopback address.
GATEWAY_AGENT_TLS_CERT=/etc/homelab-proxy-gateway-agent/agent-server.crt
GATEWAY_AGENT_TLS_KEY=/etc/homelab-proxy-gateway-agent/agent-server.key
GATEWAY_AGENT_CLIENT_CA=/etc/homelab-proxy-gateway-agent/controller-ca.crt
# Pin the installed executable before target qualification.
GATEWAY_AGENT_DAE_EXECUTABLE=/usr/local/bin/dae
GATEWAY_AGENT_DAE_SHA256=
GATEWAY_AGENT_DAE_PIDFILE=/var/run/dae.pid
# Optional native backend. Install the native systemd drop-in to select
# -engine=native; setting these variables alone leaves stock mode selected.
# GATEWAY_AGENT_NATIVE_SOCKET=/run/egressdeck/dae.sock
# Generate a separate key with: openssl rand -base64 32
# GATEWAY_AGENT_NATIVE_ENCRYPTION_KEY=
# GATEWAY_AGENT_NATIVE_ENCRYPTION_KEY_ID=native-primary
# The patched daemon separately requires DAE_HOT_STATE_KEY (64 hex characters).
# Configure that distinct key in the daemon service, not this agent environment.
