+
+// Exercise the native TCP DNS forwarder, including framing and connection pool
+// teardown. Only the final transport is a pipe to a deterministic DNS server.
+type hotDNSTestConn struct {
+	net.Conn
+	closed atomic.Bool
+}
+
+func (c *hotDNSTestConn) Close() error {
+	c.closed.Store(true)
+	return c.Conn.Close()
+}
+
+type hotDNSTestTransport struct {
+	answer      net.IP
+	entered     chan struct{}
+	proceed     <-chan struct{}
+	dialErr     error
+	mu          sync.Mutex
+	conns       []*hotDNSTestConn
+	closed      atomic.Int32
+	openAtClose atomic.Int32
+	dials       atomic.Int32
+}
+
+func (d *hotDNSTestTransport) DialContext(ctx context.Context, _, _ string) (netproxy.Conn, error) {
+	d.dials.Add(1)
+	if d.dialErr != nil {
+		return nil, d.dialErr
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.closed.Load() != 0 {
+		return nil, net.ErrClosed
+	}
+	client, server := net.Pipe()
+	conn := &hotDNSTestConn{Conn: client}
+	d.conns = append(d.conns, conn)
+	go func() {
+		defer server.Close()
+		for {
+			var size [2]byte
+			if _, err := io.ReadFull(server, size[:]); err != nil {
+				return
+			}
+			wire := make([]byte, binary.BigEndian.Uint16(size[:]))
+			if _, err := io.ReadFull(server, wire); err != nil {
+				return
+			}
+			var query dnsmessage.Msg
+			if err := query.Unpack(wire); err != nil || len(query.Question) == 0 {
+				return
+			}
+			if d.entered != nil {
+				select {
+				case d.entered <- struct{}{}:
+				default:
+				}
+			}
+			if d.proceed != nil {
+				select {
+				case <-d.proceed:
+				case <-ctx.Done():
+					return
+				}
+			}
+			response := new(dnsmessage.Msg)
+			response.SetReply(&query)
+			response.Answer = []dnsmessage.RR{&dnsmessage.A{
+				Hdr: dnsmessage.RR_Header{Name: query.Question[0].Name, Rrtype: dnsmessage.TypeA, Class: dnsmessage.ClassINET, Ttl: 60},
+				A:   d.answer,
+			}}
+			wire, err := response.Pack()
+			if err != nil {
+				return
+			}
+			binary.BigEndian.PutUint16(size[:], uint16(len(wire)))
+			if _, err := server.Write(append(size[:], wire...)); err != nil {
+				return
+			}
+		}
+	}()
+	return conn, nil
+}
+
+func (d *hotDNSTestTransport) Close() error {
+	d.closed.Add(1)
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	for _, conn := range d.conns {
+		if !conn.closed.Load() {
+			d.openAtClose.Add(1)
+		}
+		_ = conn.Close()
+	}
+	return nil
+}
+
+var hotDNSTestNamespace atomic.Uint64
+
+func hotDNSTestEntry(t *testing.T, identity, answer string) (outbound.HotInventoryEntry, *hotDNSTestTransport) {
+	t.Helper()
+	transport := &hotDNSTestTransport{answer: net.ParseIP(answer)}
+	log := logrus.New()
+	log.SetOutput(io.Discard)
+	option := &dialer.GlobalOption{Log: log, CheckInterval: time.Hour,
+		TransportCacheNamespace: fmt.Sprintf("hot-dns-test-%d", hotDNSTestNamespace.Add(1))}
+	property := &dialer.Property{}
+	property.Name = "same-dialer"
+	d := dialer.NewDialerContext(context.Background(), transport, option,
+		dialer.InstanceOption{DisableCheck: true}, property)
+	group := outbound.NewDialerGroup(option, "same-group", []*dialer.Dialer{d}, []*dialer.Annotation{{}},
+		outbound.DialerSelectionPolicy{Policy: consts.DialerSelectionPolicy_Fixed}, nil)
+	t.Cleanup(func() { _ = group.Close(); _ = d.Close() })
+	return outbound.HotInventoryEntry{Handle: 2, Identity: identity, Group: group,
+		Candidates: []outbound.HotInventoryCandidate{{ID: "node", Dialer: d}}, Selection: "node"}, transport
+}
