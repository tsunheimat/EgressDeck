+	_ = old.Release()
+	if oldTransport.closed.Load() != 0 || secondTransport.closed.Load() != 0 {
+		t.Fatal("other old selection lease did not pin old group")
+	}
+	_ = selected.Release()
+	if oldTransport.closed.Load() != 1 || secondTransport.closed.Load() != 1 {
+		t.Fatal("selection changed lifecycle ownership and leaked old group")
+	}
