@@ -0,0 +1,48 @@
+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Copyright (c) 2026, daeuniverse Organization <dae@v2raya.org>
+ */
+
+package dialer
+
+// CloneForHot makes a generation-private option for a dialer built by the hot
+// provider path. GlobalOption contains lazy check state and a transport-cache
+// namespace; copying it as a Go struct would alias both. This method copies
+// configuration only, resets lazy state, and always allocates a fresh
+// namespace. Runtime dependencies are retained as references because they are
+// generation services, while every mutable option cache remains private.
+func (o *GlobalOption) CloneForHot() *GlobalOption {
+	if o == nil {
+		return nil
+	}
+	c := &GlobalOption{
+		ExtraOption:             o.ExtraOption,
+		Log:                     o.Log,
+		DaeDNS:                  o.DaeDNS,
+		DirectDialer:            o.DirectDialer,
+		FullconeDirectDialer:    o.FullconeDirectDialer,
+		SystemDNSResolver:       o.SystemDNSResolver,
+		CheckInterval:           o.CheckInterval,
+		CheckTolerance:          o.CheckTolerance,
+		CheckDnsTcp:             o.CheckDnsTcp,
+		SoMarkFromDae:           o.SoMarkFromDae,
+		Mptcp:                   o.Mptcp,
+		TransportCacheNamespace: newTransportCacheNamespace(),
+	}
+	c.TcpCheckOptionRaw = TcpCheckOptionRaw{
+		Log:               o.TcpCheckOptionRaw.Log,
+		Raw:               append([]string(nil), o.TcpCheckOptionRaw.Raw...),
+		ResolverNetwork:   o.TcpCheckOptionRaw.ResolverNetwork,
+		Method:            o.TcpCheckOptionRaw.Method,
+		DirectDialer:      o.TcpCheckOptionRaw.DirectDialer,
+		SystemDNSResolver: o.TcpCheckOptionRaw.SystemDNSResolver,
+	}
+	c.CheckDnsOptionRaw = CheckDnsOptionRaw{
+		Raw:               append([]string(nil), o.CheckDnsOptionRaw.Raw...),
+		ResolverNetwork:   o.CheckDnsOptionRaw.ResolverNetwork,
+		Somark:            o.CheckDnsOptionRaw.Somark,
+		DirectDialer:      o.CheckDnsOptionRaw.DirectDialer,
+		SystemDNSResolver: o.CheckDnsOptionRaw.SystemDNSResolver,
+	}
+	return c
+}
