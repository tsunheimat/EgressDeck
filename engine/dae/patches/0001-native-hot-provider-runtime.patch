+	selected := hotInventoryTestAcquire(t, h, 2)
+	if selected.Dialer != d2 || selected.CandidateID != "chosen" || selected.Group != a.Group || old.Dialer == d2 {
+		t.Fatal("selection did not change new flows while preserving old leases")
+	}
+	if _, err := h.SetSelection(context.Background(), 2, 2, "chosen", commit); err != nil || commits != 1 || h.Snapshot().Generation != 2 {
+		t.Fatal("selection no-op called persistence or advanced generation", err)
+	}
+	probe, err := h.AcquireCandidate(2, "node-0")
+	if err != nil || probe.Dialer != a.Group.Dialers[0] {
+		t.Fatal("stable candidate probe failed", err)
