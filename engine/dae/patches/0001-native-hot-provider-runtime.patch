+		t.Fatal("accepted borrowed publication", err)
+	}
+	// A distinct owned group must not assume ownership of a baseline dialer.
+	alias := hotInventoryTestPrepared(2, "owned", hotInventoryTestGroup("a", a.Group.Dialers[0]))
+	if _, err := h.Publish(context.Background(), 41, []HotInventoryEntry{alias}, hotInventoryTestCommit); !errors.Is(err, ErrHotInventoryInvalid) {
+		t.Fatal("accepted borrowed native resource alias", err)
+	}
+	_ = alias.Group.Close()
+	owned, ownedTransport := hotInventoryTestEntry(t, 2, "a", "owned")
+	if _, err := h.Publish(context.Background(), 40, []HotInventoryEntry{owned}, hotInventoryTestCommit); !errors.Is(err, ErrHotInventoryConflict) {
+		t.Fatal(err)
+	}
+	if _, err := h.Publish(context.Background(), 41, []HotInventoryEntry{owned}, hotInventoryTestCommit); err != nil {
+		t.Fatal(err)
+	}
+	lease, managed, err := h.AcquireManaged(2)
+	if err != nil || !managed || lease.Group != owned.Group || !h.IsHot(2) {
+		t.Fatal("owned override was not acquired", err)
+	}
+	if transportA.closed.Load() != 0 || transportB.closed.Load() != 0 {
+		t.Fatal("publication closed borrowed resources")
+	}
+	_ = h.Close()
+	if transportA.closed.Load() != 0 || transportB.closed.Load() != 0 || ownedTransport.closed.Load() != 0 {
+		t.Fatal("close did not respect ownership and leases")
+	}
+	_ = lease.Release()
+	if ownedTransport.closed.Load() != 1 || transportA.closed.Load() != 0 || transportB.closed.Load() != 0 {
+		t.Fatal("release closed borrowed resources or leaked owned one")
+	}
+}
+
+func TestHotInventoryNamespaceCleanupFollowsLastLeaseAndHoldsRetirementBound(t *testing.T) {
+	a, transport := hotInventoryTestEntry(t, 2, "a", "v1")
+	b, _ := hotInventoryTestEntry(t, 2, "a", "v2")
+	c, _ := hotInventoryTestEntry(t, 2, "a", "v3")
+	h := hotInventoryTestNew(t, 1, a)
+	oldNamespace := a.Group.Dialers[0].TransportCacheNamespace
+	entered, proceed := make(chan struct{}), make(chan struct{})
+	var calls atomic.Int32
+	var closedBeforeNamespace atomic.Bool
+	h.cleanupNamespace = func(namespace string) {
+		if namespace == oldNamespace {
+			calls.Add(1)
+			closedBeforeNamespace.Store(transport.closed.Load() == 1)
+			close(entered)
+			<-proceed
+		}
+		dialer.CleanupTransportCacheNamespace(namespace)
+	}
+	lease := hotInventoryTestAcquire(t, h, 2)
+	if _, err := h.Publish(context.Background(), 1, []HotInventoryEntry{b}, hotInventoryTestCommit); err != nil {
+		t.Fatal(err)
+	}
+	if calls.Load() != 0 {
+		t.Fatal("namespace cleanup ran while old lease still held")
+	}
+	done := make(chan error, 1)
+	go func() { done <- lease.Release() }()
+	<-entered
+	_, busyErr := h.Publish(context.Background(), 2, []HotInventoryEntry{c}, hotInventoryTestCommit)
+	close(proceed)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if !errors.Is(busyErr, ErrHotInventoryBusy) {
+		t.Fatal("namespace cleanup escaped retirement bound", busyErr)
+	}
+	if calls.Load() != 1 || !closedBeforeNamespace.Load() {
+		t.Fatal("namespace cleanup did not follow the sole native close")
+	}
+	if _, err := h.Publish(context.Background(), 2, []HotInventoryEntry{c}, hotInventoryTestCommit); err != nil {
+		t.Fatal(err)
+	}
+}
