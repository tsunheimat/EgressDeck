+type hotControlFixture struct {
+	err          error
+	publications atomic.Int32
+	selections   atomic.Int32
+	reads        atomic.Int32
+	provider     control.HotProviderRequest
+	expected     uint64
+	handle       uint8
+	candidate    string
+}
+
+func TestHotControlCloseWaitsForAdmittedHandlers(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	a := &hotControlAdmission{handler: http.HandlerFunc(func(http.ResponseWriter, *http.Request) {
+		close(entered)
+		<-release
+	})}
+	go a.ServeHTTP(httptest.NewRecorder(), hotFixtureRequest(http.MethodGet, "/v1/inventory", ""))
+	<-entered
+	s := &hotControlServer{admission: a}
+	closed := make(chan struct{})
+	go func() { _ = s.Close(); close(closed) }()
+	deadline := time.After(time.Second)
+	for {
+		a.mu.Lock()
+		closing := a.closed
+		a.mu.Unlock()
+		if closing {
+			break
+		}
+		select {
+		case <-deadline:
+			t.Fatal("close did not fence admission")
+		default:
+			time.Sleep(time.Millisecond)
+		}
+	}
+	w := httptest.NewRecorder()
+	a.ServeHTTP(w, hotFixtureRequest(http.MethodGet, "/v1/inventory", ""))
+	if w.Code != http.StatusServiceUnavailable {
+		t.Fatalf("admitted work after close: %d", w.Code)
+	}
+	select {
+	case <-closed:
+		t.Fatal("closed while handler still using control plane")
+	default:
+	}
+	close(release)
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("did not close after handler finished")
+	}
+}
+
+func (*hotControlFixture) EnableHotInventory(string) error { return nil }
+func (f *hotControlFixture) PublishHotProvider(_ context.Context, req control.HotProviderRequest) (outbound.HotInventoryPublication, error) {
+	f.publications.Add(1)
+	f.provider = req
+	return outbound.HotInventoryPublication{Snapshot: hotFixtureSnapshot(), Adopted: []uint8{2}, CleanupError: errors.New("secret cleanup details")}, f.err
+}
+func (f *hotControlFixture) SetHotSelection(_ context.Context, expected uint64, handle uint8, candidate string) (outbound.HotInventoryPublication, error) {
+	f.selections.Add(1)
+	f.expected, f.handle, f.candidate = expected, handle, candidate
+	return outbound.HotInventoryPublication{Snapshot: hotFixtureSnapshot()}, f.err
+}
+func (f *hotControlFixture) PublishHotProviderOperation(ctx context.Context, _ string, req control.HotProviderRequest) (outbound.HotInventoryPublication, error) {
+	return f.PublishHotProvider(ctx, req)
+}
+func (f *hotControlFixture) SetHotSelectionOperation(ctx context.Context, _ string, expected uint64, handle uint8, candidate string) (outbound.HotInventoryPublication, error) {
+	return f.SetHotSelection(ctx, expected, handle, candidate)
+}
+func (f *hotControlFixture) PublishHotGroupOperation(context.Context, string, control.HotGroupRequest) (outbound.HotInventoryPublication, error) {
+	return outbound.HotInventoryPublication{Snapshot: hotFixtureSnapshot()}, f.err
+}
+func (f *hotControlFixture) HotOperationStatus(id string) (control.HotOperationReceipt, error) {
+	return control.HotOperationReceipt{OperationID: id, State: "committed", Generation: 12}, f.err
+}
+func (f *hotControlFixture) HotInventorySnapshot() (outbound.HotInventorySnapshot, error) {
+	f.reads.Add(1)
+	return hotFixtureSnapshot(), f.err
+}
+func hotFixtureSnapshot() outbound.HotInventorySnapshot {
+	return outbound.HotInventorySnapshot{Generation: 12, Groups: []outbound.HotInventoryGroup{{Handle: 2, Name: "main", Identity: "sha256:opaque", Selection: "candidate-a"}}}
+}
+func hotFixtureRequest(method, path, body string) *http.Request {
+	r := httptest.NewRequest(method, path, strings.NewReader(body))
+	return r.WithContext(context.WithValue(r.Context(), hotPeerUIDKey{}, uint32(os.Geteuid())))
+}
