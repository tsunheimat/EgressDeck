+func TestHotControlFlagsAndReloadFence(t *testing.T) {
+	for _, tc := range []struct {
+		state, socket string
+		valid         bool
+	}{
+		{"", "", true}, {"/tmp/state", "/tmp/run/control.sock", true},
+		{"/tmp/state", "", false}, {"", "/tmp/control.sock", false},
+		{"state", "/tmp/control.sock", false}, {"/tmp/state", "control.sock", false},
+	} {
+		if err := validateHotControlFlags(tc.state, tc.socket); (err == nil) != tc.valid {
+			t.Errorf("flags %q %q: %v", tc.state, tc.socket, err)
+		}
+	}
+	old := hotStateDir
+	hotStateDir = "/tmp/hot-state"
+	t.Cleanup(func() { hotStateDir = old })
+	// A nil configuration intentionally proves the fence runs before parsing,
+	// network access, or constructing any replacement control plane.
+	if _, err := newControlPlaneWithMode(context.Background(), nil, nil, nil, nil, nil, false, false, true); err == nil || err.Error() != hotReloadDisabledMessage {
+		t.Fatalf("reload fence: %v", err)
+	}
+}
