+func TestHotOperationVerifiedDurabilityRollbackRecordsTerminalRejection(t *testing.T) {
+	stateDir := filepath.Join(t.TempDir(), "state")
+	cp := hotTestControlPlane(t, stateDir, "first")
+	req := hotTestRequest("p", "one", "first", 1, "socks5://127.0.0.1:1")
+	if _, err := cp.PublishHotProvider(context.Background(), req); err != nil {
+		t.Fatal(err)
+	}
+	runtime := cp.hotInventory.Load()
+	syncCalls := 0
+	runtime.syncDir = func() error {
+		syncCalls++
+		if syncCalls == 2 {
+			return errors.New("injected operation commit directory sync fault")
+		}
+		return runtime.stateDir.Sync()
+	}
+	id := hotTestOperationID(1, 1)
+	req.ExpectedGeneration, req.RevisionID = 2, "two"
+	if _, err := cp.PublishHotProviderOperation(context.Background(), id, req); err == nil || errors.Is(err, ErrHotInventoryStorageOutcomeUnknown) {
+		t.Fatalf("verified rollback did not return a definite failure: %v", err)
+	}
+	if syncCalls < 5 {
+		t.Fatalf("rejection was not persisted after rollback: %d directory syncs", syncCalls)
+	}
+	runtime.syncDir = nil
+	hotTestOperationReceipt(t, cp, id, "rejected", 2)
+	state, exists, err := runtime.readState()
+	if err != nil || !exists || state.Generation != 2 || state.Providers["p"].RevisionID != "one" {
+		t.Fatalf("failed mutation altered durable provider: %#v exists=%v %v", state, exists, err)
+	}
+	if cp.rejectNewConnections.Load() {
+		t.Fatal("verified rollback fenced healthy packet admission")
+	}
+	if err := cp.closeHotInventory(); err != nil {
+		t.Fatal(err)
+	}
+	cp = hotTestControlPlane(t, stateDir, "first")
+	hotTestOperationReceipt(t, cp, id, "rejected", 2)
+	if _, err := cp.PublishHotProviderOperation(context.Background(), id, req); err == nil {
+		t.Fatal("rejected operation was silently retried")
+	}
+	if publication, err := cp.PublishHotProviderOperation(context.Background(), hotTestOperationID(1, 2), req); err != nil || publication.Snapshot.Generation != 3 {
+		t.Fatalf("new operation cannot recover after definite rollback: %#v %v", publication, err)
+	}
+}
