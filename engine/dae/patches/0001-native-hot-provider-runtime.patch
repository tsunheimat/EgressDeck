+func TestHotOperationIdentityAndSequenceFenceDuplicateRequests(t *testing.T) {
+	stateDir := filepath.Join(t.TempDir(), "state")
+	cp := hotTestControlPlane(t, stateDir, "first")
+	id := hotTestOperationID(1, 1)
+	req := hotTestRequest("p", "one", "first", 1, "socks5://127.0.0.1:1")
+	if _, err := cp.PublishHotProviderOperation(context.Background(), id, req); err != nil {
+		t.Fatal(err)
+	}
+	changed := cloneHotRequest(req)
+	changed.Nodes[0].Link = "socks5://127.0.0.1:2"
+	if _, err := cp.PublishHotProviderOperation(context.Background(), id, changed); !errors.Is(err, ErrHotOperationConflict) {
+		t.Fatalf("same operation ID with different provider payload: %v", err)
+	}
+	if _, err := cp.SetHotSelectionOperation(context.Background(), id, 2, 2, "p-b"); !errors.Is(err, ErrHotOperationConflict) {
+		t.Fatalf("same operation ID with different mutation kind: %v", err)
+	}
+	if _, err := cp.SetHotSelectionOperation(context.Background(), hotTestOperationID(1, 3), 2, 2, "p-b"); !errors.Is(err, ErrHotOperationSequence) {
+		t.Fatalf("skipped sequence accepted: %v", err)
+	}
+	if _, err := cp.SetHotSelectionOperation(context.Background(), hotTestOperationID(1, 2), 2, 2, "absent"); !errors.Is(err, outbound.ErrHotInventoryInvalid) {
+		t.Fatalf("invalid selection did not fail: %v", err)
+	}
+	if _, err := cp.HotOperationStatus(id); !errors.Is(err, ErrHotOperationExpired) {
+		t.Fatalf("old sequence still reported replayable: %v", err)
+	}
+	if _, err := cp.PublishHotProviderOperation(context.Background(), id, req); !errors.Is(err, ErrHotOperationExpired) {
+		t.Fatalf("expired provider operation replayed: %v", err)
+	}
+	if err := cp.closeHotInventory(); err != nil {
+		t.Fatal(err)
+	}
+	cp = hotTestControlPlane(t, stateDir, "first")
+	if _, err := cp.PublishHotProviderOperation(context.Background(), id, req); !errors.Is(err, ErrHotOperationExpired) {
+		t.Fatalf("restart lost sequence fencing: %v", err)
+	}
+	if publication, err := cp.SetHotSelectionOperation(context.Background(), hotTestOperationID(1, 3), 2, 2, "p-b"); err != nil || publication.Snapshot.Generation != 3 {
+		t.Fatalf("next sequence did not advance: %#v %v", publication, err)
+	}
+	for _, invalid := range []string{"", "1:1", strings.Repeat("a", 32) + ":0", strings.Repeat("A", 32) + ":1", strings.Repeat("a", 32) + ":01", strings.Repeat("a", 32) + ":-1"} {
+		if _, err := cp.HotOperationStatus(invalid); !errors.Is(err, ErrHotOperationInvalid) {
+			t.Fatalf("invalid operation ID %q accepted: %v", invalid, err)
+		}
+	}
+}
