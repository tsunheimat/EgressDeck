+func TestHotOperationClientBoundNeverEvictsRecoveryAuthority(t *testing.T) {
+	stateDir := filepath.Join(t.TempDir(), "state")
+	cp := hotTestControlPlane(t, stateDir, "first")
+	req := hotTestRequest("p", "one", "first", 1, "socks5://127.0.0.1:1")
+	if _, err := cp.PublishHotProvider(context.Background(), req); err != nil {
+		t.Fatal(err)
+	}
+	for client := 1; client <= 64; client++ {
+		id := hotTestOperationID(client, 1)
+		if _, err := cp.SetHotSelectionOperation(context.Background(), id, 2, 2, "absent"); err == nil {
+			t.Fatalf("client %d invalid selection accepted", client)
+		}
+		hotTestOperationReceipt(t, cp, id, "rejected", 2)
+	}
+	if _, err := cp.HotOperationStatus(hotTestOperationID(65, 1)); !errors.Is(err, ErrHotOperationLimit) {
+		t.Fatalf("unregistered capacity status must reject: %v", err)
+	}
+	if _, err := cp.SetHotSelectionOperation(context.Background(), hotTestOperationID(65, 1), 2, 2, "p-b"); !errors.Is(err, ErrHotOperationLimit) {
+		t.Fatalf("client recovery bound silently expanded/evicted: %v", err)
+	}
+	if err := cp.closeHotInventory(); err != nil {
+		t.Fatal(err)
+	}
+	cp = hotTestControlPlane(t, stateDir, "first")
+	for client := 1; client <= 64; client++ {
+		hotTestOperationReceipt(t, cp, hotTestOperationID(client, 1), "rejected", 2)
+	}
+	if _, err := cp.HotOperationStatus(hotTestOperationID(65, 1)); !errors.Is(err, ErrHotOperationLimit) {
+		t.Fatalf("unregistered capacity status must reject: %v", err)
+	}
+	if _, err := cp.SetHotSelectionOperation(context.Background(), hotTestOperationID(65, 1), 2, 2, "p-b"); !errors.Is(err, ErrHotOperationLimit) {
+		t.Fatalf("restart reset client recovery bound: %v", err)
+	}
+	if publication, err := cp.SetHotSelectionOperation(context.Background(), hotTestOperationID(1, 2), 2, 2, "p-b"); err != nil || publication.Snapshot.Generation != 3 {
+		t.Fatalf("bounded journal blocked an existing client: %#v %v", publication, err)
+	}
+}
