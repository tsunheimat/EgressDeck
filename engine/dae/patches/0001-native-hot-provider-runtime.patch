index 0000000000000000000000000000000000000000..e8d305305a684cbffb047c1fd2663c0100c58c49
--- /dev/null
+++ b/control/hot_connection.go
@@ -0,0 +1,106 @@
+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Copyright (c) 2026, daeuniverse Organization <dae@v2raya.org>
+ */
+
+package control
+
+import (
+	"errors"
+	"net"
+	"net/netip"
+	"sync"
+
+	"github.com/daeuniverse/dae/component/outbound"
+	"github.com/daeuniverse/outbound/netproxy"
+)
+
+// hotOwnedConn keeps the exact inventory decision alive from before DialContext
+// until the returned connection closes. The private marker prevents the session
+// manager from also claiming this dialer through the baseline egress runtime.
+type hotOwnedConn struct {
+	netproxy.Conn
+	lease *outbound.HotInventoryLease
+	once  sync.Once
+	err   error
+}
+
+func (c *hotOwnedConn) ownsHotEgress() {}
+
+func (c *hotOwnedConn) Close() error {
+	c.once.Do(func() {
+		defer func() { c.err = errors.Join(c.err, c.lease.Release()) }()
+		c.err = c.Conn.Close()
+	})
+	return c.err
+}
+
+func (c *hotOwnedConn) CloseWrite() error            { return netproxy.ForwardCloseWrite(c.Conn) }
+func (c *hotOwnedConn) IntrinsicConn() netproxy.Conn { return c.Conn }
+func (c *hotOwnedConn) UnderlyingConn() net.Conn {
+	if conn, ok := c.Conn.(net.Conn); ok {
+		return conn
+	}
+	if provider, ok := c.Conn.(netproxy.UnderlyingConnProvider); ok {
+		return provider.UnderlyingConn()
+	}
+	return nil
+}
+func (c *hotOwnedConn) WriteDeadlineClosesSession() bool {
+	return netproxy.WriteDeadlineClosesSession(c.Conn)
+}
+
+type hotOwnedPacketConn struct {
+	*hotOwnedConn
+	packet netproxy.PacketConn
+}
+
+func (c *hotOwnedPacketConn) ReadFrom(b []byte) (int, netip.AddrPort, error) {
+	return c.packet.ReadFrom(b)
+}
+func (c *hotOwnedPacketConn) WriteTo(b []byte, addr string) (int, error) {
+	return c.packet.WriteTo(b, addr)
+}
+func (c *hotOwnedPacketConn) RegisterPacketReceiver(handler netproxy.PacketReceiveHandler) (func(), bool) {
+	if receiver, ok := c.packet.(netproxy.PacketReceiver); ok {
+		return receiver.RegisterPacketReceiver(handler)
+	}
+	return nil, false
+}
+func (c *hotOwnedPacketConn) TransportDone() <-chan struct{} {
+	if lifecycle, ok := c.packet.(netproxy.TransportLifecycle); ok {
+		return lifecycle.TransportDone()
+	}
+	return nil
+}
+
+// Advertise batch writes only when the real packet connection supports them;
+// endpoint accounting chooses different paths based on this capability.
+type hotOwnedBatchPacketConn struct {
+	*hotOwnedPacketConn
+	batch netproxy.PacketBatchWriter
+}
+
+func (c *hotOwnedBatchPacketConn) WriteBatch(items []netproxy.BatchItem) (int, error) {
+	return c.batch.WriteBatch(items)
+}
+
+func retainHotConnection(conn netproxy.Conn, lease *outbound.HotInventoryLease) netproxy.Conn {
+	if lease == nil {
+		return conn
+	}
+	owned := &hotOwnedConn{Conn: conn, lease: lease}
+	if packet, ok := conn.(netproxy.PacketConn); ok {
+		wrapped := &hotOwnedPacketConn{hotOwnedConn: owned, packet: packet}
+		if batch, ok := packet.(netproxy.PacketBatchWriter); ok {
+			return &hotOwnedBatchPacketConn{hotOwnedPacketConn: wrapped, batch: batch}
+		}
+		return wrapped
+	}
+	return owned
+}
+
+func connectionOwnsHotEgress(conn netproxy.Conn) bool {
+	_, ok := conn.(interface{ ownsHotEgress() })
+	return ok
+}
