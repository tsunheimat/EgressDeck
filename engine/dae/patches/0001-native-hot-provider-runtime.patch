+func TestHotUDPAdmissionRetainsEndpointAcrossPublication(t *testing.T) {
+	started, resume := make(chan struct{}), make(chan struct{})
+	packet := &scriptedPacketConn{reads: make(chan scriptedPacketRead), closeCh: make(chan struct{})}
+	old := &hotConnectionTransport{dial: func(ctx context.Context) (netproxy.Conn, error) {
