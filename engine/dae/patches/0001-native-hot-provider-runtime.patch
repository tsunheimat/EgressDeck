@@ -0,0 +1,270 @@
+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Copyright (c) 2026, daeuniverse Organization <dae@v2raya.org>
+ */
+
+package control
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/daeuniverse/dae/component/outbound"
+)
+
+func TestHotGroupPublishUnchangedProviderPreservesUnrelatedFlowsAndRestarts(t *testing.T) {
+	link := hotTestSOCKS(t)
+	dir := filepath.Join(t.TempDir(), "state")
+	cp := hotTestControlPlane(t, dir, "first", "second")
+	provider := hotTestRequest("p", "one", "first", 1, link)
+	provider.Groups = append(provider.Groups, HotProviderGroup{Name: "second", CandidateIDs: []string{"p-a", "p-b"}, Selection: "p-b"})
+	if _, err := cp.PublishHotProvider(context.Background(), provider); err != nil {
+		t.Fatal(err)
+	}
+	old := hotTestAcquire(t, cp, 2)
+	unrelated := hotTestAcquire(t, cp, 3)
+	conn, err := old.Dialer.DialContext(context.Background(), "tcp", "example.com:443")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	hotTestEcho(t, conn, "before-group-edit")
+	request := HotGroupRequest{ExpectedGeneration: 2, ProviderID: "p", RevisionID: "one", Group: HotProviderGroup{Name: "first", Revision: 2, CandidateIDs: []string{"p-a"}}}
+	publication, err := cp.PublishHotGroup(context.Background(), request)
+	if err != nil || publication.Snapshot.Generation != 3 || !reflect.DeepEqual(publication.Adopted, []uint8{2}) {
+		t.Fatalf("group publication: %#v %v", publication, err)
+	}
+	current := hotTestAcquire(t, cp, 2)
+	again := hotTestAcquire(t, cp, 3)
+	if current.Dialer != old.Dialer {
+		t.Fatal("unchanged candidate dialer was rebuilt")
+	}
+	if current.Identity != "p/one" || current.CandidateID != "p-a" || len(current.Group.Dialers) != 1 {
+		t.Fatalf("unexpected published group: %#v", current)
+	}
+	if again.Group != unrelated.Group || again.Dialer != unrelated.Dialer {
+		t.Fatal("group publication replaced unrelated native resources")
+	}
+	hotTestEcho(t, conn, "after-group-edit")
+	runtime := cp.hotInventory.Load()
+	if !reflect.DeepEqual(provider.Nodes, runtime.providers["p"].Nodes) || !sameHotRevision(provider, runtime.providers["p"]) {
+		t.Fatal("group change altered immutable provider revision")
+	}
+	snapshot, _ := cp.HotInventorySnapshot()
+	if snapshot.Groups[0].GroupRevision != 2 || !reflect.DeepEqual(snapshot.Groups[0].CandidateIDs, []string{"p-a"}) {
+		t.Fatalf("group readback does not identify applied revision: %#v", snapshot.Groups[0])
+	}
+	if _, err = cp.SetHotSelection(context.Background(), 3, 2, "p-a"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = cp.SetHotSelection(context.Background(), 3, 2, "p-b"); !errors.Is(err, outbound.ErrHotInventoryInvalid) {
+		t.Fatalf("removed candidate selectable: %v", err)
+	}
+	_ = conn.Close()
+	_ = old.Release()
+	_ = current.Release()
+	_ = unrelated.Release()
+	_ = again.Release()
+	if err := cp.closeHotInventory(); err != nil {
+		t.Fatal(err)
+	}
+	restored := hotTestControlPlane(t, dir, "first", "second")
+	restoredGroup := hotTestAcquire(t, restored, 2)
+	if restoredGroup.Identity != "p/one" || restoredGroup.CandidateID != "p-a" || len(restoredGroup.Group.Dialers) != 1 {
+		t.Fatalf("restart lost independent group state: %#v", restoredGroup)
+	}
+	snapshot, _ = restored.HotInventorySnapshot()
+	if snapshot.Generation != 3 || snapshot.Groups[0].GroupRevision != 2 {
+		t.Fatalf("restart lost group revision/generation: %#v", snapshot)
+	}
+}
+
+func TestHotGroupPublishRejectsStaleOrInvalidWithoutChangingDurableState(t *testing.T) {
+	link := hotTestSOCKS(t)
+	dir := filepath.Join(t.TempDir(), "state")
+	cp := hotTestControlPlane(t, dir, "first")
+	provider := hotTestRequest("p", "one", "first", 1, link)
+	if _, err := cp.PublishHotProvider(context.Background(), provider); err != nil {
+		t.Fatal(err)
+	}
+	original, _ := os.ReadFile(filepath.Join(dir, hotStateFile))
+	good := HotGroupRequest{ExpectedGeneration: 2, ProviderID: "p", RevisionID: "one", Group: HotProviderGroup{Name: "first", Revision: 1, CandidateIDs: []string{"p-a"}}}
+	cases := []struct {
+		name   string
+		change func(*HotGroupRequest)
+		want   error
+	}{
+		{"stale_generation", func(r *HotGroupRequest) { r.ExpectedGeneration = 1 }, outbound.ErrHotInventoryConflict},
+		{"inactive_provider", func(r *HotGroupRequest) { r.RevisionID = "two" }, outbound.ErrHotInventoryConflict},
+		{"unknown_group", func(r *HotGroupRequest) { r.Group.Name = "missing" }, outbound.ErrHotInventoryInvalid},
+		{"foreign_candidate", func(r *HotGroupRequest) { r.Group.CandidateIDs = []string{"q-a"} }, outbound.ErrHotInventoryInvalid},
+		{"duplicate_candidate", func(r *HotGroupRequest) { r.Group.CandidateIDs = []string{"p-a", "p-a"} }, outbound.ErrHotInventoryInvalid},
+		{"empty", func(r *HotGroupRequest) { r.Group.CandidateIDs = nil }, outbound.ErrHotInventoryInvalid},
+		{"revision_zero", func(r *HotGroupRequest) { r.Group.Revision = 0 }, outbound.ErrHotInventoryInvalid},
+		{"selected_removed", func(r *HotGroupRequest) { r.Group.CandidateIDs = []string{"p-b"} }, outbound.ErrHotInventoryInvalid},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			request := cloneHotGroupRequest(good)
+			tc.change(&request)
+			if _, err := cp.PublishHotGroup(context.Background(), request); !errors.Is(err, tc.want) {
+				t.Fatalf("got %v want %v", err, tc.want)
+			}
+			actual, _ := os.ReadFile(filepath.Join(dir, hotStateFile))
+			if !bytes.Equal(original, actual) {
+				t.Fatal("rejected group write changed durable authority")
+			}
+			snapshot, _ := cp.HotInventorySnapshot()
+			if snapshot.Generation != 2 {
+				t.Fatalf("rejected group write changed generation: %d", snapshot.Generation)
+			}
+		})
+	}
+	good.Group.CandidateIDs = []string{"p-b"}
+	good.Group.Selection = "p-b"
+	if _, err := cp.PublishHotGroup(context.Background(), good); err != nil {
+		t.Fatal(err)
+	}
+	original, _ = os.ReadFile(filepath.Join(dir, hotStateFile))
+	good.ExpectedGeneration = 3
+	result, err := cp.PublishHotGroup(context.Background(), good)
+	if err != nil || result.Snapshot.Generation != 3 || len(result.Adopted) != 0 {
+		t.Fatalf("same group revision not a no-op: %#v %v", result, err)
+	}
+	actual, _ := os.ReadFile(filepath.Join(dir, hotStateFile))
+	if !bytes.Equal(original, actual) {
+		t.Fatal("no-op rewrote group state")
+	}
+	good.Group.CandidateIDs = []string{"p-a"}
+	good.Group.Selection = "p-a"
+	if _, err := cp.PublishHotGroup(context.Background(), good); !errors.Is(err, outbound.ErrHotInventoryConflict) {
+		t.Fatalf("same group revision content mutation accepted: %v", err)
+	}
+}
+
+func TestHotGroupAddExistingProviderCandidateSelectionRestart(t *testing.T) {
+	link := hotTestSOCKS(t)
+	dir := filepath.Join(t.TempDir(), "state")
+	cp := hotTestControlPlane(t, dir, "first", "second")
+	provider := hotTestRequest("p", "one", "first", 1, link)
+	provider.Groups[0].CandidateIDs = []string{"p-a"}
+	provider.Groups = append(provider.Groups, HotProviderGroup{Name: "second", CandidateIDs: []string{"p-b"}, Selection: "p-b"})
+	if _, err := cp.PublishHotProvider(context.Background(), provider); err != nil {
+		t.Fatal(err)
+	}
+	req := HotGroupRequest{ExpectedGeneration: 2, ProviderID: "p", RevisionID: "one", Group: HotProviderGroup{Name: "first", Revision: 1, CandidateIDs: []string{"p-a", "p-b"}}}
+	if _, err := cp.PublishHotGroup(context.Background(), req); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := cp.SetHotSelection(context.Background(), 3, 2, "p-b"); err != nil {
+		t.Fatal(err)
+	}
+	if err := cp.closeHotInventory(); err != nil {
+		t.Fatal(err)
+	}
+	restored := hotTestControlPlane(t, dir, "first", "second")
+	lease := hotTestAcquire(t, restored, 2)
+	if lease.CandidateID != "p-b" || len(lease.Group.Dialers) != 2 {
+		t.Fatalf("new candidate choice lost over restart: %#v", lease)
+	}
+}
+
+func TestHotGroupSuccessiveRevisionsAndProviderRefresh(t *testing.T) {
+	link := hotTestSOCKS(t)
+	dir := filepath.Join(t.TempDir(), "state")
+	cp := hotTestControlPlane(t, dir, "first")
+	provider := hotTestRequest("p", "one", "first", 1, link)
+	if _, err := cp.PublishHotProvider(context.Background(), provider); err != nil {
+		t.Fatal(err)
+	}
+	req := HotGroupRequest{ExpectedGeneration: 2, ProviderID: "p", RevisionID: "one", Group: HotProviderGroup{Name: "first", Revision: 2, CandidateIDs: []string{"p-a"}}}
+	if _, err := cp.PublishHotGroup(context.Background(), req); err != nil {
+		t.Fatal(err)
+	}
+	req.ExpectedGeneration = 3
+	req.Group.Revision = 3
+	req.Group.CandidateIDs = []string{"p-a", "p-b"}
+	if result, err := cp.PublishHotGroup(context.Background(), req); err != nil || result.Snapshot.Generation != 4 {
+		t.Fatalf("second group revision: %#v %v", result, err)
+	}
+	req.ExpectedGeneration = 4
+	req.Group.Revision = 2
+	if _, err := cp.PublishHotGroup(context.Background(), req); !errors.Is(err, outbound.ErrHotInventoryConflict) {
+		t.Fatalf("older group revision accepted: %v", err)
+	}
+	// A later provider revision installs its complete supplied group definition
+	// and must remove overrides tied to the old provider revision.
+	provider.ExpectedGeneration = 4
+	provider.RevisionID = "two"
+	provider.Groups[0].Revision = 4
+	if _, err := cp.PublishHotProvider(context.Background(), provider); err != nil {
+		t.Fatal(err)
+	}
+	if len(cp.hotInventory.Load().groupOverrides) != 0 {
+		t.Fatal("provider refresh retained stale group override")
+	}
+	if err := cp.closeHotInventory(); err != nil {
+		t.Fatal(err)
+	}
+	restored := hotTestControlPlane(t, dir, "first")
+	snapshot, err := restored.HotInventorySnapshot()
+	if err != nil || snapshot.Generation != 5 || snapshot.Groups[0].Identity != "p/two" || snapshot.Groups[0].GroupRevision != 4 {
+		t.Fatalf("provider refresh restore: %#v %v", snapshot, err)
+	}
+}
+
+func TestHotGroupOperationLostAcknowledgementAndRejectedRetryRestart(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "state")
+	cp := hotTestControlPlane(t, dir, "first")
+	provider := hotTestRequest("p", "one", "first", 1, "socks5://127.0.0.1:1")
+	if _, err := cp.PublishHotProvider(context.Background(), provider); err != nil {
+		t.Fatal(err)
+	}
+	req := HotGroupRequest{ExpectedGeneration: 2, ProviderID: "p", RevisionID: "one", Group: HotProviderGroup{Name: "first", Revision: 1, CandidateIDs: []string{"p-a"}}}
+	id := hotTestOperationID(5, 1)
+	if _, err := cp.PublishHotGroupOperation(context.Background(), id, req); err != nil {
+		t.Fatal(err)
+	}
+	receipt := hotTestOperationReceipt(t, cp, id, "committed", 3)
+	if receipt.Kind != "group_publish" {
+		t.Fatalf("wrong receipt kind %s", receipt.Kind)
+	}
+	if err := cp.closeHotInventory(); err != nil {
+		t.Fatal(err)
+	}
+	cp = hotTestControlPlane(t, dir, "first")
+	before, _ := os.ReadFile(filepath.Join(dir, hotStateFile))
+	result, err := cp.PublishHotGroupOperation(context.Background(), id, req)
+	if err != nil || result.Snapshot.Generation != 3 || len(result.Adopted) != 0 {
+		t.Fatalf("group ack recovery: %#v %v", result, err)
+	}
+	after, _ := os.ReadFile(filepath.Join(dir, hotStateFile))
+	if !bytes.Equal(before, after) {
+		t.Fatal("group operation replay rewrote durable state")
+	}
+	invalid := cloneHotGroupRequest(req)
+	invalid.ExpectedGeneration = 3
+	invalid.Group.Revision = 2
+	invalid.Group.CandidateIDs = []string{"p-b"}
+	rejectedID := hotTestOperationID(5, 2)
+	if _, err := cp.PublishHotGroupOperation(context.Background(), rejectedID, invalid); !errors.Is(err, outbound.ErrHotInventoryInvalid) {
+		t.Fatalf("invalid group accepted: %v", err)
+	}
+	hotTestOperationReceipt(t, cp, rejectedID, "rejected", 3)
+	if err := cp.closeHotInventory(); err != nil {
+		t.Fatal(err)
+	}
+	cp = hotTestControlPlane(t, dir, "first")
+	if _, err := cp.PublishHotGroupOperation(context.Background(), rejectedID, invalid); !errors.Is(err, outbound.ErrHotInventoryInvalid) {
+		t.Fatalf("rejected group replay changed result: %v", err)
+	}
+	snapshot, _ := cp.HotInventorySnapshot()
+	if snapshot.Generation != 3 || snapshot.Groups[0].Selection != "p-a" {
+		t.Fatalf("rejected replay mutated native state: %#v", snapshot)
+	}
+}
