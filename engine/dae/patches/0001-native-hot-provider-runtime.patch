+	nextSecond, _ := hotInventoryTestEntry(t, 3, "replacement", "unused")
+	next.Group.Dialers = append(next.Group.Dialers, nextSecond.Group.Dialers[0])
+	next.Candidates = append(next.Candidates, HotInventoryCandidate{ID: "chosen", Dialer: nextSecond.Group.Dialers[0]})
+	if _, err := h.Publish(context.Background(), 2, []HotInventoryEntry{next}, hotInventoryTestCommit); err != nil {
+		t.Fatal(err)
