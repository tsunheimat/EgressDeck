+	"github.com/daeuniverse/dae/component/outbound/dialer"
+	"github.com/daeuniverse/outbound/netproxy"
+	"golang.org/x/sys/unix"
+)
+
+type hotConnectionTransport struct {
+	dial   func(context.Context) (netproxy.Conn, error)
+	closed atomic.Int32
+}
+
+func (d *hotConnectionTransport) DialContext(ctx context.Context, _, _ string) (netproxy.Conn, error) {
+	if d.closed.Load() != 0 {
+		return nil, net.ErrClosed
+	}
+	if d.dial != nil {
+		return d.dial(ctx)
+	}
+	return nil, io.EOF
