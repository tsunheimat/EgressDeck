+func TestHotOperationInterruptedStorageRequiresRestartBeforeSafeReplay(t *testing.T) {
+	for _, failure := range []string{"rollback_sync", "rejection_receipt_sync"} {
+		t.Run(failure, func(t *testing.T) {
+			stateDir := filepath.Join(t.TempDir(), "state")
+			cp := hotTestControlPlane(t, stateDir, "first")
+			req := hotTestRequest("p", "one", "first", 1, "socks5://127.0.0.1:1")
+			if _, err := cp.PublishHotProvider(context.Background(), req); err != nil {
+				t.Fatal(err)
+			}
+			runtime := cp.hotInventory.Load()
+			syncCalls := 0
+			runtime.syncDir = func() error {
+				syncCalls++
+				if syncCalls == 2 || failure == "rollback_sync" && syncCalls == 3 || failure == "rejection_receipt_sync" && syncCalls == 4 {
+					return errors.New("injected interrupted storage transaction")
+				}
+				return runtime.stateDir.Sync()
+			}
+			id := hotTestOperationID(1, 1)
+			req.ExpectedGeneration, req.RevisionID = 2, "two"
+			if _, err := cp.PublishHotProviderOperation(context.Background(), id, req); !errors.Is(err, ErrHotOperationOutcomeUnknown) {
+				t.Fatalf("unacknowledged receipt persistence reported definite outcome: %v", err)
+			}
+			if _, err := cp.HotOperationStatus(id); !errors.Is(err, outbound.ErrHotInventoryClosed) {
+				t.Fatalf("fenced process invented operation authority: %v", err)
+			}
+			if _, err := cp.PublishHotProviderOperation(context.Background(), id, req); !errors.Is(err, outbound.ErrHotInventoryClosed) {
+				t.Fatalf("fenced process replayed a mutation: %v", err)
+			}
+			if err := cp.closeHotInventory(); err != nil {
+				t.Fatal(err)
+			}
+			// The injected fault leaves the old file on disk. Only reopening the
+			// encrypted journal after fencing establishes this as authority.
+			cp = hotTestControlPlane(t, stateDir, "first")
+			hotTestOperationReceipt(t, cp, id, "not_started", 2)
+			if publication, err := cp.PublishHotProviderOperation(context.Background(), id, req); err != nil || publication.Snapshot.Generation != 3 {
+				t.Fatalf("restart could not resolve and replay interrupted mutation: %#v %v", publication, err)
+			}
+			hotTestOperationReceipt(t, cp, id, "committed", 3)
+		})
+	}
+}
