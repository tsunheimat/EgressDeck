+				}
+				_ = conn.Close()
+			} else if !errors.Is(err, dialErr) {
+				t.Fatalf("dial error = %v", err)
+			}
+			if old.closed.Load() != 1 {
+				t.Fatalf("failed dial retained old inventory, closes=%d", old.closed.Load())
+			}
+		})
+	}
