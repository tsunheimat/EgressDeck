+func TestHotInventoryJournalRoundTrip(t *testing.T) {
+	t.Setenv("DAE_HOT_STATE_KEY", strings.Repeat("ab", 32))
+	aead, err := hotStateCipher()
+	if err != nil {
+		t.Fatal(err)
+	}
+	dir := t.TempDir()
+	root, err := openHotStateDir(filepath.Join(dir, "state"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	runtime := &hotProviderRuntime{stateDir: root, aead: aead}
+	state := hotDurableState{
+		Version: 1, Generation: 7,
+		Handles:   map[string]uint8{"egress": 2},
+		Providers: map[string]HotProviderRequest{"provider": {ProviderID: "provider", RevisionID: "revision"}},
+	}
+	if err := runtime.writeState(context.Background(), state); err != nil {
+		_ = root.Close()
+		t.Fatal(err)
+	}
+	read, exists, err := runtime.readState()
+	_ = root.Close()
+	if err != nil || !exists {
+		t.Fatalf("read journal: exists=%v err=%v", exists, err)
+	}
+	if read.Generation != state.Generation || read.Handles["egress"] != 2 || read.Providers["provider"].RevisionID != "revision" {
+		t.Fatalf("journal mismatch: %#v", read)
+	}
+	info, err := os.Stat(filepath.Join(dir, "state", hotStateFile))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0600 {
+		t.Fatalf("journal permissions = %o, want 600", info.Mode().Perm())
+	}
+}
