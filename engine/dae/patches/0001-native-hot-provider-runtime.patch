+		t.Fatal("revision collision rewrote journal")
+	}
+	original.ExpectedGeneration = 3
+	if publication, err := cp.PublishHotProvider(context.Background(), original); err != nil || publication.Snapshot.Generation != 4 {
+		t.Fatalf("identical historical revision rollback failed: %#v %v", publication, err)
+	}
+	selected := hotTestAcquire(t, cp, 2)
+	if selected.Identity != "p/one" {
+		t.Fatalf("historical identity not restored: %q", selected.Identity)
+	}
+}
+
+func TestHotProviderRevisionHistoryLimitRejectsWithoutEviction(t *testing.T) {
+	cp := hotTestControlPlane(t, filepath.Join(t.TempDir(), "state"), "first")
+	req := hotTestRequest("p", "one", "first", 1, "socks5://127.0.0.1:1")
+	if _, err := cp.PublishHotProvider(context.Background(), req); err != nil {
+		t.Fatal(err)
+	}
+	runtime := cp.hotInventory.Load()
+	runtime.mu.Lock()
+	for i := 1; i < hotMaxRevisions; i++ {
+		runtime.revisions["p"][fmt.Sprintf("historical-%d", i)] = hotRevisionDigest(req)
+	}
+	runtime.mu.Unlock()
+	req.ExpectedGeneration = 2
+	req.RevisionID = "beyond-limit"
+	if _, err := cp.PublishHotProvider(context.Background(), req); !errors.Is(err, outbound.ErrHotInventoryBusy) {
+		t.Fatalf("full revision history allowed eviction/overflow: %v", err)
+	}
+	if len(runtime.revisions["p"]) != hotMaxRevisions || runtime.revisions["p"]["one"] == "" {
+		t.Fatal("history bound evicted a protected identity")
+	}
+}
