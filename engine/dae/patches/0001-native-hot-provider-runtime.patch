+func TestHotProviderRequestCloneAndRevisionIdentity(t *testing.T) {
+	request := HotProviderRequest{
+		ExpectedGeneration: 11,
+		ProviderID:         "provider",
+		RevisionID:         "revision",
+		Nodes:              []HotProviderNode{{ID: "node", Link: "socks5://127.0.0.1:1"}},
+		Groups:             []HotProviderGroup{{Name: "egress", CandidateIDs: []string{"node"}, Selection: "node"}},
+	}
+	clone := cloneHotRequest(request)
+	clone.Nodes[0].Link = "redacted://changed"
+	clone.Groups[0].CandidateIDs[0] = "other"
+	if request.Nodes[0].Link == clone.Nodes[0].Link || request.Groups[0].CandidateIDs[0] == clone.Groups[0].CandidateIDs[0] {
+		t.Fatal("hot request clone aliases mutable slices")
+	}
+	if !sameHotRevision(request, cloneHotRequest(request)) {
+		t.Fatal("identical hot revision was not stable")
+	}
+	selectionChange := cloneHotRequest(request)
+	selectionChange.ExpectedGeneration = 42
+	selectionChange.Groups[0].Selection = "other"
+	if !sameHotRevision(request, selectionChange) {
+		t.Fatal("selection/generation changes should not alter provider content identity")
+	}
+	if request.Groups[0].Selection != "node" || selectionChange.Groups[0].Selection != "other" {
+		t.Fatal("revision comparison mutated selection state")
+	}
+}
