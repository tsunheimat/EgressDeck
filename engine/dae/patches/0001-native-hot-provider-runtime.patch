+
+// selectDnsOutbound pins hot groups before inspecting their native dialers.
+// The lease's persisted selection is authoritative; Group.Select would use the
+// original fixed index and could silently undo a later manual selection.
+func (c *ControlPlane) selectDnsOutbound(handle uint8, networkType *dialer.NetworkType) (*dialer.Dialer, *outbound.DialerGroup, time.Duration, *outbound.HotInventoryLease, error) {
+	lease, hot, err := c.acquireHotOutbound(handle)
+	if err != nil {
+		return nil, nil, 0, nil, err
+	}
+	if hot {
+		return lease.Dialer, lease.Group, 0, lease, nil
+	}
+	if int(handle) >= len(c.outbounds) || c.outbounds[handle] == nil {
+		return nil, nil, 0, nil, fmt.Errorf("bad outbound index: %v", handle)
+	}
+	group := c.outbounds[handle]
+	d, latency, err := group.Select(networkType, true)
+	return d, group, latency, nil, err
+}
+
+// forwardHotDNS uses an exchange-owned forwarder. DNS answer caching remains
+// available, but transport pooling across hot exchanges is intentionally
+// disabled: names are not native resource identities and retaining a forwarder
+// after releasing its group lease would permit use-after-retirement. Close the
+// forwarder before releasing the lease, including cancellation and failures.
+func (c *DnsController) forwardHotDNS(ctx context.Context, upstream *dns.Upstream, dialArg *dialArgument, data []byte) (*dnsmessage.Msg, error) {
+	defer dialArg.hotLease.Release()
+	if c.dnsForwardersClosed.Load() {
+		return nil, ErrDnsForwardersClosed
+	}
+	forwarder, err := dnsForwarderFactory(upstream, *dialArg, c.log)
+	if err != nil {
+		return nil, err
+	}
+	defer forwarder.Close()
+	if c.dnsForwardersClosed.Load() {
+		return nil, ErrDnsForwardersClosed
+	}
+	response, err := forwarder.ForwardDNS(ctx, data)
+	if err != nil && !errors.Is(err, ErrDNSTruncated) {
+		c.logDnsForwardFailure(upstream, dialArg, err)
+		c.reportDnsForwardFailure(dialArg, err)
+	}
+	return response, err
+}
