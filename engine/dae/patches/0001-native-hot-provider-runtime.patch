+func TestHotProviderNativePublicationSelectionRestart(t *testing.T) {
+	link := hotTestSOCKS(t)
+	stateDir := filepath.Join(t.TempDir(), "state")
+	cp := hotTestControlPlane(t, stateDir, "first", "second")
+	for _, handle := range []uint8{0, 1, 2, 3} {
+		lease, managed, err := cp.acquireHotOutbound(handle)
+		if err != nil || managed || lease != nil {
+			t.Fatalf("baseline handle %d unexpectedly managed: %v", handle, err)
+		}
+	}
+	first := hotTestRequest("p", "one", "first", 1, link)
+	if publication, err := cp.PublishHotProvider(context.Background(), first); err != nil || publication.Snapshot.Generation != 2 {
+		t.Fatalf("initial publication: %#v %v", publication, err)
+	}
+	old := hotTestAcquire(t, cp, 2)
+	conn, err := old.Dialer.DialContext(context.Background(), "tcp", "example.com:443")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	hotTestEcho(t, conn, "before-provider-refresh")
+	second := hotTestRequest("q", "one", "second", 2, link)
+	if _, err := cp.PublishHotProvider(context.Background(), second); err != nil {
+		t.Fatal(err)
+	}
+	unrelated := hotTestAcquire(t, cp, 3)
+	if publication, err := cp.SetHotSelection(context.Background(), 3, 2, "p-b"); err != nil || publication.Snapshot.Generation != 4 {
+		t.Fatalf("selection: %#v %v", publication, err)
+	}
+	first.ExpectedGeneration = 4
+	first.RevisionID = "two"
+	first.Groups[0].CandidateIDs = []string{"p-b", "p-a"}
+	if publication, err := cp.PublishHotProvider(context.Background(), first); err != nil || publication.Snapshot.Generation != 5 {
+		t.Fatalf("replacement publication: %#v %v", publication, err)
+	}
+	current := hotTestAcquire(t, cp, 2)
+	if current.CandidateID != "p-b" || current.Handle != old.Handle || current.Group == old.Group {
+		t.Fatalf("replacement did not preserve stable selection and handle: %#v", current)
+	}
+	again := hotTestAcquire(t, cp, 3)
+	if again.Group != unrelated.Group || again.Dialer != unrelated.Dialer {
+		t.Fatal("unrelated provider resources replaced")
+	}
+	if current.Dialer.GlobalOption == old.Dialer.GlobalOption || current.Dialer.TransportCacheNamespace == old.Dialer.TransportCacheNamespace {
+		t.Fatal("replacement shared option/cache lifecycle")
+	}
+	hotTestEcho(t, conn, "after-provider-refresh")
+	durableBefore, err := os.ReadFile(filepath.Join(stateDir, hotStateFile))
+	if err != nil {
+		t.Fatal(err)
+	}
+	first.ExpectedGeneration = 5
+	if publication, err := cp.PublishHotProvider(context.Background(), first); err != nil || publication.Snapshot.Generation != 5 || len(publication.Adopted) != 0 {
+		t.Fatalf("no-op publication: %#v %v", publication, err)
+	}
+	durableAfter, _ := os.ReadFile(filepath.Join(stateDir, hotStateFile))
+	if !bytes.Equal(durableBefore, durableAfter) {
+		t.Fatal("no-op rewrote durable state")
+	}
+	first.ExpectedGeneration = 4
+	first.RevisionID = "three"
+	if _, err := cp.PublishHotProvider(context.Background(), first); !errors.Is(err, outbound.ErrHotInventoryConflict) {
+		t.Fatalf("stale CAS: %v", err)
+	}
+	durableAfter, _ = os.ReadFile(filepath.Join(stateDir, hotStateFile))
+	if !bytes.Equal(durableBefore, durableAfter) {
+		t.Fatal("stale publication changed durable state")
+	}
+	_ = conn.Close()
+	_ = old.Release()
+	_ = current.Release()
+	_ = unrelated.Release()
+	_ = again.Release()
+	if err := cp.closeHotInventory(); err != nil {
+		t.Fatal(err)
+	}
+	restored := hotTestControlPlane(t, stateDir, "first", "second")
+	snapshot, err := restored.HotInventorySnapshot()
+	if err != nil || snapshot.Generation != 5 {
+		t.Fatalf("restart generation: %#v %v", snapshot, err)
+	}
+	restoredLease := hotTestAcquire(t, restored, 2)
+	if restoredLease.CandidateID != "p-b" || restoredLease.Handle != 2 {
+		t.Fatalf("restart selection: %q at %d", restoredLease.CandidateID, restoredLease.Handle)
+	}
+	restoredConn, err := restoredLease.Dialer.DialContext(context.Background(), "tcp", "example.com:443")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer restoredConn.Close()
+	hotTestEcho(t, restoredConn, "after-journal-restore")
+}
