+func TestHotTCPAdmissionRetainsDialAndSessionAcrossPublication(t *testing.T) {
+	started, resume := make(chan struct{}), make(chan struct{})
+	left, right := net.Pipe()
+	t.Cleanup(func() { _ = left.Close(); _ = right.Close() })
+	old := &hotConnectionTransport{dial: func(ctx context.Context) (netproxy.Conn, error) {
+		close(started)
+		select {
+		case <-resume:
+			return left, nil
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}}
+	entry := hotConnectionEntry(t, "old", old)
+	cp, h := hotConnectionPlane(t, entry)
+	type result struct {
+		conn netproxy.Conn
+		res  *proxyDialResult
+		err  error
+	}
+	finished := make(chan result, 1)
+	go func() {
+		conn, res, err := cp.routeDial(context.Background(), hotConnectionParam("tcp"))
+		finished <- result{conn, res, err}
+	}()
+	waitForCloseSignal(t, started, "hot TCP dial admission")
+	hotConnectionPublish(t, h, hotConnectionEntry(t, "new", &hotConnectionTransport{}))
+	if old.closed.Load() != 0 {
+		t.Fatal("publication closed dialer while DialContext was pending")
+	}
+	close(resume)
+	got := <-finished
+	if got.err != nil {
+		t.Fatal(got.err)
+	}
+	t.Cleanup(func() { _ = got.conn.Close() })
+	manager := NewSessionManager(context.Background())
+	t.Cleanup(func() { _ = manager.Close() })
+	ingress, peer := net.Pipe()
+	t.Cleanup(func() { _ = ingress.Close(); _ = peer.Close() })
+	flow, err := manager.adoptTCP(ingress, got.conn, newTcpFlowBinding(1, got.res), cp.egressRuntime, nil)
+	if err != nil {
+		t.Fatalf("adopt hot TCP against baseline runtime: %v", err)
+	}
+	if flow.egressLease != nil {
+		t.Fatal("baseline runtime took ownership of hot dialer")
+	}
+	if flow.binding.Egress.Outbound == entry.Group {
+		t.Fatal("session retained full mutable selection group")
+	}
+	writeDone := make(chan error, 1)
+	go func() { _, err := right.Write([]byte("alive")); writeDone <- err }()
+	_ = got.conn.SetReadDeadline(time.Now().Add(time.Second))
+	payload := make([]byte, 5)
+	if _, err := io.ReadFull(got.conn, payload); err != nil || string(payload) != "alive" {
+		t.Fatalf("retained TCP payload %q: %v", payload, err)
+	}
+	if err := <-writeDone; err != nil {
+		t.Fatal(err)
+	}
+	closeEstablishedTCPFlow(got.conn, flow)
+	_ = got.conn.Close()
+	if old.closed.Load() != 1 {
+		t.Fatalf("native transport close count = %d", old.closed.Load())
+	}
+}
