new file mode 100644
index 0000000000000000000000000000000000000000..5c9725ae04db93ba410ae053a62b8a3befe32889
--- /dev/null
+++ b/control/hot_group.go
@@ -0,0 +1,295 @@
+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Copyright (c) 2026, daeuniverse Organization <dae@v2raya.org>
+ */
+
+package control
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"slices"
+
+	"github.com/daeuniverse/dae/common/consts"
+	"github.com/daeuniverse/dae/component/outbound"
+	"github.com/daeuniverse/dae/component/outbound/dialer"
+)
+
+// HotGroupRequest replaces the membership of one existing managed group using
+// only the exact active provider's immutable node definitions. Group.Revision is
+// independent of RevisionID (the provider revision) and of selection generation.
+type HotGroupRequest struct {
+	ExpectedGeneration uint64           `json:"expected_generation"`
+	ProviderID         string           `json:"provider_id"`
+	RevisionID         string           `json:"revision_id"`
+	Group              HotProviderGroup `json:"group"`
+}
+
+func (c *ControlPlane) PublishHotGroup(ctx context.Context, req HotGroupRequest) (outbound.HotInventoryPublication, error) {
+	runtime := c.hotInventory.Load()
+	if runtime == nil {
+		return outbound.HotInventoryPublication{}, errors.New("hot inventory is disabled")
+	}
+	runtime.mu.Lock()
+	defer runtime.mu.Unlock()
+	if runtime.closed {
+		return outbound.HotInventoryPublication{}, outbound.ErrHotInventoryClosed
+	}
+	return c.applyHotGroupLocked(ctx, runtime, req)
+}
+
+func (c *ControlPlane) PublishHotGroupOperation(ctx context.Context, id string, req HotGroupRequest) (outbound.HotInventoryPublication, error) {
+	return c.runHotOperation(ctx, id, "group_publish", req, func(runtime *hotProviderRuntime) (outbound.HotInventoryPublication, error) {
+		return c.applyHotGroupLocked(ctx, runtime, req)
+	})
+}
+
+func (c *ControlPlane) applyHotGroupLocked(ctx context.Context, runtime *hotProviderRuntime, req HotGroupRequest) (outbound.HotInventoryPublication, error) {
+	before := runtime.inventory.Snapshot()
+	if req.ExpectedGeneration != before.Generation {
+		return outbound.HotInventoryPublication{}, outbound.ErrHotInventoryConflict
+	}
+	if err := ctx.Err(); err != nil {
+		return outbound.HotInventoryPublication{}, err
+	}
+	req = cloneHotGroupRequest(req)
+	provider, found := runtime.providers[req.ProviderID]
+	if !found || provider.RevisionID != req.RevisionID {
+		return outbound.HotInventoryPublication{}, fmt.Errorf("%w: provider revision is not active", outbound.ErrHotInventoryConflict)
+	}
+	original, found := findHotProviderGroup(provider, req.Group.Name)
+	if !found {
+		return outbound.HotInventoryPublication{}, fmt.Errorf("%w: group is not owned by provider", outbound.ErrHotInventoryInvalid)
+	}
+	effective := effectiveHotProvider(provider, runtime.groupOverrides)
+	candidateCount := 0
+	for _, group := range effective.Groups {
+		if group.Name == req.Group.Name {
+			candidateCount += len(req.Group.CandidateIDs)
+		} else {
+			candidateCount += len(group.CandidateIDs)
+		}
+	}
+	if candidateCount > hotMaxNodes {
+		return outbound.HotInventoryPublication{}, fmt.Errorf("%w: total native candidate count exceeds limit", outbound.ErrHotInventoryInvalid)
+	}
+	if err := validateHotGroupSpec(provider, req.Group); err != nil {
+		return outbound.HotInventoryPublication{}, err
+	}
+	current := original
+	if override, exists := runtime.groupOverrides[req.Group.Name]; exists {
+		current = override.Group
+	}
+	if req.Group.Revision < current.Revision {
+		return outbound.HotInventoryPublication{}, fmt.Errorf("%w: group revision is older than applied revision", outbound.ErrHotInventoryConflict)
+	}
+	if req.Group.Revision == current.Revision {
+		if !slices.Equal(req.Group.CandidateIDs, current.CandidateIDs) {
+			return outbound.HotInventoryPublication{}, fmt.Errorf("%w: group revision identity was reused", outbound.ErrHotInventoryConflict)
+		}
+		return outbound.HotInventoryPublication{Snapshot: before}, nil
+	}
+	entry, release, err := c.prepareHotGroup(ctx, runtime, provider, req.Group, before)
+	if err != nil {
+		return outbound.HotInventoryPublication{}, err
+	}
+	adopted := false
+	defer func() { release(adopted) }()
+	providers := cloneHotProviders(runtime.providers)
+	overrides := cloneHotGroupOverrides(runtime.groupOverrides)
+	overrides[req.Group.Name] = req
+	publication, err := runtime.inventory.Publish(ctx, req.ExpectedGeneration, []outbound.HotInventoryEntry{entry}, func(ctx context.Context, snapshot outbound.HotInventorySnapshot) error {
+		state := runtime.hotStateForSnapshot(providers, runtime.revisions, overrides, snapshot)
+		return runtime.writeState(ctx, state)
+	})
+	if err != nil {
+		c.fenceHotOutcome(runtime, err)
+		return outbound.HotInventoryPublication{}, err
+	}
+	adopted = true
+	runtime.providers = providers
+	if err := c.publishHotOutboundConnectivity(publication.Adopted); err != nil {
+		c.fenceHotOutcome(runtime, ErrHotInventoryDatapathOutcomeUnknown)
+		return publication, ErrHotInventoryDatapathOutcomeUnknown
+	}
+	return publication, nil
+}
+
+func validateHotGroupSpec(provider HotProviderRequest, group HotProviderGroup) error {
+	invalid := func(message string) error { return fmt.Errorf("%w: %s", outbound.ErrHotInventoryInvalid, message) }
+	if group.Revision == 0 || len(group.CandidateIDs) == 0 || len(group.CandidateIDs) > hotMaxNodes {
+		return invalid("nonempty group membership and positive group revision required")
+	}
+	known := make(map[string]bool, len(provider.Nodes))
+	for _, node := range provider.Nodes {
+		known[node.ID] = true
+	}
+	seen := make(map[string]bool, len(group.CandidateIDs))
+	for _, id := range group.CandidateIDs {
+		if !known[id] || seen[id] {
+			return invalid("unknown or duplicate group candidate")
+		}
+		seen[id] = true
+	}
+	if group.Selection != "" && !seen[group.Selection] {
+		return invalid("selected candidate is absent")
+	}
+	return nil
+}
+
+func findHotProviderGroup(provider HotProviderRequest, name string) (HotProviderGroup, bool) {
+	for _, group := range provider.Groups {
+		if group.Name == name {
+			return group, true
+		}
+	}
+	return HotProviderGroup{}, false
+}
+
+func cloneHotGroupRequest(req HotGroupRequest) HotGroupRequest {
+	req.Group.CandidateIDs = append([]string(nil), req.Group.CandidateIDs...)
+	return req
+}
+
+func cloneHotGroupOverrides(source map[string]HotGroupRequest) map[string]HotGroupRequest {
+	result := make(map[string]HotGroupRequest, len(source))
+	for name, req := range source {
+		result[name] = cloneHotGroupRequest(req)
+	}
+	return result
+}
+
+func effectiveHotProvider(provider HotProviderRequest, overrides map[string]HotGroupRequest) HotProviderRequest {
+	provider = cloneHotRequest(provider)
+	for i := range provider.Groups {
+		if override, ok := overrides[provider.Groups[i].Name]; ok && override.ProviderID == provider.ProviderID && override.RevisionID == provider.RevisionID {
+			provider.Groups[i] = cloneHotGroupRequest(override).Group
+		}
+	}
+	return provider
+}
+
+func validateHotGroupOverrides(state hotDurableState) error {
+	for name, override := range state.GroupOverrides {
+		provider, found := state.Providers[override.ProviderID]
+		original, owned := findHotProviderGroup(provider, name)
+		if !found || !owned || override.RevisionID != provider.RevisionID || override.Group.Name != name || override.Group.Revision <= original.Revision {
+			return errors.New("invalid hot group override ownership or revision")
+		}
+		if err := validateHotGroupSpec(provider, override.Group); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// hotStateForSnapshot keeps provider revision hashes stable even when a group
+// chooses a node that was not in its original membership. The effective group
+// override stores that choice; original provider choices remain valid for their
+// immutable original membership and are ignored for overridden groups on restore.
+func (r *hotProviderRuntime) hotStateForSnapshot(providers map[string]HotProviderRequest, revisions map[string]map[string]string, overrides map[string]HotGroupRequest, snapshot outbound.HotInventorySnapshot) hotDurableState {
+	if overrides == nil {
+		overrides = cloneHotGroupOverrides(r.groupOverrides)
+	}
+	choices := make(map[string]string, len(snapshot.Groups))
+	for _, group := range snapshot.Groups {
+		choices[group.Name] = group.Selection
+	}
+	for id, provider := range providers {
+		for i, group := range provider.Groups {
+			if override, exists := overrides[group.Name]; exists {
+				override.Group.Selection = choices[group.Name]
+				overrides[group.Name] = override
+			} else {
+				provider.Groups[i].Selection = choices[group.Name]
+			}
+		}
+		providers[id] = provider
+	}
+	return hotDurableState{Version: 1, Generation: snapshot.Generation, Handles: r.handles, Providers: providers, Revisions: revisions, GroupOverrides: overrides}
+}
+
+// prepareHotGroup reuses every available unchanged native candidate. Temporary
+// leases prevent concurrent flow release from retiring resources before Publish
+// acquires ownership. A previously removed candidate can be recreated from its
+// immutable provider link without refetching the subscription.
+func (c *ControlPlane) prepareHotGroup(ctx context.Context, runtime *hotProviderRuntime, provider HotProviderRequest, spec HotProviderGroup, snapshot outbound.HotInventorySnapshot) (entry outbound.HotInventoryEntry, release func(bool), retErr error) {
+	entry = outbound.HotInventoryEntry{Handle: runtime.handles[spec.Name], Identity: provider.ProviderID + "/" + provider.RevisionID, GroupRevision: spec.Revision, Selection: spec.Selection}
+	for _, group := range snapshot.Groups {
+		if group.Name == spec.Name && slices.Contains(spec.CandidateIDs, group.Selection) {
+			entry.Selection = group.Selection
+		}
+	}
+	if entry.Selection == "" || !slices.Contains(spec.CandidateIDs, entry.Selection) {
+		return entry, nil, fmt.Errorf("%w: selected candidate disappeared; explicit replacement required", outbound.ErrHotInventoryInvalid)
+	}
+	var leases []*outbound.HotInventoryLease
+	var created []*dialer.Dialer
+	cleanup := func(adopted bool) {
+		if !adopted {
+			if entry.Group != nil {
+				_ = entry.Group.Close()
+			}
+			for _, d := range created {
+				_ = d.Close()
+				dialer.CleanupTransportCacheNamespace(d.TransportCacheNamespace)
+			}
+		}
+		for _, lease := range leases {
+			_ = lease.Release()
+		}
+	}
+	release = cleanup
+	defer func() {
+		if retErr != nil {
+			cleanup(false)
+		}
+	}()
+	var native []*dialer.Dialer
+	var annotations []*dialer.Annotation
+	fixed := 0
+	for i, id := range spec.CandidateIDs {
+		if err := ctx.Err(); err != nil {
+			return entry, nil, err
+		}
+		var candidate *dialer.Dialer
+		// Search target first so a membership edit retains its exact transport.
+		for _, targetFirst := range []bool{true, false} {
+			for _, group := range snapshot.Groups {
+				if (group.Name == spec.Name) != targetFirst || group.Identity != entry.Identity || !slices.Contains(group.CandidateIDs, id) {
+					continue
+				}
+				lease, err := runtime.inventory.AcquireCandidate(group.Handle, id)
+				if err != nil {
+					return entry, nil, err
+				}
+				leases = append(leases, lease)
+				candidate = lease.Dialer
+				break
+			}
+			if candidate != nil {
+				break
+			}
+		}
+		if candidate == nil {
+			singleton := cloneHotRequest(provider)
+			singleton.Groups = []HotProviderGroup{{Name: spec.Name, Revision: spec.Revision, CandidateIDs: []string{id}, Selection: id}}
+			prepared, err := c.prepareHotProvider(ctx, runtime, singleton, nil)
+			if err != nil {
+				return entry, nil, err
+			}
+			candidate = prepared[0].Candidates[0].Dialer
+			_ = prepared[0].Group.Close()
+			created = append(created, candidate)
+		}
+		native = append(native, candidate)
+		annotations = append(annotations, &dialer.Annotation{})
+		entry.Candidates = append(entry.Candidates, outbound.HotInventoryCandidate{ID: id, Dialer: candidate})
+		if id == entry.Selection {
+			fixed = i
+		}
+	}
+	entry.Group = outbound.NewDialerGroup(native[0].GlobalOption, spec.Name, native, annotations, outbound.DialerSelectionPolicy{Policy: consts.DialerSelectionPolicy_Fixed, FixedIndex: fixed}, func(bool, *dialer.NetworkType, bool) {})
+	return entry, release, nil
+}
diff --git a/control/hot_group_test.go b/control/hot_group_test.go
