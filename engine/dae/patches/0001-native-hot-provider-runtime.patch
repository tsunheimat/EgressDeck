+func TestHotControlRejectsUnsafeSocketPaths(t *testing.T) {
+	t.Run("public-directory", func(t *testing.T) {
+		dir := shortHotControlDir(t)
+		if err := os.Chmod(dir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if s, err := startHotControl(&hotControlFixture{}, filepath.Join(dir, "control.sock")); err == nil {
+			_ = s.Close()
+			t.Fatal("accepted public socket directory")
+		}
+		info, _ := os.Stat(dir)
+		if info.Mode().Perm() != 0o755 {
+			t.Fatal("changed existing directory permissions")
+		}
+	})
+	t.Run("symlink-directory", func(t *testing.T) {
+		dir := shortHotControlDir(t)
+		link := filepath.Join(dir, "link")
+		if err := os.Symlink(dir, link); err != nil {
+			t.Fatal(err)
+		}
+		if s, err := startHotControl(&hotControlFixture{}, filepath.Join(link, "control.sock")); err == nil {
+			_ = s.Close()
+			t.Fatal("accepted symlink socket directory")
+		}
+	})
+	t.Run("existing-file", func(t *testing.T) {
+		dir := shortHotControlDir(t)
+		file := filepath.Join(dir, "control.sock")
+		if err := os.WriteFile(file, []byte("preserve me"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if s, err := startHotControl(&hotControlFixture{}, file); err == nil {
+			_ = s.Close()
+			t.Fatal("accepted existing file")
+		}
+		if content, _ := os.ReadFile(file); string(content) != "preserve me" {
+			t.Fatal("changed existing file")
+		}
+	})
+}
