new file mode 100644
index 0000000000000000000000000000000000000000..dc989de6d9f41ec839c920eb4b9f0a21fcea1399
--- /dev/null
+++ b/control/hot_operations.go
@@ -0,0 +1,348 @@
+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Copyright (c) 2026, daeuniverse Organization <dae@v2raya.org>
+ */
+
+package control
+
+// Durable hot operations are intentionally implemented in the control
+// package, next to the encrypted inventory journal. An operation receipt is
+// the authority that lets a client safely retry after a lost HTTP response:
+// the daemon never guesses whether a mutation happened.
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"regexp"
+	"strconv"
+
+	"github.com/daeuniverse/dae/component/outbound"
+)
+
+const hotOperationMaxClients = 64
+
+var hotOperationIDPattern = regexp.MustCompile(`^([0-9a-f]{32}):([1-9][0-9]*)$`)
+
+var (
+	ErrHotOperationInvalid        = errors.New("invalid hot operation")
+	ErrHotOperationConflict       = errors.New("hot operation request conflicts with durable receipt")
+	ErrHotOperationExpired        = errors.New("hot operation receipt has expired")
+	ErrHotOperationSequence       = errors.New("hot operation sequence must be the next sequence")
+	ErrHotOperationLimit          = errors.New("hot operation authority limit reached")
+	ErrHotOperationOutcomeUnknown = errors.New("hot operation outcome is unknown; restart and readback required")
+)
+
+// HotOperationReceipt is the compact, encrypted, per-client durable record.
+// The daemon retains only the latest receipt for each client authority.
+type HotOperationReceipt struct {
+	OperationID   string `json:"operation_id"`
+	RequestDigest string `json:"request_digest"`
+	Kind          string `json:"kind"`
+	State         string `json:"state"` // committed, rejected, not_started
+	Generation    uint64 `json:"generation,omitempty"`
+	ErrorCode     string `json:"error_code,omitempty"`
+}
+
+type hotOperationIdentity struct {
+	ID     string
+	Client string
+	Seq    uint64
+}
+
+type hotOperationPending struct {
+	Receipt HotOperationReceipt
+}
+
+func cloneHotOperationReceipts(in map[string]HotOperationReceipt) map[string]HotOperationReceipt {
+	out := make(map[string]HotOperationReceipt, len(in))
+	for client, receipt := range in {
+		out[client] = receipt
+	}
+	return out
+}
+
+func validateHotOperationReceipts(receipts map[string]HotOperationReceipt, generation uint64) error {
+	if len(receipts) > hotOperationMaxClients {
+		return errors.New("hot inventory operation authority limit exceeded")
+	}
+	for client, receipt := range receipts {
+		id, err := parseHotOperationID(receipt.OperationID)
+		digest, digestErr := hex.DecodeString(receipt.RequestDigest)
+		if err != nil || id.Client != client || digestErr != nil || len(digest) != 32 || receipt.Generation == 0 || receipt.Generation > generation {
+			return errors.New("invalid hot inventory operation receipt")
+		}
+		if receipt.State != "committed" && receipt.State != "rejected" || receipt.Kind != "provider_publish" && receipt.Kind != "selection_set" && receipt.Kind != "group_publish" {
+			return errors.New("invalid hot inventory operation receipt state")
+		}
+		if receipt.State == "committed" && receipt.ErrorCode != "" || receipt.State == "rejected" && receipt.ErrorCode == "" {
+			return errors.New("invalid hot inventory operation error receipt")
+		}
+	}
+	return nil
+}
+
+func parseHotOperationID(id string) (hotOperationIdentity, error) {
+	matches := hotOperationIDPattern.FindStringSubmatch(id)
+	if matches == nil {
+		return hotOperationIdentity{}, fmt.Errorf("%w: operation ID must be 32 lowercase hex client characters and a positive sequence", ErrHotOperationInvalid)
+	}
+	seq, err := strconv.ParseUint(matches[2], 10, 64)
+	if err != nil || seq == 0 {
+		return hotOperationIdentity{}, fmt.Errorf("%w: invalid operation sequence", ErrHotOperationInvalid)
+	}
+	return hotOperationIdentity{ID: id, Client: matches[1], Seq: seq}, nil
+}
+
+func hotOperationDigest(kind string, request any) string {
+	// Normalize request object ordering while retaining integer precision.
+	// Clients can use a different Go DTO field order without changing identity.
+	raw, _ := json.Marshal(request)
+	var normalized any
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	_ = decoder.Decode(&normalized)
+	payload, _ := json.Marshal(struct {
+		Kind    string `json:"kind"`
+		Request any    `json:"request"`
+	}{Kind: kind, Request: normalized})
+	hash := sha256.Sum256(payload)
+	return hex.EncodeToString(hash[:])
+}
+
+func hotOperationErrorCode(err error) string {
+	switch {
+	case errors.Is(err, context.Canceled), errors.Is(err, context.DeadlineExceeded):
+		return "request_canceled"
+	case errors.Is(err, outbound.ErrHotInventoryConflict):
+		return "generation_conflict"
+	case errors.Is(err, outbound.ErrHotInventoryBusy):
+		return "inventory_busy"
+	case errors.Is(err, outbound.ErrHotInventoryInvalid), errors.Is(err, outbound.ErrHotInventoryUnmanaged):
+		return "invalid_request"
+	case errors.Is(err, ErrHotOperationLimit):
+		return "operation_limit"
+	default:
+		return "mutation_rejected"
+	}
+}
+
+func (r *hotProviderRuntime) operationState(id string, digest string) (HotOperationReceipt, hotOperationIdentity, error) {
+	identity, err := parseHotOperationID(id)
+	if err != nil {
+		return HotOperationReceipt{}, identity, err
+	}
+	if r.operations == nil {
+		r.operations = make(map[string]HotOperationReceipt)
+	}
+	if previous, exists := r.operations[identity.Client]; exists {
+		prior, priorErr := parseHotOperationID(previous.OperationID)
+		if priorErr != nil {
+			return HotOperationReceipt{}, identity, fmt.Errorf("%w: corrupt durable operation receipt", ErrHotOperationInvalid)
+		}
+		switch {
+		case identity.Seq < prior.Seq:
+			return HotOperationReceipt{}, identity, fmt.Errorf("%w: %s", ErrHotOperationExpired, previous.OperationID)
+		case identity.Seq == prior.Seq:
+			if previous.RequestDigest != digest {
+				return HotOperationReceipt{}, identity, ErrHotOperationConflict
+			}
+			return previous, identity, nil
+		case identity.Seq != prior.Seq+1:
+			return HotOperationReceipt{}, identity, fmt.Errorf("%w: expected %d", ErrHotOperationSequence, prior.Seq+1)
+		}
+	} else if identity.Seq != 1 {
+		return HotOperationReceipt{}, identity, fmt.Errorf("%w: expected 1", ErrHotOperationSequence)
+	}
+	if len(r.operations) >= hotOperationMaxClients && r.operations[identity.Client].OperationID == "" {
+		return HotOperationReceipt{}, identity, ErrHotOperationLimit
+	}
+	return HotOperationReceipt{}, identity, nil
+}
+
+func (r *hotProviderRuntime) operationStateLocked(id, digest string) (HotOperationReceipt, hotOperationIdentity, error) {
+	return r.operationState(id, digest)
+}
+
+// RunHotOperation serializes an operation with native inventory mutations.
+// The callback executes with runtime.mu held and must use the private locked
+// mutation helpers. A committed receipt is included in the same encrypted
+// state transaction as the inventory snapshot. Rejected validation and
+// precommit failures receive their own durable receipt, so retrying the same
+// ID cannot accidentally run it later.
+func (c *ControlPlane) runHotOperation(ctx context.Context, operationID, kind string, request any, mutate func(*hotProviderRuntime) (outbound.HotInventoryPublication, error)) (outbound.HotInventoryPublication, error) {
+	runtime := c.hotInventory.Load()
+	if runtime == nil {
+		return outbound.HotInventoryPublication{}, errors.New("hot inventory is disabled")
+	}
+	digest := hotOperationDigest(kind, request)
+	runtime.mu.Lock()
+	defer runtime.mu.Unlock()
+	if runtime.closed {
+		return outbound.HotInventoryPublication{}, outbound.ErrHotInventoryClosed
+	}
+	previous, identity, err := runtime.operationStateLocked(operationID, digest)
+	if err != nil {
+		return outbound.HotInventoryPublication{}, err
+	}
+	if previous.OperationID != "" {
+		if previous.State == "rejected" {
+			return outbound.HotInventoryPublication{}, hotRejectedOperationError(previous.ErrorCode)
+		}
+		return outbound.HotInventoryPublication{Snapshot: runtime.inventory.Snapshot()}, nil
+	}
+	if err := ctx.Err(); err != nil {
+		receipt := HotOperationReceipt{OperationID: identity.ID, RequestDigest: digest, Kind: kind, State: "rejected", ErrorCode: hotOperationErrorCode(err)}
+		if persistErr := c.persistHotOperationRejectionLocked(context.Background(), runtime, receipt); persistErr != nil {
+			return outbound.HotInventoryPublication{}, persistErr
+		}
+		return outbound.HotInventoryPublication{}, err
+	}
+	receipt := HotOperationReceipt{OperationID: identity.ID, RequestDigest: digest, Kind: kind, State: "committed"}
+	runtime.pendingOperation = &hotOperationPending{Receipt: receipt}
+	publication, mutateErr := mutate(runtime)
+	runtime.pendingOperation = nil
+	if mutateErr != nil {
+		// If the transaction callback durably wrote our receipt, the mutation
+		// committed even if datapath readback later failed. Return the durable
+		// receipt and the datapath error to the caller.
+		if committed := runtime.operations[identity.Client]; committed.OperationID == operationID && committed.RequestDigest == digest {
+			return publication, mutateErr
+		}
+		if errors.Is(mutateErr, ErrHotInventoryStorageOutcomeUnknown) || errors.Is(mutateErr, ErrHotInventoryDatapathOutcomeUnknown) {
+			return publication, fmt.Errorf("%w: %v", ErrHotOperationOutcomeUnknown, mutateErr)
+		}
+		receipt.State = "rejected"
+		receipt.ErrorCode = hotOperationErrorCode(mutateErr)
+		if persistErr := c.persistHotOperationRejectionLocked(context.Background(), runtime, receipt); persistErr != nil {
+			return publication, persistErr
+		}
+		return publication, mutateErr
+	}
+	// Identity no-ops do not call HotInventory's commit callback. Persist the
+	// successful receipt independently at the current generation.
+	if committed := runtime.operations[identity.Client]; committed.OperationID != operationID || committed.RequestDigest != digest {
+		receipt.Generation = publication.Snapshot.Generation
+		if err := c.persistHotOperationLocked(context.Background(), runtime, receipt); err != nil {
+			return publication, err
+		}
+	} else {
+		receipt = committed
+	}
+	return publication, nil
+}
+
+func (c *ControlPlane) persistHotOperationRejectionLocked(ctx context.Context, runtime *hotProviderRuntime, receipt HotOperationReceipt) error {
+	receipt.State = "rejected"
+	receipt.Generation = runtime.inventory.Snapshot().Generation
+	if receipt.ErrorCode == "" {
+		receipt.ErrorCode = "mutation_rejected"
+	}
+	return c.persistHotOperationLocked(ctx, runtime, receipt)
+}
+
+func (c *ControlPlane) persistHotOperationLocked(ctx context.Context, runtime *hotProviderRuntime, receipt HotOperationReceipt) error {
+	if runtime.operations == nil {
+		runtime.operations = make(map[string]HotOperationReceipt)
+	}
+	identity, err := parseHotOperationID(receipt.OperationID)
+	if err != nil {
+		return err
+	}
+	if len(runtime.operations) >= hotOperationMaxClients && runtime.operations[identity.Client].OperationID == "" {
+		return ErrHotOperationLimit
+	}
+	operations := cloneHotOperationReceipts(runtime.operations)
+	operations[identity.Client] = receipt
+	state := hotDurableState{Version: 1, Generation: runtime.inventory.Snapshot().Generation, Handles: runtime.handles, Providers: runtime.providers, Revisions: runtime.revisions, Operations: operations}
+	if err := runtime.writeState(ctx, state); err != nil {
+		// A terminal response is only authoritative when its receipt is durable.
+		// Fence until restart readback if even the rejection cannot be recorded.
+		c.fenceHotOutcome(runtime, ErrHotInventoryStorageOutcomeUnknown)
+		return ErrHotOperationOutcomeUnknown
+	}
+	runtime.operations = operations
+	return nil
+}
+
+// HotOperationStatus reads the authoritative receipt after a restart. A
+// missing next sequence is an explicit not_started result; older or skipped
+// sequences are never guessed or replayed.
+func (c *ControlPlane) HotOperationStatus(operationID string) (HotOperationReceipt, error) {
+	runtime := c.hotInventory.Load()
+	if runtime == nil {
+		return HotOperationReceipt{}, errors.New("hot inventory is disabled")
+	}
+	identity, err := parseHotOperationID(operationID)
+	if err != nil {
+		return HotOperationReceipt{}, err
+	}
+	runtime.mu.Lock()
+	defer runtime.mu.Unlock()
+	if runtime.closed {
+		return HotOperationReceipt{}, outbound.ErrHotInventoryClosed
+	}
+	previous := runtime.operations[identity.Client]
+	if previous.OperationID == "" {
+		// Client authorities are never evicted. Once full, an unregistered
+		// identity can never have an accepted or delayed accepted mutation.
+		if len(runtime.operations) >= hotOperationMaxClients {
+			return HotOperationReceipt{}, ErrHotOperationLimit
+		}
+		if identity.Seq != 1 {
+			return HotOperationReceipt{}, fmt.Errorf("%w: expected 1", ErrHotOperationSequence)
+		}
+		return HotOperationReceipt{OperationID: operationID, Kind: "", State: "not_started", Generation: runtime.inventory.Snapshot().Generation}, nil
+	}
+	prior, _ := parseHotOperationID(previous.OperationID)
+	if identity.Seq < prior.Seq {
+		return HotOperationReceipt{}, ErrHotOperationExpired
+	}
+	if identity.Seq == prior.Seq {
+		return previous, nil
+	}
+	if identity.Seq != prior.Seq+1 {
+		return HotOperationReceipt{}, ErrHotOperationSequence
+	}
+	return HotOperationReceipt{OperationID: operationID, State: "not_started", Generation: runtime.inventory.Snapshot().Generation}, nil
+}
+
+// PublishHotProviderOperation performs a durable provider mutation under an
+// explicit operation authority. Direct Go callers can retain the legacy
+// PublishHotProvider API, while the Unix control socket uses this method.
+func (c *ControlPlane) PublishHotProviderOperation(ctx context.Context, operationID string, req HotProviderRequest) (outbound.HotInventoryPublication, error) {
+	return c.runHotOperation(ctx, operationID, "provider_publish", req, func(runtime *hotProviderRuntime) (outbound.HotInventoryPublication, error) {
+		return c.publishHotProviderLocked(ctx, runtime, req)
+	})
+}
+
+// SetHotSelectionOperation is the durable operation form of SetHotSelection.
+func (c *ControlPlane) SetHotSelectionOperation(ctx context.Context, operationID string, expected uint64, handle uint8, candidateID string) (outbound.HotInventoryPublication, error) {
+	request := struct {
+		ExpectedGeneration uint64 `json:"expected_generation"`
+		Handle             uint8  `json:"handle"`
+		CandidateID        string `json:"candidate_id"`
+	}{expected, handle, candidateID}
+	return c.runHotOperation(ctx, operationID, "selection_set", request, func(runtime *hotProviderRuntime) (outbound.HotInventoryPublication, error) {
+		return c.setHotSelectionLocked(ctx, runtime, expected, handle, candidateID)
+	})
+}
+
+func hotRejectedOperationError(code string) error {
+	switch code {
+	case "generation_conflict":
+		return outbound.ErrHotInventoryConflict
+	case "inventory_busy":
+		return outbound.ErrHotInventoryBusy
+	case "invalid_request":
+		return outbound.ErrHotInventoryInvalid
+	case "request_canceled":
+		return context.Canceled
+	default:
+		return fmt.Errorf("hot operation was rejected: %s", code)
+	}
+}
