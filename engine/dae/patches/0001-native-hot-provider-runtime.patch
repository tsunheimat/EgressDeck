+func TestHotControlUnixSocketPermissionsAndLifecycle(t *testing.T) {
+	dir := shortHotControlDir(t)
+	socket := filepath.Join(dir, "control.sock")
+	f := &hotControlFixture{}
+	s, err := startHotControl(f, socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = s.Close() })
+	for _, tc := range []struct {
+		path string
+		mode os.FileMode
+	}{{dir, 0o700}, {socket, 0o600}} {
+		info, err := os.Stat(tc.path)
+		if err != nil || info.Mode().Perm() != tc.mode {
+			t.Fatalf("permissions %s: info=%v err=%v", tc.path, info, err)
+		}
+	}
+	transport := &http.Transport{DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "unix", socket)
+	}}
+	t.Cleanup(transport.CloseIdleConnections)
+	client := &http.Client{Transport: transport, Timeout: 3 * time.Second}
+	resp, err := client.Get("http://local/v1/inventory")
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err := io.ReadAll(resp.Body)
+	_ = resp.Body.Close()
+	if err != nil || resp.StatusCode != http.StatusOK || !json.Valid(body) || f.reads.Load() != 1 {
+		t.Fatalf("socket read: status=%d body=%s err=%v", resp.StatusCode, body, err)
+	}
+	if second, err := startHotControl(f, socket); err == nil {
+		_ = second.Close()
+		t.Fatal("replaced active socket")
+	}
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(socket); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("socket still exists: %v", err)
+	}
+}
