index 0000000000000000000000000000000000000000..a3cf2dc6f4b442cc7b438662442e4edc254a18b6
--- /dev/null
+++ b/component/outbound/hot_inventory.go
@@ -0,0 +1,637 @@
+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Copyright (c) 2026, daeuniverse Organization <dae@v2raya.org>
+ */
+
+package outbound
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+	"sort"
+	"sync"
+
+	"github.com/daeuniverse/dae/common/consts"
+	"github.com/daeuniverse/dae/component/outbound/dialer"
+)
+
+var (
+	ErrHotInventoryBusy      = errors.New("hot inventory retirement limit reached")
+	ErrHotInventoryConflict  = errors.New("hot inventory generation conflict")
+	ErrHotInventoryClosed    = errors.New("hot inventory closed")
+	ErrHotInventoryInvalid   = errors.New("invalid prepared hot inventory")
+	ErrHotInventoryUnmanaged = errors.New("outbound uses the borrowed baseline inventory")
+)
+
+// HotInventoryEntry describes an already prepared native group. Identity is an
+// opaque revision identity covering membership and connection definitions;
+// it must not expose credentials. Selection has its own generation change.
+// Names and handles are fixed at construction. Adding, removing or renumbering
+// handles requires a separate
+// policy deployment and is deliberately not supported here.
+type HotInventoryEntry struct {
+	Handle        uint8
+	Identity      string
+	GroupRevision uint64
+	Group         *DialerGroup
+	Candidates    []HotInventoryCandidate
+	Selection     string
+	// Borrowed is allowed only at construction. The baseline control plane
+	// keeps lifetime ownership; AcquireManaged tells callers to use its normal
+	// selection path until an owned hot publication replaces this handle.
+	Borrowed bool
+}
+
+// HotInventoryCandidate gives a provider-scoped stable identity to one native
+// dialer. Candidates must be aligned one-for-one with Group.Dialers. Their IDs
+// survive refreshes when the normalized connection definition is unchanged.
+type HotInventoryCandidate struct {
+	ID     string
+	Dialer *dialer.Dialer
+}
+
+// HotInventoryGroup is a resource-free readback record.
+type HotInventoryGroup struct {
+	Handle        uint8
+	Name          string
+	Identity      string
+	GroupRevision uint64
+	CandidateIDs  []string
+	Selection     string
+}
+
+type HotInventorySnapshot struct {
+	Generation uint64
+	Groups     []HotInventoryGroup
+}
+
+// HotInventoryPublication explicitly identifies the prepared groups whose
+// ownership transferred. In particular, fresh groups supplied with an already
+// active identity remain caller-owned, including in a partly no-op publication.
+// Supplying an already owned group for a no-op does not return its ownership.
+type HotInventoryPublication struct {
+	Snapshot     HotInventorySnapshot
+	Adopted      []uint8
+	CleanupError error
+}
+
+// HotInventoryCommit must durably commit the supplied readback before returning
+// nil; an error must leave the old durable revision authoritative. It runs under
+// the inventory mutex and MUST NOT call inventory methods. After it returns nil,
+// publication completes even if the request context has since been cancelled.
+type HotInventoryCommit func(context.Context, HotInventorySnapshot) error
+
+type hotInventoryGroup struct {
+	entry      HotInventoryEntry
+	name       string
+	dialers    []*dialer.Dialer
+	candidates map[string]*dialer.Dialer
+	selection  string
+	leases     int
+	active     bool
+	closing    bool
+	retirement *hotInventoryRetirement
+}
+
+type hotInventoryResource struct {
+	dialer    *dialer.Dialer
+	option    *dialer.GlobalOption
+	transport any
+	namespace string
+	groups    int
+	closing   bool
+}
+
+type hotInventoryRetirement struct{ remaining int }
+
+type hotInventoryCleanup struct {
+	group     *hotInventoryGroup
+	resources []*hotInventoryResource
+}
+
+// HotInventory is an in-process prerequisite, not a management server or a
+// ControlPlane integration. Callers build and validate native groups separately
+// with inert kernel callbacks; this primitive does not activate or version-gate
+// connectivity callbacks, alter routing, attach BPF, or reload a daemon.
+//
+// Successful construction/publication transfers exclusive ownership of adopted
+// groups and their resources. Membership, names, selection configuration and
+// dialer definitions must then remain immutable. Native health updates remain
+// allowed. Exact *dialer.Dialer pointers may be shared across owned groups, but
+// distinct dialers must have private GlobalOptions and concrete transports:
+// native Close mutates GlobalOption and may close the underlying transport.
+// Every distinct dialer also needs a unique nonempty TransportCacheNamespace.
+// These shallow identity checks cannot discover shared closers hidden inside
+// wrappers; absence of hidden lifecycle sharing remains a caller precondition.
+// Previously transferred and subsequently drained resources must never be
+// submitted again. The caller owns rejected and identity-no-op preparations.
+//
+// A lease pins all candidates in one group before selection/dialing. Retired
+// batches, including cleanup in progress, are bounded. A long-lived lease can
+// retain a complete old group, so callers should also bound group size and flow
+// lifetime; this primitive never forcibly terminates a session.
+type HotInventory struct {
+	mu                 sync.Mutex
+	generation         uint64
+	active             map[uint8]*hotInventoryGroup
+	groups             map[*DialerGroup]*hotInventoryGroup
+	resources          map[*dialer.Dialer]*hotInventoryResource
+	retirements        map[*hotInventoryRetirement]struct{}
+	maxRetired         int
+	closed             bool
+	borrowedDialers    map[*dialer.Dialer]bool
+	borrowedOptions    map[*dialer.GlobalOption]bool
+	borrowedTransports map[any]bool
+	borrowedNamespaces map[string]bool
+	cleanupNamespace   func(string)
+}
+
+// NewHotInventory fixes the handle table and transfers owned entries on success.
+// The initial generation is one. maxRetired must be positive.
+func NewHotInventory(entries []HotInventoryEntry, maxRetired int) (*HotInventory, error) {
+	return NewHotInventoryAtGeneration(entries, maxRetired, 1)
+}
+
+// NewHotInventoryAtGeneration restores an already durably committed inventory.
+// The caller must supply its complete current state; no history is replayed.
+// A positive generation preserves stale-writer fencing over process restart.
+func NewHotInventoryAtGeneration(entries []HotInventoryEntry, maxRetired int, generation uint64) (*HotInventory, error) {
+	if maxRetired < 1 || len(entries) == 0 || generation == 0 {
+		return nil, fmt.Errorf("%w: nonempty entries and positive retirement limit required", ErrHotInventoryInvalid)
+	}
+	h := &HotInventory{
+		generation: generation, active: make(map[uint8]*hotInventoryGroup),
+		groups:      make(map[*DialerGroup]*hotInventoryGroup),
+		resources:   make(map[*dialer.Dialer]*hotInventoryResource),
+		retirements: make(map[*hotInventoryRetirement]struct{}), maxRetired: maxRetired,
+		borrowedDialers:    make(map[*dialer.Dialer]bool),
+		borrowedOptions:    make(map[*dialer.GlobalOption]bool),
+		borrowedTransports: make(map[any]bool),
+		borrowedNamespaces: make(map[string]bool),
+		cleanupNamespace:   dialer.CleanupTransportCacheNamespace,
+	}
+	// Reserve baseline identities without taking lifecycle ownership. Entries
+	// restored as owned must not share closers with any borrowed native group.
+	for _, entry := range entries {
+		if entry.Borrowed && entry.Group != nil {
+			for _, d := range entry.Group.Dialers {
+				if d == nil {
+					continue
+				}
+				h.borrowedDialers[d] = true
+				if d.GlobalOption != nil {
+					h.borrowedOptions[d.GlobalOption] = true
+					if d.TransportCacheNamespace != "" {
+						h.borrowedNamespaces[d.TransportCacheNamespace] = true
+					}
+				}
+				if value := reflect.ValueOf(d.Dialer); value.IsValid() && value.Kind() == reflect.Pointer && !value.IsNil() {
+					h.borrowedTransports[d.Dialer] = true
+				}
+			}
+		}
+	}
+	prepared, err := h.validateLocked(entries, true)
+	if err != nil {
+		return nil, err
+	}
+	for _, group := range prepared {
+		h.adoptLocked(group)
+	}
+	return h, nil
+}
+
+func (h *HotInventory) validateLocked(entries []HotInventoryEntry, initial bool) ([]*hotInventoryGroup, error) {
+	seenHandles := make(map[uint8]bool)
+	seenNames := make(map[string]bool)
+	seenGroups := make(map[*DialerGroup]bool)
+	seenDialers := make(map[*dialer.Dialer]bool)
+	options := make(map[*dialer.GlobalOption]*dialer.Dialer)
+	transports := make(map[any]*dialer.Dialer)
+	namespaces := make(map[string]*dialer.Dialer)
+	for d, resource := range h.resources {
+		options[resource.option] = d
+		transports[resource.transport] = d
+		namespaces[resource.namespace] = d
+	}
+	var prepared []*hotInventoryGroup
+	for _, entry := range entries {
+		if entry.Handle < uint8(consts.OutboundUserDefinedMin) || entry.Handle > uint8(consts.OutboundUserDefinedMax) ||
+			entry.Identity == "" || entry.Group == nil || entry.Group.Name == "" || seenHandles[entry.Handle] {
+			return nil, fmt.Errorf("%w: duplicate handle or missing/invalid entry", ErrHotInventoryInvalid)
+		}
+		if entry.Borrowed {
+			if !initial || seenNames[entry.Group.Name] || seenGroups[entry.Group] {
+				return nil, fmt.Errorf("%w: borrowed entries are unique constructor-only baseline groups", ErrHotInventoryInvalid)
+			}
+			seenHandles[entry.Handle], seenNames[entry.Group.Name], seenGroups[entry.Group] = true, true, true
+			entry.Candidates, entry.Selection = nil, ""
+			prepared = append(prepared, &hotInventoryGroup{entry: entry, name: entry.Group.Name, active: true})
+			continue
+		}
+		if len(entry.Group.Dialers) == 0 || len(entry.Candidates) != len(entry.Group.Dialers) || entry.Selection == "" {
+			return nil, fmt.Errorf("%w: owned groups require aligned candidates and selection", ErrHotInventoryInvalid)
+		}
+		policy := entry.Group.currentSelectionState().policy
+		if policy.Policy == consts.DialerSelectionPolicy_Fixed && (policy.FixedIndex < 0 || policy.FixedIndex >= len(entry.Group.Dialers)) {
+			return nil, fmt.Errorf("%w: fixed selection is outside group membership", ErrHotInventoryInvalid)
+		}
+		seenHandles[entry.Handle] = true
+		current := h.active[entry.Handle]
+		if !initial {
+			if current == nil || current.name != entry.Group.Name {
+				return nil, fmt.Errorf("%w: handles and group names are fixed", ErrHotInventoryInvalid)
+			}
+			if current.entry.Identity == entry.Identity && current.entry.GroupRevision == entry.GroupRevision {
+				if current.selection != entry.Selection {
+					return nil, fmt.Errorf("%w: selection changes require SetSelection", ErrHotInventoryInvalid)
+				}
+				continue
+			}
+		}
+		if seenNames[entry.Group.Name] || seenGroups[entry.Group] || h.groups[entry.Group] != nil {
+			return nil, fmt.Errorf("%w: group or name is already owned", ErrHotInventoryInvalid)
+		}
+		seenNames[entry.Group.Name], seenGroups[entry.Group] = true, true
+		group := &hotInventoryGroup{entry: entry, name: entry.Group.Name, active: true}
+		group.selection = entry.Selection
+		group.candidates = make(map[string]*dialer.Dialer, len(entry.Candidates))
+		members := make(map[*dialer.Dialer]bool)
+		for i, candidate := range entry.Candidates {
+			d := candidate.Dialer
+			if candidate.ID == "" || group.candidates[candidate.ID] != nil || d != entry.Group.Dialers[i] {
+				return nil, fmt.Errorf("%w: candidate IDs and native group membership must align", ErrHotInventoryInvalid)
+			}
+			group.candidates[candidate.ID] = d
+			if d == nil || d.GlobalOption == nil || d.Dialer == nil || d.TransportCacheNamespace == "" {
+				return nil, fmt.Errorf("%w: incomplete native dialer", ErrHotInventoryInvalid)
+			}
+			transport := reflect.ValueOf(d.Dialer)
+			if transport.Kind() != reflect.Pointer || transport.IsNil() {
+				return nil, fmt.Errorf("%w: concrete transport must have nonnil pointer identity", ErrHotInventoryInvalid)
+			}
+			if h.borrowedDialers[d] || h.borrowedOptions[d.GlobalOption] || h.borrowedTransports[d.Dialer] || h.borrowedNamespaces[d.TransportCacheNamespace] {
+				return nil, fmt.Errorf("%w: owned candidate aliases borrowed native lifecycle", ErrHotInventoryInvalid)
+			}
+			if members[d] {
+				return nil, fmt.Errorf("%w: duplicate native dialer candidate", ErrHotInventoryInvalid)
+			}
+			members[d] = true
+			group.dialers = append(group.dialers, d)
+			if resource := h.resources[d]; resource != nil {
+				if resource.closing || resource.option != d.GlobalOption || resource.transport != any(d.Dialer) || resource.namespace != d.TransportCacheNamespace {
+					return nil, fmt.Errorf("%w: owned dialer changed or is closing", ErrHotInventoryInvalid)
+				}
+				continue
+			}
+			if seenDialers[d] {
+				continue
+			}
+			if options[d.GlobalOption] != nil || transports[d.Dialer] != nil || namespaces[d.TransportCacheNamespace] != nil {
+				return nil, fmt.Errorf("%w: distinct dialers share lifecycle ownership", ErrHotInventoryInvalid)
+			}
+			seenDialers[d] = true
+			options[d.GlobalOption], transports[d.Dialer] = d, d
+			namespaces[d.TransportCacheNamespace] = d
+		}
+		if group.candidates[group.selection] == nil {
+			return nil, fmt.Errorf("%w: selected candidate is absent", ErrHotInventoryInvalid)
+		}
+		// Keep the latest user choice across provider publication whenever the
+		// stable ID still exists. A missing choice requires the caller's explicit
+		// valid replacement in entry.Selection; there is no implicit Direct.
+		if current != nil && group.candidates[current.selection] != nil {
+			group.selection = current.selection
+		}
+		// Retain private metadata, never the caller's mutable candidate slice.
+		group.entry.Candidates = nil
+		prepared = append(prepared, group)
+	}
+	return prepared, nil
+}
+
+func (h *HotInventory) adoptLocked(group *hotInventoryGroup) {
+	h.active[group.entry.Handle] = group
+	h.groups[group.entry.Group] = group
+	for _, d := range group.dialers {
+		resource := h.resources[d]
+		if resource == nil {
+			resource = &hotInventoryResource{dialer: d, option: d.GlobalOption, transport: d.Dialer, namespace: d.TransportCacheNamespace}
+			h.resources[d] = resource
+		}
+		resource.groups++
+	}
+}
+
+func hotInventoryReadback(generation uint64, groups map[uint8]*hotInventoryGroup) HotInventorySnapshot {
+	snapshot := HotInventorySnapshot{Generation: generation, Groups: make([]HotInventoryGroup, 0, len(groups))}
+	for handle, group := range groups {
+		candidateIDs := make([]string, 0, len(group.candidates))
+		for id := range group.candidates {
+			candidateIDs = append(candidateIDs, id)
+		}
+		sort.Strings(candidateIDs)
+		snapshot.Groups = append(snapshot.Groups, HotInventoryGroup{Handle: handle, Name: group.name, Identity: group.entry.Identity, GroupRevision: group.entry.GroupRevision, CandidateIDs: candidateIDs, Selection: group.selection})
+	}
+	sort.Slice(snapshot.Groups, func(i, j int) bool { return snapshot.Groups[i].Handle < snapshot.Groups[j].Handle })
+	return snapshot
+}
+
+func (h *HotInventory) Snapshot() HotInventorySnapshot {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return hotInventoryReadback(h.generation, h.active)
+}
+
+// Publish atomically replaces only supplied groups after validation and durable
+// commit. Unaffected groups keep their exact native pointers. Errors transfer
+// no ownership. Identity no-ops neither call commit nor advance the generation.
+func (h *HotInventory) Publish(ctx context.Context, expected uint64, entries []HotInventoryEntry, commit HotInventoryCommit) (HotInventoryPublication, error) {
+	h.mu.Lock()
+	if h.closed {
+		h.mu.Unlock()
+		return HotInventoryPublication{}, ErrHotInventoryClosed
+	}
+	if h.generation != expected {
+		h.mu.Unlock()
+		return HotInventoryPublication{}, ErrHotInventoryConflict
+	}
+	prepared, err := h.validateLocked(entries, false)
+	if err != nil {
+		h.mu.Unlock()
+		return HotInventoryPublication{}, err
+	}
+	if len(prepared) == 0 {
+		result := HotInventoryPublication{Snapshot: hotInventoryReadback(h.generation, h.active)}
+		h.mu.Unlock()
+		return result, nil
+	}
+	if len(h.retirements) >= h.maxRetired {
+		h.mu.Unlock()
+		return HotInventoryPublication{}, ErrHotInventoryBusy
+	}
+	if commit == nil || h.generation == ^uint64(0) {
+		h.mu.Unlock()
+		return HotInventoryPublication{}, fmt.Errorf("%w: durable commit required and generation must not overflow", ErrHotInventoryInvalid)
+	}
+	if err := ctx.Err(); err != nil {
+		h.mu.Unlock()
+		return HotInventoryPublication{}, err
+	}
+	next := make(map[uint8]*hotInventoryGroup, len(h.active))
+	for handle, group := range h.active {
+		next[handle] = group
+	}
+	for _, group := range prepared {
+		next[group.entry.Handle] = group
+	}
+	if err := commit(ctx, hotInventoryReadback(h.generation+1, next)); err != nil {
+		h.mu.Unlock()
+		return HotInventoryPublication{}, err
+	}
+	retirement := &hotInventoryRetirement{remaining: len(prepared)}
+	h.retirements[retirement] = struct{}{}
+	var previous []*hotInventoryGroup
+	result := HotInventoryPublication{}
+	for _, group := range prepared {
+		old := h.active[group.entry.Handle]
+		old.active, old.retirement = false, retirement
+		previous = append(previous, old)
+		h.adoptLocked(group)
+		result.Adopted = append(result.Adopted, group.entry.Handle)
+	}
+	h.generation++
+	result.Snapshot = hotInventoryReadback(h.generation, h.active)
+	var cleanup []hotInventoryCleanup
+	for _, group := range previous {
+		if group.leases == 0 {
+			cleanup = append(cleanup, h.cleanupLocked(group))
+		}
+	}
+	h.mu.Unlock()
+	// Cleanup errors are distinct from publication acknowledgement: readback is
+	// already authoritative. Native group/dialer Close currently return nil.
+	result.CleanupError = h.runCleanup(cleanup)
+	return result, nil
+}
+
+// HotInventoryLease must be obtained before reading/selecting a native group,
+// and held through dialing and the entire established session lifetime. Group
+// and its candidates may be used until Release; they must never be mutated.
+// Dialer is authoritative for the flow, including manual SetSelection; do not
+// call Group.Select afterward because its immutable native policy may retain a
+// different fixed index.
+// Release is idempotent. A caller must not race use of this lease with Release.
+type HotInventoryLease struct {
+	Group       *DialerGroup
+	Dialer      *dialer.Dialer
+	CandidateID string
+	Generation  uint64
+	Handle      uint8
+	Identity    string
+	owner       *HotInventory
+	group       *hotInventoryGroup
+	once        sync.Once
+	err         error
+}
+
+// SetSelection persists a stable candidate choice without replacing the native
+// group. It uses the same generation CAS and durable-before-publish ordering as
+// Publish. Identity no-ops skip the callback and generation increment.
+func (h *HotInventory) SetSelection(ctx context.Context, expected uint64, handle uint8, candidateID string, commit HotInventoryCommit) (HotInventoryPublication, error) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.closed {
+		return HotInventoryPublication{}, ErrHotInventoryClosed
+	}
+	if h.generation != expected {
+		return HotInventoryPublication{}, ErrHotInventoryConflict
+	}
+	group := h.active[handle]
+	if group != nil && group.entry.Borrowed {
+		return HotInventoryPublication{}, ErrHotInventoryUnmanaged
+	}
+	if group == nil || group.candidates[candidateID] == nil {
+		return HotInventoryPublication{}, fmt.Errorf("%w: unknown handle or candidate", ErrHotInventoryInvalid)
+	}
+	if group.selection == candidateID {
+		return HotInventoryPublication{Snapshot: hotInventoryReadback(h.generation, h.active)}, nil
+	}
+	if commit == nil || h.generation == ^uint64(0) {
+		return HotInventoryPublication{}, fmt.Errorf("%w: durable commit required and generation must not overflow", ErrHotInventoryInvalid)
+	}
+	if err := ctx.Err(); err != nil {
+		return HotInventoryPublication{}, err
+	}
+	next := make(map[uint8]*hotInventoryGroup, len(h.active))
+	for handle, current := range h.active {
+		if handle == group.entry.Handle {
+			copy := *current
+			copy.selection = candidateID
+			copy.entry.Selection = candidateID
+			next[handle] = &copy
+		} else {
+			next[handle] = current
+		}
+	}
+	if err := commit(ctx, hotInventoryReadback(h.generation+1, next)); err != nil {
+		return HotInventoryPublication{}, err
+	}
+	group.selection = candidateID
+	group.entry.Selection = candidateID
+	h.generation++
+	return HotInventoryPublication{Snapshot: hotInventoryReadback(h.generation, h.active)}, nil
+}
+
+func (h *HotInventory) Acquire(handle uint8) (*HotInventoryLease, error) {
+	lease, managed, err := h.AcquireManaged(handle)
+	if err != nil {
+		return nil, err
+	}
+	if !managed {
+		return nil, ErrHotInventoryUnmanaged
+	}
+	return lease, nil
+}
+
+// AcquireManaged atomically decides between borrowed baseline handling and a
+// retained hot decision. An unmanaged result is (nil, false, nil); callers must
+// retain their existing baseline control-plane admission lease while falling
+// back. A hot publication may follow that decision without invalidating the
+// borrowed native resources, which remain owned by the baseline control plane.
+func (h *HotInventory) AcquireManaged(handle uint8) (*HotInventoryLease, bool, error) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.closed {
+		return nil, false, ErrHotInventoryClosed
+	}
+	group := h.active[handle]
+	if group == nil {
+		return nil, false, fmt.Errorf("%w: unknown handle", ErrHotInventoryInvalid)
+	}
+	if group.entry.Borrowed {
+		return nil, false, nil
+	}
+	lease, err := h.acquireGroupLocked(group, group.selection)
+	return lease, true, err
+}
+
+// IsHot is a status query, not a substitute for atomic AcquireManaged.
+func (h *HotInventory) IsHot(handle uint8) bool {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	group := h.active[handle]
+	return !h.closed && group != nil && !group.entry.Borrowed
+}
+
+// AcquireCandidate pins a group and returns the requested stable candidate.
+// It is useful for deterministic probes; ordinary flows should use Acquire so
+// the current persisted selection is honored.
+func (h *HotInventory) AcquireCandidate(handle uint8, candidateID string) (*HotInventoryLease, error) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.closed {
+		return nil, ErrHotInventoryClosed
+	}
+	group := h.active[handle]
+	if group == nil {
+		return nil, fmt.Errorf("%w: unknown handle", ErrHotInventoryInvalid)
+	}
+	if group.entry.Borrowed {
+		return nil, ErrHotInventoryUnmanaged
+	}
+	return h.acquireGroupLocked(group, candidateID)
+}
+
+func (h *HotInventory) acquireGroupLocked(group *hotInventoryGroup, candidateID string) (*HotInventoryLease, error) {
+	d := group.candidates[candidateID]
+	if d == nil {
+		return nil, fmt.Errorf("%w: unknown candidate", ErrHotInventoryInvalid)
+	}
+	group.leases++
+	return &HotInventoryLease{Group: group.entry.Group, Dialer: d, CandidateID: candidateID, Generation: h.generation, Handle: group.entry.Handle, Identity: group.entry.Identity, owner: h, group: group}, nil
+}
+
+func (l *HotInventoryLease) Release() error {
+	if l == nil {
+		return nil
+	}
+	l.once.Do(func() {
+		h := l.owner
+		h.mu.Lock()
+		l.group.leases--
+		var cleanup []hotInventoryCleanup
+		if l.group.leases == 0 && !l.group.active {
+			cleanup = append(cleanup, h.cleanupLocked(l.group))
+		}
+		h.mu.Unlock()
+		l.err = h.runCleanup(cleanup)
+	})
+	return l.err
+}
+
+func (h *HotInventory) cleanupLocked(group *hotInventoryGroup) hotInventoryCleanup {
+	group.closing = true
+	cleanup := hotInventoryCleanup{group: group}
+	for _, d := range group.dialers {
+		resource := h.resources[d]
+		resource.groups--
+		if resource.groups == 0 {
+			resource.closing = true
+			cleanup.resources = append(cleanup.resources, resource)
+		}
+	}
+	return cleanup
+}
+
+func (h *HotInventory) runCleanup(cleanups []hotInventoryCleanup) error {
+	var errs []error
+	for _, cleanup := range cleanups {
+		if !cleanup.group.entry.Borrowed {
+			errs = append(errs, cleanup.group.entry.Group.Close())
+		}
+		for _, resource := range cleanup.resources {
+			errs = append(errs, resource.dialer.Close())
+			h.cleanupNamespace(resource.namespace)
+		}
+		h.mu.Lock()
+		delete(h.groups, cleanup.group.entry.Group)
+		for _, resource := range cleanup.resources {
+			delete(h.resources, resource.dialer)
+		}
+		retirement := cleanup.group.retirement
+		retirement.remaining--
+		if retirement.remaining == 0 {
+			delete(h.retirements, retirement)
+		}
+		h.mu.Unlock()
+	}
+	return errors.Join(errs...)
+}
+
+// Close stops admission and releases active ownership. It does not invalidate
+// existing leases; their final Release closes the remaining native resources.
+func (h *HotInventory) Close() error {
+	h.mu.Lock()
+	if h.closed {
+		h.mu.Unlock()
+		return nil
+	}
+	h.closed = true
+	retirement := &hotInventoryRetirement{remaining: len(h.active)}
+	if retirement.remaining > 0 {
+		h.retirements[retirement] = struct{}{}
+	}
+	var cleanup []hotInventoryCleanup
+	for _, group := range h.active {
+		group.active, group.retirement = false, retirement
+		if group.leases == 0 {
+			cleanup = append(cleanup, h.cleanupLocked(group))
+		}
+	}
+	h.active = make(map[uint8]*hotInventoryGroup)
+	h.mu.Unlock()
+	return h.runCleanup(cleanup)
+}
