+func TestHotOperationPrecommitRejectionTerminatesAcrossRestart(t *testing.T) {
+	for _, name := range []string{"invalid_candidate", "stale_selection_generation", "stale_provider_generation", "canceled_selection", "canceled_provider"} {
+		t.Run(name, func(t *testing.T) {
+			stateDir := filepath.Join(t.TempDir(), "state")
+			cp := hotTestControlPlane(t, stateDir, "first")
+			req := hotTestRequest("p", "one", "first", 1, "socks5://127.0.0.1:1")
+			if _, err := cp.PublishHotProvider(context.Background(), req); err != nil {
+				t.Fatal(err)
+			}
+			id := hotTestOperationID(1, 1)
+			mutate := func(cp *ControlPlane) error {
+				ctx := context.Background()
+				if strings.HasPrefix(name, "canceled_") {
+					var cancel context.CancelFunc
+					ctx, cancel = context.WithCancel(ctx)
+					cancel()
+				}
+				if strings.HasSuffix(name, "provider") || name == "stale_provider_generation" {
+					update := cloneHotRequest(req)
+					update.RevisionID = "two"
+					update.ExpectedGeneration = 2
+					if name == "stale_provider_generation" {
+						update.ExpectedGeneration = 1
+					}
+					_, err := cp.PublishHotProviderOperation(ctx, id, update)
+					return err
+				}
+				expected, candidate := uint64(2), "p-b"
+				if name == "invalid_candidate" {
+					candidate = "absent"
+				}
+				if name == "stale_selection_generation" {
+					expected = 1
+				}
+				_, err := cp.SetHotSelectionOperation(ctx, id, expected, 2, candidate)
+				return err
+			}
+			if err := mutate(cp); err == nil {
+				t.Fatal("precommit failure acknowledged success")
+			}
+			receipt := hotTestOperationReceipt(t, cp, id, "rejected", 2)
+			if err := cp.closeHotInventory(); err != nil {
+				t.Fatal(err)
+			}
+			cp = hotTestControlPlane(t, stateDir, "first")
+			if got := hotTestOperationReceipt(t, cp, id, "rejected", 2); !reflect.DeepEqual(got, receipt) {
+				t.Fatalf("restart lost terminal rejection: %#v != %#v", got, receipt)
+			}
+			if err := mutate(cp); err == nil {
+				t.Fatal("replay of rejected operation acknowledged success")
+			}
+			if got := hotTestAcquire(t, cp, 2); got.CandidateID != "p-a" || got.Generation != 2 {
+				t.Fatalf("rejected mutation changed active selection: %#v", got)
+			}
+			if publication, err := cp.SetHotSelectionOperation(context.Background(), hotTestOperationID(1, 2), 2, 2, "p-b"); err != nil || publication.Snapshot.Generation != 3 {
+				t.Fatalf("resolved rejection left future management blocked: %#v %v", publication, err)
+			}
+		})
+	}
+}
