+func hotDNSTestArgument(t *testing.T, inventory *outbound.HotInventory) *dialArgument {
+	t.Helper()
+	lease, err := inventory.Acquire(2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = lease.Release() })
+	return &dialArgument{l4proto: consts.L4ProtoStr_TCP, ipversion: consts.IpVersionStr_4,
+		bestDialer: lease.Dialer, bestOutbound: lease.Group,
+		bestTarget: netip.MustParseAddrPort("192.0.2.53:53"), hotLease: lease}
+}
+
+func hotDNSTestPublish(t *testing.T, inventory *outbound.HotInventory, entry outbound.HotInventoryEntry) {
+	t.Helper()
+	_, err := inventory.Publish(context.Background(), inventory.Snapshot().Generation, []outbound.HotInventoryEntry{entry},
+		func(context.Context, outbound.HotInventorySnapshot) error { return nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func hotDNSTestController() *DnsController {
+	c := newTestDnsController()
+	c.log = logrus.New()
+	c.log.SetOutput(io.Discard)
+	return c
+}
+
+func hotDNSTestQuery(t *testing.T) (*componentdns.Upstream, []byte) {
+	t.Helper()
+	query := new(dnsmessage.Msg)
+	query.SetQuestion("hot-dns.example.", dnsmessage.TypeA)
+	wire, err := query.Pack()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &componentdns.Upstream{Scheme: componentdns.UpstreamScheme_TCP, Hostname: "192.0.2.53", Port: 53}, wire
+}
+
+func TestHotDNSReplacementUsesNativeTransportAndRetainsRunningExchange(t *testing.T) {
+	old, oldTransport := hotDNSTestEntry(t, "old", "198.51.100.1")
+	inventory := hotDNSTestInventory(t, old)
+	c := hotDNSTestController()
+	upstream, query := hotDNSTestQuery(t)
+	oldArg := hotDNSTestArgument(t, inventory)
+	proceed := make(chan struct{})
+	oldTransport.proceed = proceed
+	oldTransport.entered = make(chan struct{}, 1)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	type result struct {
+		msg *dnsmessage.Msg
+		err error
+	}
+	done := make(chan result, 1)
+	go func() { msg, err := c.forwardWithDialArg(ctx, upstream, oldArg, query); done <- result{msg, err} }()
+	select {
+	case <-oldTransport.entered:
+	case <-ctx.Done():
+		t.Fatal("native DNS exchange did not start")
+	}
+
+	next, nextTransport := hotDNSTestEntry(t, "new", "198.51.100.2")
+	hotDNSTestPublish(t, inventory, next)
+	if oldTransport.closed.Load() != 0 {
+		t.Fatal("publication closed a running DNS exchange")
+	}
+	nextArg := hotDNSTestArgument(t, inventory)
+	if newDnsForwarderKey(upstream, oldArg) != newDnsForwarderKey(upstream, nextArg) {
+		t.Fatal("fixture must collide in the ordinary name-based forwarder cache")
+	}
+	response, err := c.forwardWithDialArg(ctx, upstream, nextArg, query)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := response.Answer[0].(*dnsmessage.A).A.String(); got != "198.51.100.2" {
+		t.Fatalf("next exchange used old native transport: %s", got)
+	}
+	close(proceed)
+	select {
+	case result := <-done:
+		if result.err != nil {
+			t.Fatal(result.err)
+		}
+		if got := result.msg.Answer[0].(*dnsmessage.A).A.String(); got != "198.51.100.1" {
+			t.Fatalf("held exchange changed native transport: %s", got)
+		}
+	case <-ctx.Done():
+		t.Fatal("held native DNS exchange did not finish")
+	}
+	if oldTransport.closed.Load() != 1 || oldTransport.openAtClose.Load() != 0 {
+		t.Fatalf("retirement close count=%d, forwarder connections still open=%d", oldTransport.closed.Load(), oldTransport.openAtClose.Load())
+	}
+	if nextTransport.dials.Load() != 1 {
+		t.Fatal("replacement native transport was not dialed")
+	}
+	c.dnsForwarderCache.Range(func(_, _ any) bool { t.Error("hot forwarder escaped into name-based cache"); return true })
+}
+
+func TestHotDNSFailuresReleaseRetiredNativeGroup(t *testing.T) {
+	for _, failure := range []string{"construction", "dial", "controller_closed", "cancel"} {
+		t.Run(failure, func(t *testing.T) {
+			old, transport := hotDNSTestEntry(t, "old", "198.51.100.1")
+			inventory := hotDNSTestInventory(t, old)
+			arg := hotDNSTestArgument(t, inventory)
+			c := hotDNSTestController()
+			upstream, query := hotDNSTestQuery(t)
+			next, _ := hotDNSTestEntry(t, "next", "198.51.100.2")
+			hotDNSTestPublish(t, inventory, next)
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			switch failure {
+			case "construction":
+				upstream.Scheme = componentdns.UpstreamScheme_UDP
+			case "dial":
+				transport.dialErr = errors.New("fixture dial failure")
+			case "controller_closed":
+				c.dnsForwardersClosed.Store(true)
+			case "cancel":
+				transport.proceed = make(chan struct{})
+				cancel()
+			}
+			if _, err := c.forwardWithDialArg(ctx, upstream, arg, query); err == nil {
+				t.Fatal("expected DNS failure")
+			}
+			if transport.closed.Load() != 1 || transport.openAtClose.Load() != 0 {
+				t.Fatalf("failure leaked lease or closed transport before forwarder: closed=%d open=%d", transport.closed.Load(), transport.openAtClose.Load())
+			}
+			c.dnsForwarderCache.Range(func(_, _ any) bool { t.Error("failed hot forwarder escaped into cache"); return true })
+		})
+	}
+}
