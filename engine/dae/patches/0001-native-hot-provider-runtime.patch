+type hotCapabilityPacketConn struct {
+	*scriptedPacketConn
+	done       chan struct{}
+	batchItems []netproxy.BatchItem
+	receiver   netproxy.PacketReceiveHandler
+}
+
+func (c *hotCapabilityPacketConn) WriteBatch(items []netproxy.BatchItem) (int, error) {
+	c.batchItems = items
+	return 1, io.ErrShortWrite
+}
+func (c *hotCapabilityPacketConn) RegisterPacketReceiver(handler netproxy.PacketReceiveHandler) (func(), bool) {
+	c.receiver = handler
+	return func() { c.receiver = nil }, true
+}
+func (c *hotCapabilityPacketConn) TransportDone() <-chan struct{}   { return c.done }
+func (c *hotCapabilityPacketConn) WriteDeadlineClosesSession() bool { return true }
+
+func TestHotPacketWrapperPreservesNativeCapabilities(t *testing.T) {
+	for _, batch := range []bool{false, true} {
+		t.Run(fmt.Sprint(batch), func(t *testing.T) {
+			base := &scriptedPacketConn{reads: make(chan scriptedPacketRead), closeCh: make(chan struct{})}
+			var native netproxy.Conn = base
+			capable := &hotCapabilityPacketConn{scriptedPacketConn: base, done: make(chan struct{})}
+			if batch {
+				native = capable
+			}
+			_, h := hotConnectionPlane(t, hotConnectionEntry(t, "old", &hotConnectionTransport{}))
+			lease, err := h.Acquire(uint8(consts.OutboundUserDefinedMin))
+			if err != nil {
+				t.Fatal(err)
+			}
+			wrapped := retainHotConnection(native, lease)
+			defer wrapped.Close()
+			writer, hasBatch := wrapped.(netproxy.PacketBatchWriter)
+			if hasBatch != batch {
+				t.Fatalf("batch capability = %v", hasBatch)
+			}
+			if batch {
+				items := []netproxy.BatchItem{{Data: []byte("first"), Addr: "192.0.2.1:53"}, {Data: []byte("second"), Addr: "192.0.2.2:53"}}
+				if n, err := writer.WriteBatch(items); n != 1 || !errors.Is(err, io.ErrShortWrite) {
+					t.Fatalf("native partial result lost: %d %v", n, err)
+				}
+				if &capable.batchItems[0] != &items[0] {
+					t.Fatal("batch data changed")
+				}
+				if !netproxy.WriteDeadlineClosesSession(wrapped) {
+					t.Fatal("lost destructive deadline marker")
+				}
+				if wrapped.(netproxy.TransportLifecycle).TransportDone() != capable.done {
+					t.Fatal("lost transport lifecycle")
+				}
+				stop, ok := wrapped.(netproxy.PacketReceiver).RegisterPacketReceiver(func(*netproxy.ReceivedPacket) bool { return true })
+				if !ok || capable.receiver == nil {
+					t.Fatal("lost packet receiver")
+				}
+				stop()
+				if capable.receiver != nil {
+					t.Fatal("receiver unregister not forwarded")
+				}
+			} else {
+				if netproxy.WriteDeadlineClosesSession(wrapped) {
+					t.Fatal("invented destructive deadline marker")
+				}
+				if _, ok := wrapped.(netproxy.PacketReceiver).RegisterPacketReceiver(nil); ok {
+					t.Fatal("invented receiver")
+				}
+			}
+		})
+	}
+}
