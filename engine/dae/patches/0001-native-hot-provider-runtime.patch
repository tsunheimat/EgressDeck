+			replacement.dial = func(context.Context) (netproxy.Conn, error) { return left, nil }
+			next := hotConnectionEntry(t, "new", replacement)
+			old.dial = func(context.Context) (netproxy.Conn, error) { hotConnectionPublish(t, h, next); return nil, dialErr }
+			conn, _, err := cp.routeDial(context.Background(), hotConnectionParam("tcp"))
+			if errors.Is(dialErr, unix.ENETUNREACH) {
+				if err != nil {
