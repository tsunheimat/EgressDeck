+
+package control
+
+import (
+	"bytes"
+	"context"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+
+	"github.com/daeuniverse/dae/common/consts"
+	"github.com/daeuniverse/dae/component/outbound"
+	"github.com/daeuniverse/dae/component/outbound/dialer"
+	"golang.org/x/sys/unix"
+)
+
+const (
+	hotStateFile        = "inventory.json"
+	hotMaxStateBytes    = 32 << 20
+	hotMaxEnvelopeBytes = 48 << 20
+	hotStateAAD         = "dae-hot-inventory/aes-256-gcm/v1"
+	hotMaxNodes         = 4096
+	hotMaxRevisions     = 128
+	hotMaxLinkBytes     = 16384
+)
+
+// HotProviderRequest replaces all groups owned by one provider. Groups must
+// already exist in the configured policy; their numeric handles never move.
+// Selection is required for a group's first publication and when its selected
+// stable candidate disappears. An existing candidate retains its selection.
+// Node links are secrets and are accepted only on the private management path.
+type HotProviderRequest struct {
+	ExpectedGeneration uint64             `json:"expected_generation"`
+	ProviderID         string             `json:"provider_id"`
+	RevisionID         string             `json:"revision_id"`
+	Nodes              []HotProviderNode  `json:"nodes"`
+	Groups             []HotProviderGroup `json:"groups"`
+}
+
+type HotProviderNode struct {
+	ID   string `json:"id"`
+	Link string `json:"link"`
+}
+
+type HotProviderGroup struct {
+	Revision     uint64   `json:"revision,omitempty"`
+	Name         string   `json:"name"`
+	CandidateIDs []string `json:"candidate_ids"`
+	Selection    string   `json:"selection"`
+}
+
+type hotProviderRuntime struct {
+	mu             sync.Mutex
+	inventory      *outbound.HotInventory
+	providers      map[string]HotProviderRequest
+	groupOverrides map[string]HotGroupRequest
+	revisions      map[string]map[string]string
+	handles        map[string]uint8
+	stateDir       *os.File
+	aead           cipher.AEAD
+	syncDir        func() error
+	closed         bool
+	// operations contains one durable receipt for each client authority. It is
+	// deliberately bounded so a compromised management client cannot turn the
+	// encrypted journal into an unbounded operation log. The latest sequence
+	// number is sufficient to fence retries and skipped requests.
+	operations       map[string]HotOperationReceipt
+	pendingOperation *hotOperationPending
+}
+
+type hotStateEnvelope struct {
+	Version    int    `json:"version"`
+	Nonce      []byte `json:"nonce"`
+	Ciphertext []byte `json:"ciphertext"`
+}
+
+func hotStateCipher() (cipher.AEAD, error) {
+	encoded := os.Getenv("DAE_HOT_STATE_KEY")
+	key, err := hex.DecodeString(encoded)
+	if err != nil || len(key) != 32 {
+		return nil, errors.New("DAE_HOT_STATE_KEY must contain a 32-byte hex key")
+	}
+	defer clear(key)
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, errors.New("cannot initialize hot inventory encryption")
+	}
+	return cipher.NewGCM(block)
+}
+
+type hotDurableState struct {
+	GroupOverrides map[string]HotGroupRequest     `json:"group_overrides,omitempty"`
+	Version        int                            `json:"version"`
+	Generation     uint64                         `json:"generation"`
+	Handles        map[string]uint8               `json:"handles"`
+	Providers      map[string]HotProviderRequest  `json:"providers"`
+	Revisions      map[string]map[string]string   `json:"revisions"`
+	Operations     map[string]HotOperationReceipt `json:"operations,omitempty"`
+}
+
+// EnableHotInventory restores the latest committed provider definitions and
+// choices without subscription downloads. It must run before ingress begins.
+// The state directory is private, rejects symlinks in every path component,
+// and is locked exclusively for the lifetime of this control plane. Journal
+// definitions are encrypted with the externally supplied DAE_HOT_STATE_KEY
+// (64 hexadecimal characters); the key is never written to the state directory.
+func (c *ControlPlane) EnableHotInventory(stateDir string) (retErr error) {
+	if c.hotInventory.Load() != nil {
+		return errors.New("hot inventory already enabled")
+	}
+	if c.hotDialerOption != nil && c.hotDialerOption.AllowInsecure {
+		return fmt.Errorf("%w: hot inventory requires TLS verification in runtime defaults", outbound.ErrHotInventoryInvalid)
+	}
+	aead, err := hotStateCipher()
+	if err != nil {
+		return err
+	}
+	root, err := openHotStateDir(stateDir)
+	if err != nil {
+		return err
+	}
+	runtime := &hotProviderRuntime{providers: make(map[string]HotProviderRequest), revisions: make(map[string]map[string]string), handles: make(map[string]uint8), operations: make(map[string]HotOperationReceipt), stateDir: root, aead: aead}
+	defer func() {
+		if retErr != nil {
+			_ = runtime.close()
+		}
+	}()
+	entries := make(map[uint8]outbound.HotInventoryEntry)
+	for i, group := range c.outbounds {
+		if i < int(consts.OutboundUserDefinedMin) {
+			continue
+		}
+		if i > int(consts.OutboundUserDefinedMax) || group == nil || group.Name == "" {
+			return errors.New("invalid configured hot outbound handle")
+		}
+		for _, candidate := range group.Dialers {
+			if candidate != nil && candidate.GlobalOption != nil && candidate.AllowInsecure {
+				return fmt.Errorf("%w: hot inventory requires TLS verification in configured outbound options", outbound.ErrHotInventoryInvalid)
+			}
+		}
+		if _, exists := runtime.handles[group.Name]; exists {
+			return errors.New("duplicate configured hot outbound name")
+		}
+		runtime.handles[group.Name] = uint8(i)
+		entries[uint8(i)] = outbound.HotInventoryEntry{Handle: uint8(i), Identity: "baseline", Group: group, Borrowed: true}
+	}
+	if len(entries) == 0 {
+		return errors.New("hot inventory requires a configured user outbound")
+	}
+	generation := uint64(1)
+	state, exists, err := runtime.readState()
+	if err != nil {
+		return err
+	}
+	var prepared []outbound.HotInventoryEntry
+	defer func() {
+		if retErr != nil {
+			closeHotPrepared(prepared)
+		}
+	}()
+	if exists {
+		if state.Version != 1 || state.Generation == 0 || !equalHotHandles(state.Handles, runtime.handles) {
+			return errors.New("hot inventory state does not match configured policy handles")
+		}
+		generation = state.Generation
+		if err := validateHotRevisionHistory(state); err != nil {
+			return err
+		}
+		runtime.revisions = cloneHotRevisionHistory(state.Revisions)
+		if err := validateHotGroupOverrides(state); err != nil {
+			return err
+		}
+		runtime.groupOverrides = cloneHotGroupOverrides(state.GroupOverrides)
+		runtime.operations = cloneHotOperationReceipts(state.Operations)
+		if err := validateHotOperationReceipts(runtime.operations, state.Generation); err != nil {
+			return err
+		}
+		ids := make([]string, 0, len(state.Providers))
+		for id := range state.Providers {
+			ids = append(ids, id)
+		}
+		sort.Strings(ids)
+		for _, id := range ids {
+			req := state.Providers[id]
+			if id != req.ProviderID {
+				return errors.New("invalid hot inventory provider state")
+			}
+			if err := runtime.validateRequest(req); err != nil {
+				return fmt.Errorf("invalid stored hot provider: %w", err)
+			}
+			next, err := c.prepareHotProvider(context.Background(), runtime, effectiveHotProvider(req, runtime.groupOverrides), nil)
+			if err != nil {
+				return err
+			}
+			prepared = append(prepared, next...)
+			for _, entry := range next {
+				entries[entry.Handle] = entry
+			}
+			runtime.providers[id] = cloneHotRequest(req)
+		}
+	}
+	initial := make([]outbound.HotInventoryEntry, 0, len(entries))
+	for _, entry := range entries {
+		initial = append(initial, entry)
+	}
+	runtime.inventory, err = outbound.NewHotInventoryAtGeneration(initial, 8, generation)
+	if err != nil {
+		return err
+	}
+	prepared = nil // Ownership has transferred to the native inventory.
+	if !c.hotInventory.CompareAndSwap(nil, runtime) {
+		return errors.New("hot inventory already enabled")
+	}
+	var managedHandles []uint8
+	for _, entry := range initial {
+		if !entry.Borrowed {
+			managedHandles = append(managedHandles, entry.Handle)
+		}
+	}
+	if err := c.publishHotOutboundConnectivity(managedHandles); err != nil {
+		runtime.mu.Lock()
+		c.fenceHotOutcome(runtime, ErrHotInventoryDatapathOutcomeUnknown)
+		runtime.mu.Unlock()
+		return ErrHotInventoryDatapathOutcomeUnknown
+	}
+	return nil
+}
+
+func (c *ControlPlane) acquireHotOutbound(handle uint8) (*outbound.HotInventoryLease, bool, error) {
+	if handle < uint8(consts.OutboundUserDefinedMin) || handle > uint8(consts.OutboundUserDefinedMax) {
+		return nil, false, nil
+	}
+	runtime := c.hotInventory.Load()
+	if runtime == nil {
+		return nil, false, nil
+	}
+	return runtime.inventory.AcquireManaged(handle)
+}
+
+func (c *ControlPlane) HotInventorySnapshot() (outbound.HotInventorySnapshot, error) {
+	runtime := c.hotInventory.Load()
+	if runtime == nil {
+		return outbound.HotInventorySnapshot{}, errors.New("hot inventory is disabled")
+	}
+	runtime.mu.Lock()
+	defer runtime.mu.Unlock()
+	if runtime.closed {
+		return outbound.HotInventorySnapshot{}, outbound.ErrHotInventoryClosed
+	}
+	return runtime.inventory.Snapshot(), nil
+}
+
+// PublishHotProvider prepares native dialers and groups, commits their exact
+// restart representation, then atomically replaces only this provider's groups.
+// No subscription download, policy compilation, daemon reload or kernel attach
+// occurs here. Parse failures never return secret connection URLs.
+func (c *ControlPlane) PublishHotProvider(ctx context.Context, req HotProviderRequest) (outbound.HotInventoryPublication, error) {
+	runtime := c.hotInventory.Load()
+	if runtime == nil {
+		return outbound.HotInventoryPublication{}, errors.New("hot inventory is disabled")
+	}
+	runtime.mu.Lock()
+	defer runtime.mu.Unlock()
+	return c.publishHotProviderLocked(ctx, runtime, req)
+}
+
+func (c *ControlPlane) publishHotProviderLocked(ctx context.Context, runtime *hotProviderRuntime, req HotProviderRequest) (outbound.HotInventoryPublication, error) {
+	if runtime.closed {
+		return outbound.HotInventoryPublication{}, outbound.ErrHotInventoryClosed
+	}
+	before := runtime.inventory.Snapshot()
+	if req.ExpectedGeneration != before.Generation {
+		return outbound.HotInventoryPublication{}, outbound.ErrHotInventoryConflict
+	}
+	if err := ctx.Err(); err != nil {
+		return outbound.HotInventoryPublication{}, err
+	}
+	req = cloneHotRequest(req)
+	if err := runtime.validateRequest(req); err != nil {
+		return outbound.HotInventoryPublication{}, err
+	}
+	digest := hotRevisionDigest(req)
+	history := runtime.revisions[req.ProviderID]
+	if previous, known := history[req.RevisionID]; known {
+		if previous != digest {
+			return outbound.HotInventoryPublication{}, fmt.Errorf("%w: provider revision identity was reused with different content", outbound.ErrHotInventoryConflict)
+		}
+	} else if len(history) >= hotMaxRevisions {
+		return outbound.HotInventoryPublication{}, fmt.Errorf("%w: provider revision history limit reached", outbound.ErrHotInventoryBusy)
+	}
+	if old, ok := runtime.providers[req.ProviderID]; ok && old.RevisionID == req.RevisionID {
+		if !sameHotRevision(old, req) {
+			return outbound.HotInventoryPublication{}, errors.New("hot provider revision identity was reused with different content")
+		}
+		return outbound.HotInventoryPublication{Snapshot: before}, nil
+	}
+	selected := make(map[string]string, len(before.Groups))
+	for _, group := range before.Groups {
+		selected[group.Name] = group.Selection
+	}
+	entries, err := c.prepareHotProvider(ctx, runtime, req, selected)
+	if err != nil {
+		return outbound.HotInventoryPublication{}, err
+	}
+	adopted := false
+	defer func() {
+		if !adopted {
+			closeHotPrepared(entries)
+		}
+	}()
+	providers := cloneHotProviders(runtime.providers)
+	providers[req.ProviderID] = req
+	revisions := cloneHotRevisionHistory(runtime.revisions)
+	if revisions[req.ProviderID] == nil {
+		revisions[req.ProviderID] = make(map[string]string)
+	}
+	revisions[req.ProviderID][req.RevisionID] = digest
+	overrides := cloneHotGroupOverrides(runtime.groupOverrides)
+	for name, override := range overrides {
+		if override.ProviderID == req.ProviderID {
+			delete(overrides, name)
+		}
+	}
+	publication, err := runtime.inventory.Publish(ctx, req.ExpectedGeneration, entries, func(ctx context.Context, snapshot outbound.HotInventorySnapshot) error {
+		return runtime.writeState(ctx, runtime.hotStateForSnapshot(providers, revisions, overrides, snapshot))
+	})
+	if err != nil {
+		c.fenceHotOutcome(runtime, err)
+		return outbound.HotInventoryPublication{}, err
+	}
+	adopted = true
+	runtime.providers = providers
+	runtime.revisions = revisions
+	if err := c.publishHotOutboundConnectivity(publication.Adopted); err != nil {
+		c.fenceHotOutcome(runtime, ErrHotInventoryDatapathOutcomeUnknown)
+		return publication, ErrHotInventoryDatapathOutcomeUnknown
+	}
+	return publication, nil
+}
+
+// SetHotSelection changes the stable candidate for one managed group and
+// commits the selected identity before it becomes visible to new flows.
+func (c *ControlPlane) SetHotSelection(ctx context.Context, expected uint64, handle uint8, candidateID string) (outbound.HotInventoryPublication, error) {
+	runtime := c.hotInventory.Load()
+	if runtime == nil {
+		return outbound.HotInventoryPublication{}, errors.New("hot inventory is disabled")
+	}
+	runtime.mu.Lock()
+	defer runtime.mu.Unlock()
+	return c.setHotSelectionLocked(ctx, runtime, expected, handle, candidateID)
+}
+
+func (c *ControlPlane) setHotSelectionLocked(ctx context.Context, runtime *hotProviderRuntime, expected uint64, handle uint8, candidateID string) (outbound.HotInventoryPublication, error) {
+	if runtime.closed {
+		return outbound.HotInventoryPublication{}, outbound.ErrHotInventoryClosed
+	}
+	providers := cloneHotProviders(runtime.providers)
+	publication, err := runtime.inventory.SetSelection(ctx, expected, handle, candidateID, func(ctx context.Context, snapshot outbound.HotInventorySnapshot) error {
+		return runtime.writeState(ctx, runtime.hotStateForSnapshot(providers, runtime.revisions, nil, snapshot))
+	})
+	if err == nil {
+		runtime.providers = providers
+	} else {
+		c.fenceHotOutcome(runtime, err)
+	}
+	return publication, err
+}
+
+// ErrHotInventoryStorageOutcomeUnknown means an atomic rename occurred but
+// neither its directory sync nor durable rollback completed. New flow admission
+// is fenced, mutations are stopped, and restart must read the journal.
+var ErrHotInventoryStorageOutcomeUnknown = errors.New("hot inventory storage outcome unknown; restart and readback required")
+
+// ErrHotInventoryDatapathOutcomeUnknown means a revision is durable, but its
+// stable kernel admission slots could not be confirmed. The runtime is fenced
+// and recovery requires restart and readback of the accepted journal.
+var ErrHotInventoryDatapathOutcomeUnknown = errors.New("hot inventory datapath outcome unknown; restart and readback required")
+
+func (c *ControlPlane) fenceHotOutcome(r *hotProviderRuntime, err error) {
+	if !errors.Is(err, ErrHotInventoryStorageOutcomeUnknown) && !errors.Is(err, ErrHotInventoryDatapathOutcomeUnknown) {
+		return
+	}
+	r.closed = true
+	_ = r.inventory.Close()
+	_ = r.stateDir.Close()
+	c.rejectNewConnections.Store(true)
+	if c.cancel != nil {
+		c.cancel()
+	}
+}
+
+func (r *hotProviderRuntime) validateRequest(req HotProviderRequest) error {
+	invalid := func(message string) error { return fmt.Errorf("%w: %s", outbound.ErrHotInventoryInvalid, message) }
+	if !hotToken(req.ProviderID) || !hotToken(req.RevisionID) || len(req.Nodes) == 0 || len(req.Nodes) > hotMaxNodes || len(req.Groups) == 0 || len(req.Groups) > len(r.handles) {
+		return invalid("invalid provider, revision, or inventory size")
+	}
+	nodes := make(map[string]bool, len(req.Nodes))
+	referenced := make(map[string]bool)
+	total := 0
+	for _, node := range req.Nodes {
+		total += len(node.Link)
+		if !hotToken(node.ID) || nodes[node.ID] || len(node.Link) == 0 || len(node.Link) > hotMaxLinkBytes || total > 8<<20 {
+			return invalid("invalid node identity or connection definition size")
+		}
+		nodes[node.ID] = true
+	}
+	names := make(map[string]bool, len(req.Groups))
+	candidateCount := 0
+	for _, group := range req.Groups {
+		candidateCount += len(group.CandidateIDs)
+		if candidateCount > hotMaxNodes {
+			return invalid("total native candidate count exceeds limit")
+		}
+		if _, ok := r.handles[group.Name]; !ok || names[group.Name] || len(group.CandidateIDs) == 0 || len(group.CandidateIDs) > hotMaxNodes {
+			return invalid("unknown group, duplicate group or invalid membership size")
+		}
+		names[group.Name] = true
+		seen := make(map[string]bool, len(group.CandidateIDs))
+		for _, id := range group.CandidateIDs {
+			if !nodes[id] || seen[id] {
+				return invalid("unknown or duplicate candidate")
+			}
+			seen[id] = true
+			referenced[id] = true
+		}
+		if group.Selection != "" && !seen[group.Selection] {
+			return invalid("selected candidate is absent")
+		}
+	}
+	if len(referenced) != len(nodes) {
+		return invalid("unreferenced provider node")
+	}
+	for id, provider := range r.providers {
+		for _, group := range provider.Groups {
+			if id == req.ProviderID && !names[group.Name] {
+				return invalid("provider publication omitted an owned group")
+			}
+			if id != req.ProviderID && names[group.Name] {
+				return invalid("a managed group may contain only one provider")
+			}
+		}
+	}
+	return nil
+}
+
+func (c *ControlPlane) prepareHotProvider(ctx context.Context, runtime *hotProviderRuntime, req HotProviderRequest, selected map[string]string) (entries []outbound.HotInventoryEntry, retErr error) {
+	links := make(map[string]string, len(req.Nodes))
+	for _, node := range req.Nodes {
+		links[node.ID] = node.Link
+	}
+	defer func() {
+		if retErr != nil {
+			closeHotPrepared(entries)
+		}
+	}()
+	nativeCtx := c.ctx
+	if nativeCtx == nil {
+		nativeCtx = context.Background()
+	}
+	for _, spec := range req.Groups {
+		if err := ctx.Err(); err != nil {
+			return entries, err
+		}
+		handle := runtime.handles[spec.Name]
+		source := c.hotDialerOption
+		if baseline := c.outbounds[handle]; len(baseline.Dialers) > 0 {
+			source = baseline.Dialers[0].GlobalOption
+		}
+		if source == nil || source.Log == nil {
+			return entries, errors.New("hot dialer runtime options are unavailable")
+		}
+		if source.AllowInsecure {
+			return entries, fmt.Errorf("%w: hot inventory requires TLS verification in native dialer options", outbound.ErrHotInventoryInvalid)
+		}
+		choice := spec.Selection
+		for _, id := range spec.CandidateIDs {
+			if id == selected[spec.Name] {
+				choice = id
+			}
+		}
+		if choice == "" {
+			return entries, fmt.Errorf("%w: selected candidate disappeared; explicit replacement required", outbound.ErrHotInventoryInvalid)
+		}
+		found := false
+		for _, id := range spec.CandidateIDs {
+			if id == choice {
+				found = true
+			}
+		}
+		if !found {
+			return entries, fmt.Errorf("%w: selected candidate disappeared; explicit replacement required", outbound.ErrHotInventoryInvalid)
+		}
+		entry := outbound.HotInventoryEntry{Handle: handle, Identity: req.ProviderID + "/" + req.RevisionID, GroupRevision: spec.Revision, Selection: choice}
+		var native []*dialer.Dialer
+		var annotations []*dialer.Annotation
+		fixed := 0
+		for i, id := range spec.CandidateIDs {
+			scheme, _, _ := strings.Cut(links[id], ":")
+			if strings.EqualFold(scheme, "direct") || strings.EqualFold(scheme, "block") {
+				for _, built := range native {
+					_ = built.Close()
+					dialer.CleanupTransportCacheNamespace(built.TransportCacheNamespace)
+				}
+				return entries, fmt.Errorf("%w: provider candidates must be proxy connections", outbound.ErrHotInventoryInvalid)
+			}
+			option := source.CloneForHot()
+			d, err := dialer.NewFromLinkContext(nativeCtx, option, dialer.InstanceOption{DisableCheck: true}, links[id], req.ProviderID)
+			if err != nil {
+				dialer.CleanupTransportCacheNamespace(option.TransportCacheNamespace)
+				for _, built := range native {
+					_ = built.Close()
+					dialer.CleanupTransportCacheNamespace(built.TransportCacheNamespace)
+				}
+				return entries, fmt.Errorf("%w: invalid native connection definition for candidate %q", outbound.ErrHotInventoryInvalid, id)
+			}
+			native = append(native, d)
+			annotations = append(annotations, &dialer.Annotation{})
+			entry.Candidates = append(entry.Candidates, outbound.HotInventoryCandidate{ID: id, Dialer: d})
+			if id == choice {
+				fixed = i
+			}
+		}
+		entry.Group = outbound.NewDialerGroup(native[0].GlobalOption, spec.Name, native, annotations, outbound.DialerSelectionPolicy{Policy: consts.DialerSelectionPolicy_Fixed, FixedIndex: fixed}, func(bool, *dialer.NetworkType, bool) {})
+		entries = append(entries, entry)
+	}
+	return entries, nil
+}
+
+func closeHotPrepared(entries []outbound.HotInventoryEntry) {
+	seen := make(map[*dialer.Dialer]bool)
+	for _, entry := range entries {
+		if entry.Borrowed {
+			continue
+		}
+		if entry.Group != nil {
+			_ = entry.Group.Close()
+		}
+		for _, candidate := range entry.Candidates {
+			d := candidate.Dialer
+			if d != nil && !seen[d] {
+				seen[d] = true
+				_ = d.Close()
+				dialer.CleanupTransportCacheNamespace(d.TransportCacheNamespace)
+			}
+		}
+	}
+}
+
+func (c *ControlPlane) closeHotInventory() error {
+	runtime := c.hotInventory.Load()
+	if runtime == nil {
+		return nil
+	}
+	// Keep the pointer installed so admission after Close cannot fall through
+	// to baseline resources that may already be retiring.
+	return runtime.close()
+}
+
+func (r *hotProviderRuntime) close() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return nil
+	}
+	r.closed = true
+	var errs []error
+	if r.inventory != nil {
+		errs = append(errs, r.inventory.Close())
+	}
+	if r.stateDir != nil {
+		errs = append(errs, r.stateDir.Close())
+	}
+	return errors.Join(errs...)
+}
+
+func hotToken(value string) bool {
+	if len(value) == 0 || len(value) > 256 {
+		return false
+	}
+	for _, c := range value {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || strings.ContainsRune("._:-", c)) {
+			return false
+		}
+	}
+	return true
+}
+
+func cloneHotRequest(req HotProviderRequest) HotProviderRequest {
+	req.Nodes = append([]HotProviderNode(nil), req.Nodes...)
+	req.Groups = append([]HotProviderGroup(nil), req.Groups...)
+	for i := range req.Groups {
+		req.Groups[i].CandidateIDs = append([]string(nil), req.Groups[i].CandidateIDs...)
+	}
+	return req
+}
+func cloneHotProviders(providers map[string]HotProviderRequest) map[string]HotProviderRequest {
+	cloned := make(map[string]HotProviderRequest, len(providers))
+	for id, req := range providers {
+		cloned[id] = cloneHotRequest(req)
+	}
+	return cloned
+}
+func sameHotRevision(a, b HotProviderRequest) bool {
+	return hotRevisionDigest(a) == hotRevisionDigest(b)
+}
+
+func hotRevisionDigest(req HotProviderRequest) string {
+	req = cloneHotRequest(req)
+	req.ExpectedGeneration = 0
+	for i := range req.Groups {
+		req.Groups[i].Selection = ""
+	}
+	raw, _ := json.Marshal(req)
+	defer clear(raw)
+	digest := sha256.Sum256(raw)
+	return hex.EncodeToString(digest[:])
+}
+
+func cloneHotRevisionHistory(history map[string]map[string]string) map[string]map[string]string {
+	result := make(map[string]map[string]string, len(history))
+	for provider, revisions := range history {
+		result[provider] = make(map[string]string, len(revisions))
+		for revision, digest := range revisions {
+			result[provider][revision] = digest
+		}
+	}
+	return result
+}
+
+func validateHotRevisionHistory(state hotDurableState) error {
+	if len(state.Revisions) != len(state.Providers) {
+		return errors.New("hot inventory revision history does not match provider state")
+	}
+	for id, provider := range state.Providers {
+		revisions := state.Revisions[id]
+		if len(revisions) == 0 || len(revisions) > hotMaxRevisions || revisions[provider.RevisionID] != hotRevisionDigest(provider) {
+			return errors.New("invalid hot inventory revision history")
+		}
+		for revision, digest := range revisions {
+			decoded, err := hex.DecodeString(digest)
+			if !hotToken(revision) || err != nil || len(decoded) != sha256.Size {
+				return errors.New("invalid hot inventory revision identity")
+			}
+		}
+	}
+	return nil
+}
+
+func syncHotSelections(providers map[string]HotProviderRequest, snapshot outbound.HotInventorySnapshot) {
+	choices := make(map[string]string, len(snapshot.Groups))
+	for _, group := range snapshot.Groups {
+		choices[group.Name] = group.Selection
+	}
+	for id, req := range providers {
+		for i := range req.Groups {
+			req.Groups[i].Selection = choices[req.Groups[i].Name]
+		}
+		providers[id] = req
+	}
+}
+func equalHotHandles(a, b map[string]uint8) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for name, handle := range a {
+		other, ok := b[name]
+		if !ok || other != handle {
+			return false
+		}
+	}
+	return true
+}
+
+func openHotStateDir(path string) (*os.File, error) {
+	if path == "" {
+		return nil, errors.New("hot inventory state directory is required")
+	}
+	absolute, err := filepath.Abs(path)
+	if err != nil {
+		return nil, err
+	}
+	fd, err := unix.Open("/", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	for _, part := range strings.Split(strings.TrimPrefix(filepath.Clean(absolute), "/"), "/") {
+		if part == "" {
+			continue
+		}
+		next, e := unix.Openat(fd, part, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+		if errors.Is(e, unix.ENOENT) {
+			e = unix.Mkdirat(fd, part, 0700)
+			if e == nil {
+				e = unix.Fsync(fd)
+				if e == nil {
+					next, e = unix.Openat(fd, part, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+				}
+			}
+		}
+		_ = unix.Close(fd)
+		if e != nil {
+			return nil, fmt.Errorf("open hot inventory state directory: %w", e)
+		}
+		fd = next
+	}
+	root := os.NewFile(uintptr(fd), absolute)
+	info, err := root.Stat()
+	if err != nil {
+		root.Close()
+		return nil, err
+	}
+	if info.Mode().Perm()&0077 != 0 {
+		root.Close()
+		return nil, errors.New("hot inventory state directory must have private permissions")
+	}
+	if err = unix.Flock(fd, unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		root.Close()
+		return nil, errors.New("hot inventory state directory is already in use or cannot be locked")
+	}
+	return root, nil
+}
+
+func (r *hotProviderRuntime) readState() (hotDurableState, bool, error) {
+	var state hotDurableState
+	fd, err := unix.Openat(int(r.stateDir.Fd()), hotStateFile, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if errors.Is(err, unix.ENOENT) {
+		return state, false, nil
+	}
+	if err != nil {
+		return state, false, errors.New("cannot open hot inventory state")
+	}
+	file := os.NewFile(uintptr(fd), hotStateFile)
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0077 != 0 || info.Size() > hotMaxEnvelopeBytes {
+		return state, false, errors.New("invalid hot inventory state file")
+	}
+	raw, err := io.ReadAll(io.LimitReader(file, hotMaxEnvelopeBytes+1))
+	if err != nil || len(raw) > hotMaxEnvelopeBytes {
+		return state, false, errors.New("cannot read hot inventory state")
+	}
+	var envelope hotStateEnvelope
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	if err = decoder.Decode(&envelope); err != nil {
+		return state, false, errors.New("corrupt encrypted hot inventory state")
+	}
+	var extra any
+	if decoder.Decode(&extra) != io.EOF || envelope.Version != 1 || r.aead == nil || len(envelope.Nonce) != r.aead.NonceSize() || len(envelope.Ciphertext) > hotMaxStateBytes+r.aead.Overhead() {
+		return state, false, errors.New("invalid encrypted hot inventory state")
+	}
+	plaintext, err := r.aead.Open(nil, envelope.Nonce, envelope.Ciphertext, []byte(hotStateAAD))
+	if err != nil {
+		return state, false, errors.New("hot inventory state authentication failed")
+	}
+	defer clear(plaintext)
+	if len(plaintext) > hotMaxStateBytes {
+		return state, false, errors.New("hot inventory plaintext exceeds storage limit")
+	}
+	decoder = json.NewDecoder(bytes.NewReader(plaintext))
+	decoder.DisallowUnknownFields()
+	if err = decoder.Decode(&state); err != nil {
+		return state, false, errors.New("corrupt hot inventory state")
+	}
+	if decoder.Decode(&extra) != io.EOF {
+		return state, false, errors.New("trailing hot inventory state data")
+	}
+	return state, true, nil
+}
+
+func (r *hotProviderRuntime) syncDirectory() error {
+	if r.syncDir != nil {
+		return r.syncDir()
+	}
+	return r.stateDir.Sync()
+}
+
+func (r *hotProviderRuntime) writeState(ctx context.Context, state hotDurableState) error {
+	if state.GroupOverrides == nil {
+		state.GroupOverrides = cloneHotGroupOverrides(r.groupOverrides)
+	}
+	if state.Operations == nil {
+		state.Operations = cloneHotOperationReceipts(r.operations)
+	}
+	if pending := r.pendingOperation; pending != nil {
+		receipt := pending.Receipt
+		receipt.Generation = state.Generation
+		identity, err := parseHotOperationID(receipt.OperationID)
+		if err != nil {
+			return err
+		}
+		state.Operations[identity.Client] = receipt
+	}
+	plaintext, err := json.Marshal(state)
+	if err != nil || len(plaintext) > hotMaxStateBytes {
+		return errors.New("hot inventory state exceeds storage limit")
+	}
+	defer clear(plaintext)
+	if r.aead == nil {
+		return errors.New("hot inventory state encryption is unavailable")
+	}
+	nonce := make([]byte, r.aead.NonceSize())
+	if _, err = rand.Read(nonce); err != nil {
+		return errors.New("cannot generate hot inventory state nonce")
+	}
+	envelope := hotStateEnvelope{Version: 1, Nonce: nonce, Ciphertext: r.aead.Seal(nil, nonce, plaintext, []byte(hotStateAAD))}
+	raw, err := json.Marshal(envelope)
+	if err != nil || len(raw) > hotMaxEnvelopeBytes {
+		return errors.New("encrypted hot inventory state exceeds storage limit")
+	}
+	if err = ctx.Err(); err != nil {
+		return err
+	}
+	dirfd := int(r.stateDir.Fd())
+	var stat unix.Stat_t
+	if err = unix.Fstatat(dirfd, hotStateFile, &stat, unix.AT_SYMLINK_NOFOLLOW); err == nil {
+		if stat.Mode&unix.S_IFMT != unix.S_IFREG || stat.Mode&0077 != 0 {
+			return errors.New("invalid hot inventory state destination")
+		}
+	} else if !errors.Is(err, unix.ENOENT) {
+		return errors.New("cannot inspect hot inventory state destination")
+	}
+	token := make([]byte, 16)
+	if _, err = rand.Read(token); err != nil {
+		return err
+	}
+	name := ".inventory-" + hex.EncodeToString(token)
+	fd, err := unix.Openat(dirfd, name, unix.O_WRONLY|unix.O_CREAT|unix.O_EXCL|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0600)
+	if err != nil {
+		return errors.New("cannot create hot inventory state transaction")
+	}
+	file := os.NewFile(uintptr(fd), name)
+	defer func() { _ = file.Close(); _ = unix.Unlinkat(dirfd, name, 0) }()
+	if _, err = file.Write(raw); err != nil {
+		return errors.New("cannot write hot inventory state")
+	}
+	if err = file.Sync(); err != nil {
+		return errors.New("cannot sync hot inventory state")
+	}
+	if err = file.Close(); err != nil {
+		return errors.New("cannot close hot inventory state")
+	}
+	if err = ctx.Err(); err != nil {
+		return err
+	}
+	// Keep the old journal under a private backup name until replacement is
+	// durably acknowledged. This lets a failed directory sync restore the old
+	// authority; if the restore cannot be synced either, admission is fenced.
+	backup := name + ".previous"
+	hasPrevious := false
+	if err = unix.Linkat(dirfd, hotStateFile, dirfd, backup, 0); err == nil {
+		hasPrevious = true
+	} else if !errors.Is(err, unix.ENOENT) {
+		return errors.New("cannot preserve previous hot inventory state")
+	}
+	keepBackup := false
+	defer func() {
+		if !keepBackup {
+			_ = unix.Unlinkat(dirfd, backup, 0)
+		}
+	}()
+	if err = r.syncDirectory(); err != nil {
+		return errors.New("cannot sync hot inventory transaction directory")
+	}
+	if err = unix.Renameat(dirfd, name, dirfd, hotStateFile); err != nil {
+		return errors.New("cannot commit hot inventory state")
+	}
+	if err = r.syncDirectory(); err != nil {
+		var rollbackErr error
+		if hasPrevious {
+			rollbackErr = unix.Renameat(dirfd, backup, dirfd, hotStateFile)
+		} else {
+			rollbackErr = unix.Unlinkat(dirfd, hotStateFile, 0)
+		}
+		if rollbackErr == nil {
+			rollbackErr = r.syncDirectory()
+		}
+		if rollbackErr != nil {
+			keepBackup = true
+			return ErrHotInventoryStorageOutcomeUnknown
+		}
+		return errors.New("hot inventory directory sync failed; previous state restored")
+	}
+	r.operations = cloneHotOperationReceipts(state.Operations)
+	r.groupOverrides = cloneHotGroupOverrides(state.GroupOverrides)
+	return nil
+}
