+func (d *hotInventoryTestTransport) DialContext(context.Context, string, string) (netproxy.Conn, error) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.closed.Load() != 0 {
+		return nil, net.ErrClosed
+	}
+	left, right := net.Pipe()
+	d.conns = append(d.conns, left, right)
+	go func() { _, _ = io.Copy(right, right) }()
+	return left, nil
+}
+
+func (d *hotInventoryTestTransport) Close() error {
+	d.closed.Add(1)
+	if d.closing != nil {
+		d.closing <- struct{}{}
+	}
+	if d.closeWait != nil {
+		<-d.closeWait
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	for _, conn := range d.conns {
+		_ = conn.Close()
+	}
+	return nil
+}
