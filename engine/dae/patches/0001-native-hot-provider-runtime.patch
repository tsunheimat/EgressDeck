+	commit := func(_ context.Context, snapshot HotInventorySnapshot) error {
+		commits++
+		if snapshot.Generation != 2 || snapshot.Groups[0].Selection != "chosen" {
+			t.Fatal("incorrect durable selection candidate", snapshot)
