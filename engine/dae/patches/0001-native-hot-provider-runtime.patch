+		return failure
+	}
+	if _, err := h.SetSelection(context.Background(), 0, 2, "chosen", commit); !errors.Is(err, ErrHotInventoryConflict) || commits != 0 {
+		t.Fatal("stale selection was accepted", err)
+	}
+	if _, err := h.SetSelection(context.Background(), 1, 2, "absent", commit); !errors.Is(err, ErrHotInventoryInvalid) || commits != 0 {
+		t.Fatal("unknown stable candidate was accepted", err)
+	}
+	if _, err := h.SetSelection(context.Background(), 1, 2, "chosen", commit); !errors.Is(err, failure) {
+		t.Fatal("failed selection commit was accepted", err)
+	}
+	if h.Snapshot().Generation != 1 || h.Snapshot().Groups[0].Selection != "node-0" {
+		t.Fatal("failed durable commit altered selection")
+	}
+	if _, err := h.SetSelection(context.Background(), 1, 2, "chosen", hotInventoryTestCommit); err != nil {
+		t.Fatal(err)
