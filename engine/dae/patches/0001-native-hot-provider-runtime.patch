+func TestHotProviderDurabilityFailureRollbackAndFence(t *testing.T) {
+	for _, unknown := range []bool{false, true} {
+		name := "verified_rollback"
+		if unknown {
+			name = "ambiguous_rollback"
+		}
+		t.Run(name, func(t *testing.T) {
+			stateDir := filepath.Join(t.TempDir(), "state")
+			cp := hotTestControlPlane(t, stateDir, "first")
+			req := hotTestRequest("p", "one", "first", 1, "socks5://127.0.0.1:1")
+			if _, err := cp.PublishHotProvider(context.Background(), req); err != nil {
+				t.Fatal(err)
+			}
+			before, err := os.ReadFile(filepath.Join(stateDir, hotStateFile))
+			if err != nil {
+				t.Fatal(err)
+			}
+			old := hotTestAcquire(t, cp, 2)
+			runtime := cp.hotInventory.Load()
+			syncCalls := 0
+			runtime.syncDir = func() error {
+				syncCalls++
+				if syncCalls == 2 || unknown && syncCalls == 3 {
+					return errors.New("injected directory sync fault")
+				}
+				return runtime.stateDir.Sync()
+			}
+			req.ExpectedGeneration = 2
+			req.RevisionID = "two"
+			_, err = cp.PublishHotProvider(context.Background(), req)
+			if err == nil {
+				t.Fatal("directory fsync failure acknowledged success")
+			}
+			after, readErr := os.ReadFile(filepath.Join(stateDir, hotStateFile))
+			if readErr != nil {
+				t.Fatal(readErr)
+			}
+			if !bytes.Equal(before, after) {
+				t.Fatal("rollback did not restore the old journal bytes")
+			}
+			if unknown {
+				if !errors.Is(err, ErrHotInventoryStorageOutcomeUnknown) || !cp.rejectNewConnections.Load() {
+					t.Fatalf("ambiguous fsync failed to fence: %v", err)
+				}
+				if lease, managed, err := cp.acquireHotOutbound(2); err == nil || lease != nil {
+					t.Fatalf("fenced hot inventory admitted: %v %v", managed, err)
+				}
+				if _, err := cp.HotInventorySnapshot(); !errors.Is(err, outbound.ErrHotInventoryClosed) {
+					t.Fatalf("fenced readback claimed current authoritative state: %v", err)
+				}
+			} else {
+				if errors.Is(err, ErrHotInventoryStorageOutcomeUnknown) || cp.rejectNewConnections.Load() {
+					t.Fatalf("verified rollback unexpectedly fenced: %v", err)
+				}
+				now := hotTestAcquire(t, cp, 2)
+				if now.Dialer != old.Dialer || now.Generation != 2 {
+					t.Fatal("failed durable commit changed native inventory")
+				}
+				runtime.syncDir = nil
+				if _, err := cp.PublishHotProvider(context.Background(), req); err != nil {
+					t.Fatalf("retry after verified rollback: %v", err)
+				}
+			}
+		})
+	}
+}
