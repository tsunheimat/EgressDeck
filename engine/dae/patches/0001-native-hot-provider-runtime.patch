+package cmd
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/daeuniverse/dae/component/outbound"
+	"github.com/daeuniverse/dae/control"
+	"golang.org/x/sys/unix"
+)
+
+const hotControlMaxBody = 1 << 20
+const hotReloadDisabledMessage = "full reload and suspend are disabled with hot inventory; stop dae before deploying a new routing policy"
+
+func validateHotControlFlags(stateDir, socket string) error {
+	if (stateDir == "") != (socket == "") {
+		return errors.New("--hot-state-dir and --hot-control-socket must be supplied together")
+	}
+	if stateDir != "" && (!filepath.IsAbs(stateDir) || filepath.Clean(stateDir) != stateDir || !filepath.IsAbs(socket) || filepath.Clean(socket) != socket) {
+		return errors.New("hot state and socket paths must be absolute clean paths")
+	}
+	return nil
+}
+
+// hotControlAPI is deliberately small: it is the only interface exposed by
+// the management socket, which keeps the HTTP layer independent of the
+// concrete control-plane implementation and makes malformed requests safe to
+// exercise in tests.
+type hotControlAPI interface {
+	EnableHotInventory(string) error
+	PublishHotProvider(context.Context, control.HotProviderRequest) (outbound.HotInventoryPublication, error)
+	SetHotSelection(context.Context, uint64, uint8, string) (outbound.HotInventoryPublication, error)
+	HotInventorySnapshot() (outbound.HotInventorySnapshot, error)
+	PublishHotProviderOperation(context.Context, string, control.HotProviderRequest) (outbound.HotInventoryPublication, error)
+	PublishHotGroupOperation(context.Context, string, control.HotGroupRequest) (outbound.HotInventoryPublication, error)
+	SetHotSelectionOperation(context.Context, string, uint64, uint8, string) (outbound.HotInventoryPublication, error)
+	HotOperationStatus(string) (control.HotOperationReceipt, error)
+}
+
+type hotControlServer struct {
+	server    *http.Server
+	listener  net.Listener
+	admission *hotControlAdmission
+	closeOnce sync.Once
+	closeErr  error
+}
+
+func (s *hotControlServer) Close() error {
+	if s == nil {
+		return nil
+	}
+	s.closeOnce.Do(func() {
+		if s.admission != nil {
+			s.admission.mu.Lock()
+			s.admission.closed = true
+			s.admission.mu.Unlock()
+		}
+		if s.server != nil {
+			s.closeErr = s.server.Close()
+		}
+		// Close the listener explicitly as well: Close can race with the
+		// serving goroutine before net/http has registered its listener.
+		if s.listener != nil {
+			if err := s.listener.Close(); err != nil && !errors.Is(err, net.ErrClosed) {
+				s.closeErr = errors.Join(s.closeErr, err)
+			}
+		}
+		if s.admission != nil {
+			s.admission.active.Wait()
+		}
+	})
+	return s.closeErr
+}
+
+// startHotControl creates the private local management socket and starts its
+// serving goroutine. stateDir is initialized by the control plane before this
+// function is called; retaining it here would permit accidental state writes
+// outside the control package.
+func startHotControl(api hotControlAPI, socket string) (*hotControlServer, error) {
+	if api == nil {
+		return nil, errors.New("hot control: nil control plane")
+	}
+	if !filepath.IsAbs(socket) || filepath.Clean(socket) != socket {
+		return nil, errors.New("hot control: socket must be an absolute clean path")
+	}
+	parent := filepath.Dir(socket)
+	if err := ensureHotPrivateDir(parent); err != nil {
+		return nil, err
+	}
+	if info, err := os.Lstat(socket); err == nil {
+		if info.Mode()&os.ModeSocket == 0 {
+			return nil, fmt.Errorf("hot control socket path is not a socket: %s", socket)
+		}
+		if err := ensureHotOwned(info, socket); err != nil {
+			return nil, err
+		}
+		conn, dialErr := net.DialTimeout("unix", socket, time.Second)
+		if dialErr == nil {
+			_ = conn.Close()
+			return nil, errors.New("hot control socket is already serving")
+		}
+		if !errors.Is(dialErr, syscall.ECONNREFUSED) && !errors.Is(dialErr, os.ErrNotExist) {
+			return nil, errors.New("hot control socket could not be verified as stale")
+		}
+		if err := os.Remove(socket); err != nil {
+			return nil, fmt.Errorf("remove stale hot control socket: %w", err)
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return nil, fmt.Errorf("inspect hot control socket: %w", err)
+	}
+
+	listener, err := net.Listen("unix", socket)
+	if err != nil {
+		return nil, fmt.Errorf("listen hot control socket: %w", err)
+	}
+	cleanup := func(e error) (*hotControlServer, error) {
+		_ = listener.Close()
+		_ = os.Remove(socket)
+		return nil, e
+	}
+	if err := os.Chmod(socket, 0o600); err != nil {
+		return cleanup(fmt.Errorf("chmod hot control socket: %w", err))
+	}
+	if info, err := os.Stat(socket); err != nil {
+		return cleanup(fmt.Errorf("stat hot control socket: %w", err))
+	} else if err := ensureHotOwned(info, socket); err != nil {
+		return cleanup(err)
+	}
+
+	h := &hotControlAdmission{handler: newHotControlHandler(api)}
+	server := &http.Server{
+		Handler:           h,
+		ReadHeaderTimeout: 5 * time.Second,
+		ReadTimeout:       30 * time.Second,
+		WriteTimeout:      30 * time.Second,
+		IdleTimeout:       30 * time.Second,
+		MaxHeaderBytes:    8 << 10,
+		ConnContext: func(ctx context.Context, conn net.Conn) context.Context {
+			uid := uint32(^uint32(0))
+			if uc, ok := conn.(*net.UnixConn); ok {
+				uid = hotPeerUID(uc)
+			}
+			return context.WithValue(ctx, hotPeerUIDKey{}, uid)
+		},
+	}
+	s := &hotControlServer{server: server, listener: listener, admission: h}
+	go func() { _ = server.Serve(listener) }()
+	return s, nil
+}
+
+type hotPeerUIDKey struct{}
+
+// Closing HTTP connections cancels request contexts but does not itself wait
+// for handler completion. Keep control-plane teardown behind the last handler
+// so an in-progress durable commit cannot race with datapath destruction.
+type hotControlAdmission struct {
+	mu      sync.Mutex
+	closed  bool
+	active  sync.WaitGroup
+	handler http.Handler
+}
+
+func (a *hotControlAdmission) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	a.mu.Lock()
+	if a.closed {
+		a.mu.Unlock()
+		writeHotError(w, http.StatusServiceUnavailable, "inventory_closed", "inventory_closed")
+		return
+	}
+	a.active.Add(1)
+	a.mu.Unlock()
+	defer a.active.Done()
+	a.handler.ServeHTTP(w, r)
+}
+
+func hotPeerUID(conn *net.UnixConn) uint32 {
+	var uid uint32 = ^uint32(0)
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return uid
+	}
+	_ = raw.Control(func(fd uintptr) {
+		cred, err := unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+		if err == nil && cred != nil {
+			uid = cred.Uid
+		}
+	})
+	return uid
+}
+
+func ensureHotPrivateDir(path string) error {
+	for component := path; ; component = filepath.Dir(component) {
+		info, err := os.Lstat(component)
+		if err == nil {
+			if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+				return errors.New("hot control directory path must not contain symlinks")
+			}
+		} else if !errors.Is(err, os.ErrNotExist) {
+			return fmt.Errorf("inspect hot control directory path: %w", err)
+		}
+		if component == filepath.Dir(component) {
+			break
+		}
+	}
+	if err := os.MkdirAll(path, 0o700); err != nil {
+		return fmt.Errorf("create hot control directory: %w", err)
+	}
+	info, err := os.Lstat(path)
+	if err != nil {
+		return fmt.Errorf("stat hot control directory: %w", err)
+	}
+	if !info.IsDir() || info.Mode().Perm() != 0o700 {
+		return errors.New("hot control socket directory must be a private directory with mode 0700")
+	}
+	return ensureHotOwned(info, path)
+}
+
+func ensureHotOwned(info os.FileInfo, path string) error {
+	if info == nil {
+		return fmt.Errorf("hot control path has no metadata: %s", path)
+	}
+	st, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return fmt.Errorf("hot control path ownership unavailable: %s", path)
+	}
+	if st.Uid != uint32(os.Geteuid()) {
+		return fmt.Errorf("hot control path is not owned by the daemon uid: %s", path)
+	}
+	return nil
+}
+
+func newHotControlHandler(api hotControlAPI) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if uid, ok := r.Context().Value(hotPeerUIDKey{}).(uint32); !ok || uid != uint32(os.Geteuid()) {
+			writeHotError(w, http.StatusForbidden, "forbidden", "local peer is not the daemon user")
+			return
+		}
+		if r.URL.Path == "/v1/inventory" && r.Method == http.MethodGet {
+			snapshot, err := api.HotInventorySnapshot()
+			if err != nil {
+				writeHotMappedError(w, err)
+				return
+			}
+			writeHotJSON(w, http.StatusOK, snapshotResponse(snapshot))
+			return
+		}
+		if r.URL.Path == "/v1/providers/publish" && r.Method == http.MethodPost {
+			var req hotProviderOperationRequest
+			if err := decodeHotJSON(w, r, &req); err != nil {
+				writeHotError(w, http.StatusBadRequest, "invalid_request", err.Error())
+				return
+			}
+			if req.OperationID == "" {
+				writeHotError(w, http.StatusBadRequest, "invalid_request", "operation_id is required")
+				return
+			}
+			publication, err := api.PublishHotProviderOperation(r.Context(), req.OperationID, req.HotProviderRequest)
+			if err != nil {
+				writeHotMappedError(w, err)
+				return
+			}
+			writeHotJSON(w, http.StatusOK, publicationResponse(publication))
+			return
+		}
+		if r.URL.Path == "/v1/selection" && r.Method == http.MethodPost {
+			var req hotSelectionRequest
+			if err := decodeHotJSON(w, r, &req); err != nil {
+				writeHotError(w, http.StatusBadRequest, "invalid_request", err.Error())
+				return
+			}
+			if req.ExpectedGeneration == 0 || req.CandidateID == "" {
+				writeHotError(w, http.StatusBadRequest, "invalid_request", "positive expected generation and candidate ID are required")
+				return
+			}
+			if req.OperationID == "" {
+				writeHotError(w, http.StatusBadRequest, "invalid_request", "operation_id is required")
+				return
+			}
+			publication, err := api.SetHotSelectionOperation(r.Context(), req.OperationID, req.ExpectedGeneration, req.Handle, req.CandidateID)
+			if err != nil {
+				writeHotMappedError(w, err)
+				return
+			}
+			writeHotJSON(w, http.StatusOK, publicationResponse(publication))
+			return
+		}
+		if r.URL.Path == "/v1/groups/publish" && r.Method == http.MethodPost {
+			var req hotGroupOperationRequest
+			if err := decodeHotJSON(w, r, &req); err != nil {
+				writeHotError(w, http.StatusBadRequest, "invalid_request", err.Error())
+				return
+			}
+			if req.OperationID == "" {
+				writeHotError(w, http.StatusBadRequest, "invalid_request", "operation_id is required")
+				return
+			}
+			publication, err := api.PublishHotGroupOperation(r.Context(), req.OperationID, req.HotGroupRequest)
+			if err != nil {
+				writeHotMappedError(w, err)
+				return
+			}
+			writeHotJSON(w, http.StatusOK, publicationResponse(publication))
+			return
+		}
+		if strings.HasPrefix(r.URL.Path, "/v1/operations/") && r.Method == http.MethodGet {
+			id := strings.TrimPrefix(r.URL.Path, "/v1/operations/")
+			if id == "" || strings.Contains(id, "/") {
+				writeHotError(w, http.StatusBadRequest, "invalid_request", "invalid operation ID")
+				return
+			}
+			receipt, err := api.HotOperationStatus(id)
+			if err != nil {
+				writeHotMappedError(w, err)
+				return
+			}
+			writeHotJSON(w, http.StatusOK, receipt)
+			return
+		}
+		switch r.URL.Path {
+		case "/v1/inventory":
+			w.Header().Set("Allow", http.MethodGet)
+		case "/v1/providers/publish", "/v1/selection", "/v1/groups/publish":
+			w.Header().Set("Allow", http.MethodPost)
+		default:
+			writeHotError(w, http.StatusNotFound, "not_found", "unknown endpoint")
+			return
+		}
+		writeHotError(w, http.StatusMethodNotAllowed, "method_not_allowed", "unsupported method")
+	})
+}
+
+type hotProviderOperationRequest struct {
+	OperationID string `json:"operation_id"`
+	control.HotProviderRequest
+}
+
+type hotGroupOperationRequest struct {
+	OperationID string `json:"operation_id"`
+	control.HotGroupRequest
+}
+
+type hotSelectionRequest struct {
+	OperationID        string `json:"operation_id"`
+	ExpectedGeneration uint64 `json:"expected_generation"`
+	Handle             uint8  `json:"handle"`
+	CandidateID        string `json:"candidate_id"`
+}
+
+type hotSnapshotGroup struct {
+	Handle        uint8    `json:"handle"`
+	Name          string   `json:"name"`
+	Identity      string   `json:"identity"`
+	Selection     string   `json:"selection"`
+	GroupRevision uint64   `json:"group_revision,omitempty"`
+	CandidateIDs  []string `json:"candidate_ids,omitempty"`
+}
+type hotSnapshotResponse struct {
+	Generation uint64             `json:"generation"`
+	Groups     []hotSnapshotGroup `json:"groups"`
+}
+type hotPublicationResponse struct {
+	Snapshot       hotSnapshotResponse `json:"snapshot"`
+	Adopted        []int               `json:"adopted"`
+	CleanupPending bool                `json:"cleanup_pending"`
+}
+
+func snapshotResponse(s outbound.HotInventorySnapshot) hotSnapshotResponse {
+	groups := make([]hotSnapshotGroup, 0, len(s.Groups))
+	for _, g := range s.Groups {
+		groups = append(groups, hotSnapshotGroup{Handle: g.Handle, Name: g.Name, Identity: g.Identity, Selection: g.Selection, GroupRevision: g.GroupRevision, CandidateIDs: g.CandidateIDs})
+	}
+	return hotSnapshotResponse{Generation: s.Generation, Groups: groups}
+}
+func publicationResponse(p outbound.HotInventoryPublication) hotPublicationResponse {
+	adopted := make([]int, len(p.Adopted))
+	for i, handle := range p.Adopted {
+		adopted[i] = int(handle)
+	}
+	return hotPublicationResponse{Snapshot: snapshotResponse(p.Snapshot), Adopted: adopted, CleanupPending: p.CleanupError != nil}
+}
+
+func decodeHotJSON(w http.ResponseWriter, r *http.Request, dst any) error {
+	r.Body = http.MaxBytesReader(w, r.Body, hotControlMaxBody)
+	defer r.Body.Close()
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		return errors.New("request body exceeds limit or cannot be read")
+	}
+	if len(bytes.TrimSpace(body)) == 0 || bytes.TrimSpace(body)[0] != '{' {
+		return errors.New("request body must contain one JSON object")
+	}
+	dec := json.NewDecoder(bytes.NewReader(body))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(dst); err != nil {
+		return errors.New("request body contains invalid JSON or unknown fields")
+	}
+	var extra any
+	if err := dec.Decode(&extra); err == nil {
+		return errors.New("request body must contain one JSON object")
+	} else if !errors.Is(err, io.EOF) {
+		return errors.New("request body must contain one JSON object")
+	}
+	return nil
+}
+
+func writeHotJSON(w http.ResponseWriter, status int, value any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(value)
+}
+
+type hotErrorResponse struct {
+	Error hotErrorBody `json:"error"`
+}
+type hotErrorBody struct {
+	Code    string `json:"code"`
+	Message string `json:"message"`
+}
+
+func writeHotError(w http.ResponseWriter, status int, code, message string) {
+	writeHotJSON(w, status, hotErrorResponse{Error: hotErrorBody{Code: code, Message: message}})
+}
+
+func writeHotMappedError(w http.ResponseWriter, err error) {
+	code, status := "internal_error", http.StatusInternalServerError
+	switch {
+	case errors.Is(err, control.ErrHotOperationOutcomeUnknown):
+		writeHotError(w, http.StatusServiceUnavailable, "outcome_unknown", "operation receipt uncertain; restart and readback required")
+		return
+	case errors.Is(err, control.ErrHotOperationInvalid):
+		code, status = "invalid_request", http.StatusBadRequest
+	case errors.Is(err, control.ErrHotOperationConflict):
+		code, status = "operation_conflict", http.StatusConflict
+	case errors.Is(err, control.ErrHotOperationExpired):
+		code, status = "operation_expired", http.StatusConflict
+	case errors.Is(err, control.ErrHotOperationSequence):
+		code, status = "operation_sequence", http.StatusConflict
+	case errors.Is(err, control.ErrHotOperationLimit):
+		code, status = "operation_limit", http.StatusTooManyRequests
+	case errors.Is(err, control.ErrHotInventoryStorageOutcomeUnknown):
+		writeHotError(w, http.StatusServiceUnavailable, "outcome_unknown", "storage commit uncertain; native inventory fenced")
+		return
+	case errors.Is(err, control.ErrHotInventoryDatapathOutcomeUnknown):
+		writeHotError(w, http.StatusServiceUnavailable, "outcome_unknown", "kernel admission readback failed; native inventory fenced")
+		return
+	case errors.Is(err, outbound.ErrHotInventoryConflict):
+		code, status = "generation_conflict", http.StatusConflict
+	case errors.Is(err, outbound.ErrHotInventoryBusy):
+		code, status = "inventory_busy", http.StatusTooManyRequests
+	case errors.Is(err, outbound.ErrHotInventoryClosed):
+		code, status = "inventory_closed", http.StatusServiceUnavailable
+	case errors.Is(err, outbound.ErrHotInventoryInvalid), errors.Is(err, outbound.ErrHotInventoryUnmanaged):
+		code, status = "invalid_request", http.StatusBadRequest
+	}
+	writeHotError(w, status, code, code)
+}
