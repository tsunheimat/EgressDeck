@@ -0,0 +1,424 @@
+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Copyright (c) 2026, daeuniverse Organization <dae@v2raya.org>
+ */
+
+package control
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/daeuniverse/dae/component/outbound"
+)
+
+func TestHotOperationPostcommitDatapathFailureRequiresRestartReadback(t *testing.T) {
+	stateDir := filepath.Join(t.TempDir(), "state")
+	cp := hotTestControlPlane(t, stateDir, "first")
+	// Presence of a real core, without its availability map, simulates failure
+	// at the production post-commit kernel readback boundary.
+	cp.core = &controlPlaneCore{}
+	id := "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee:1"
+	req := hotTestRequest("p", "one", "first", 1, "socks5://127.0.0.1:1")
+	if _, err := cp.PublishHotProviderOperation(context.Background(), id, req); !errors.Is(err, ErrHotInventoryDatapathOutcomeUnknown) {
+		t.Fatalf("postcommit datapath failure: %v", err)
+	}
+	if _, err := cp.HotOperationStatus(id); !errors.Is(err, outbound.ErrHotInventoryClosed) {
+		t.Fatalf("fenced runtime advertised committed operation: %v", err)
+	}
+	if !cp.rejectNewConnections.Load() {
+		t.Fatal("postcommit datapath failure did not fence new flows")
+	}
+	_ = cp.closeHotInventory()
+	restarted := hotTestControlPlane(t, stateDir, "first")
+	receipt, err := restarted.HotOperationStatus(id)
+	if err != nil || receipt.State != "committed" || receipt.Generation != 2 {
+		t.Fatalf("restart failed to recover durable committed receipt: %#v %v", receipt, err)
+	}
+}
+
+func hotTestOperationID(client, sequence int) string {
+	return fmt.Sprintf("%032x:%d", client, sequence)
+}
+
+func hotTestOperationReceipt(t *testing.T, cp *ControlPlane, id, state string, generation uint64) HotOperationReceipt {
+	t.Helper()
+	receipt, err := cp.HotOperationStatus(id)
+	if err != nil || receipt.OperationID != id || receipt.State != state || receipt.Generation != generation {
+		t.Fatalf("operation readback: %#v, %v; want %s at generation %d", receipt, err, state, generation)
+	}
+	if state != "not_started" {
+		digest, err := hex.DecodeString(receipt.RequestDigest)
+		if err != nil || len(digest) != 32 || receipt.Kind == "" {
+			t.Fatalf("operation receipt lacks request identity: %#v", receipt)
+		}
+	}
+	if state == "rejected" && receipt.ErrorCode == "" {
+		t.Fatalf("rejected operation has no bounded error code: %#v", receipt)
+	}
+	if state == "committed" && receipt.ErrorCode != "" {
+		t.Fatalf("committed operation retains an error code: %#v", receipt)
+	}
+	return receipt
+}
+
+func TestHotOperationCrashBeforeSendHasAuthoritativeSafeReplay(t *testing.T) {
+	stateDir := filepath.Join(t.TempDir(), "state")
+	cp := hotTestControlPlane(t, stateDir, "first")
+	id := hotTestOperationID(1, 1)
+	// The agent has persisted its own intent, but the daemon has never received it.
+	hotTestOperationReceipt(t, cp, id, "not_started", 1)
+	if err := cp.closeHotInventory(); err != nil {
+		t.Fatal(err)
+	}
+	cp = hotTestControlPlane(t, stateDir, "first")
+	hotTestOperationReceipt(t, cp, id, "not_started", 1)
+	req := hotTestRequest("p", "one", "first", 1, "socks5://127.0.0.1:1")
+	publication, err := cp.PublishHotProviderOperation(context.Background(), id, req)
+	if err != nil || publication.Snapshot.Generation != 2 {
+		t.Fatalf("safe replay of an unsent operation: %#v %v", publication, err)
+	}
+	receipt := hotTestOperationReceipt(t, cp, id, "committed", 2)
+	if receipt.Kind != "provider_publish" {
+		t.Fatalf("provider receipt kind = %q", receipt.Kind)
+	}
+	if got := hotTestAcquire(t, cp, 2).CandidateID; got != "p-a" {
+		t.Fatalf("replayed provider selection = %q", got)
+	}
+}
+
+func TestHotOperationLostAcknowledgementReplaysAcrossRestartWithoutMutation(t *testing.T) {
+	stateDir := filepath.Join(t.TempDir(), "state")
+	cp := hotTestControlPlane(t, stateDir, "first")
+	providerID := hotTestOperationID(1, 1)
+	req := hotTestRequest("p", "one", "first", 1, "socks5://127.0.0.1:1")
+	if _, err := cp.PublishHotProviderOperation(context.Background(), providerID, req); err != nil {
+		t.Fatal(err)
+	}
+	providerReceipt := hotTestOperationReceipt(t, cp, providerID, "committed", 2)
+	if err := cp.closeHotInventory(); err != nil {
+		t.Fatal(err)
+	}
+	cp = hotTestControlPlane(t, stateDir, "first")
+	if got := hotTestOperationReceipt(t, cp, providerID, "committed", 2); !reflect.DeepEqual(got, providerReceipt) {
+		t.Fatalf("restart changed provider receipt: %#v != %#v", got, providerReceipt)
+	}
+	before, err := os.ReadFile(filepath.Join(stateDir, hotStateFile))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Reuse the original expected generation, not the current generation. The
+	// receipt must resolve this before ordinary publication CAS validation.
+	publication, err := cp.PublishHotProviderOperation(context.Background(), providerID, req)
+	if err != nil || publication.Snapshot.Generation != 2 || len(publication.Adopted) != 0 {
+		t.Fatalf("provider acknowledgement recovery: %#v %v", publication, err)
+	}
+	after, err := os.ReadFile(filepath.Join(stateDir, hotStateFile))
+	if err != nil || !bytes.Equal(before, after) {
+		t.Fatalf("provider replay rewrote durable state: %v", err)
+	}
+	selectionID := hotTestOperationID(1, 2)
+	if _, err := cp.SetHotSelectionOperation(context.Background(), selectionID, 2, 2, "p-b"); err != nil {
+		t.Fatal(err)
+	}
+	selectionReceipt := hotTestOperationReceipt(t, cp, selectionID, "committed", 3)
+	if selectionReceipt.Kind != "selection_set" {
+		t.Fatalf("selection receipt kind = %q", selectionReceipt.Kind)
+	}
+	if err := cp.closeHotInventory(); err != nil {
+		t.Fatal(err)
+	}
+	cp = hotTestControlPlane(t, stateDir, "first")
+	if got := hotTestOperationReceipt(t, cp, selectionID, "committed", 3); !reflect.DeepEqual(got, selectionReceipt) {
+		t.Fatalf("restart changed selection receipt: %#v != %#v", got, selectionReceipt)
+	}
+	before, err = os.ReadFile(filepath.Join(stateDir, hotStateFile))
+	if err != nil {
+		t.Fatal(err)
+	}
+	publication, err = cp.SetHotSelectionOperation(context.Background(), selectionID, 2, 2, "p-b")
+	if err != nil || publication.Snapshot.Generation != 3 || len(publication.Adopted) != 0 {
+		t.Fatalf("selection acknowledgement recovery: %#v %v", publication, err)
+	}
+	after, err = os.ReadFile(filepath.Join(stateDir, hotStateFile))
+	if err != nil || !bytes.Equal(before, after) {
+		t.Fatalf("selection replay rewrote durable state: %v", err)
+	}
+	if got := hotTestAcquire(t, cp, 2).CandidateID; got != "p-b" {
+		t.Fatalf("restored selection = %q", got)
+	}
+}
