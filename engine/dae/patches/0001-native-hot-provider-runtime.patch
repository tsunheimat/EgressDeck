+func TestHotUDPDialFailureRetryAndAdoptionFailureReleaseLeases(t *testing.T) {
+	for _, scenario := range []string{"dial failure", "retry", "unsupported UDP", "manager closed"} {
+		t.Run(scenario, func(t *testing.T) {
+			old := &hotConnectionTransport{}
+			cp, h := hotConnectionPlane(t, hotConnectionEntry(t, "old", old))
+			packet := &scriptedPacketConn{reads: make(chan scriptedPacketRead), closeCh: make(chan struct{})}
+			left, right := net.Pipe()
+			t.Cleanup(func() { _ = left.Close(); _ = right.Close() })
+			next := hotConnectionEntry(t, "new", &hotConnectionTransport{dial: func(context.Context) (netproxy.Conn, error) { return packet, nil }})
+			old.dial = func(context.Context) (netproxy.Conn, error) {
+				hotConnectionPublish(t, h, next)
+				switch scenario {
+				case "retry":
+					return nil, unix.ENETUNREACH
+				case "unsupported UDP":
+					return left, nil
+				case "manager closed":
+					return packet, nil
+				default:
+					return nil, io.EOF
+				}
+			}
+			pool := NewUdpEndpointPool()
+			t.Cleanup(pool.Close)
+			manager := NewSessionManager(context.Background())
+			t.Cleanup(func() { _ = manager.Close() })
+			if scenario == "manager closed" {
+				_ = manager.Close()
+			}
+			endpoint, _, err := pool.GetOrCreate(UdpEndpointKey{Src: hotConnectionParam("udp").Src}, &UdpEndpointOptions{
+				Ctx: context.Background(), NatTimeout: time.Hour, Log: discardLogger(), Handler: func(*UdpEndpoint, []byte, netip.AddrPort) error { return nil }, sessionManager: manager, egressRuntime: cp.egressRuntime,
+				GetDialOption: func(context.Context) (*DialOption, error) {
+					res, err := cp.chooseProxyDialer(hotConnectionParam("udp"))
+					if err != nil {
+						return nil, err
+					}
+					return &DialOption{hotLease: res.hotLease, Dialer: res.Dialer, Outbound: res.Outbound, Target: res.DialTarget, Network: res.Network, NetworkType: res.SelectionNetworkTypeObj}, nil
+				},
+			})
+			if scenario == "retry" {
+				if err != nil {
+					t.Fatal(err)
+				}
+				_ = endpoint.Close()
+			} else if err == nil {
+				t.Fatal("expected endpoint creation failure")
+			}
+			if old.closed.Load() != 1 {
+				t.Fatalf("old inventory lease leaked, closes=%d", old.closed.Load())
+			}
+			if scenario == "manager closed" && packet.closeCalls.Load() != 1 {
+				t.Fatalf("rejected packet conn closes=%d", packet.closeCalls.Load())
+			}
+		})
+	}
+}
